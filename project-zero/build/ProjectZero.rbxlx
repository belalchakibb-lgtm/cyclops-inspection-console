		glow = Color3.fromRGB(60, 255, 200),
		groanPitch = 0.45,
		animSpeed = 1,
		score = 5,
		rare = true,
	},
	Warden = {
		displayName = "The Warden",
		boss = true,
		health = 1400, -- scaled by party size on spawn
		walkSpeed = 8,
		chaseSpeed = 12,
		sight = 120,
		hear = 120,
		attack = { damage = 24, reach = 7, cooldown = 1.8 },
		slam = { damage = 30, radius = 16, cooldown = 9, windup = 1.4 },
		scale = { height = 2.1, width = 2.2, depth = 1.9, head = 1.5 },
		skin = Color3.fromRGB(120, 125, 115),
		shirt = Color3.fromRGB(25, 30, 45), -- old security uniform
		pants = Color3.fromRGB(20, 22, 30),
		eyes = Color3.fromRGB(255, 50, 50),
		glow = Color3.fromRGB(255, 60, 40),
		groanPitch = 0.25,
		animSpeed = 0.75,
		score = 25,
		knockbackResist = 1,
	},
}

return ZombieTypes
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000028"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000012"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	PROJECT: ZERO - server bootstrap.
	Builds the world, then initialises and starts every service in a fixed
	order. Services talk to each other through the shared 'Services' table
	(no circular requires).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local ServerRoot = script.Parent
local ServicesFolder = ServerRoot:WaitForChild("Services")
local World = ServerRoot:WaitForChild("World")

Players.CharacterAutoLoads = false
Net.init()

local Services = {
	Data = require(ServicesFolder:WaitForChild("DataService")),
	Environment = require(ServicesFolder:WaitForChild("EnvironmentService")),
	Interaction = require(ServicesFolder:WaitForChild("InteractionService")),
	Player = require(ServicesFolder:WaitForChild("PlayerService")),
	Combat = require(ServicesFolder:WaitForChild("CombatService")),
	Inventory = require(ServicesFolder:WaitForChild("InventoryService")),
	Zombies = require(ServicesFolder:WaitForChild("ZombieService")),
	Dialogue = require(ServicesFolder:WaitForChild("DialogueService")),
	Cinematic = require(ServicesFolder:WaitForChild("CinematicService")),
	Rewards = require(ServicesFolder:WaitForChild("RewardService")),
	Monetization = require(ServicesFolder:WaitForChild("MonetizationService")),
	Mission = require(ServicesFolder:WaitForChild("MissionService")),
}

-- Snapshot of everything a client needs to render menus and HUD.
function Services.sync(player)
	local profile = Services.Data.get(player)
	if not profile or not player.Parent then
		return
	end
	local pSession = Services.Player.getSession(player)
	local equipment = {}
	if pSession then
		for id in pairs(pSession.equipment) do
			equipment[id] = true
		end
	end
	Net.fire("ProfileSync", player, {
		chapters = profile.chapters,
		highestChapter = profile.highestChapter,
		documents = profile.documents,
		achievements = profile.achievements,
		cosmetics = profile.cosmetics,
		storyFlags = profile.storyFlags,
		stats = profile.stats,
		daily = profile.daily,
		dailyAvailable = profile.daily.lastDay ~= Util.dayNumber(),
		settings = profile.settings,
		equipment = equipment,
		inventory = Services.Inventory.getPersonal(player),
		party = Services.Inventory.getParty(),
		code = Services.Mission.getCode(),
		stage = Services.Mission.getStage(),
		vip = player:GetAttribute("VIP") == true,
		memoryMode = Services.Data.isMemoryMode(),
		catalog = Services.Monetization.catalog(),
		version = Config.Version,
	})
end

local order = { "Data", "Environment", "Interaction", "Player", "Combat", "Inventory", "Zombies", "Dialogue", "Cinematic", "Rewards", "Monetization", "Mission" }

for _, name in ipairs(order) do
	local service = Services[name]
	if service.init then
		service.init(Services)
	end
end

local WorldBuilder = require(World:WaitForChild("WorldBuilder"))
local worldRefs = WorldBuilder.build()

for _, name in ipairs(order) do
	local service = Services[name]
	if service.start then
		local ok, err = pcall(service.start, worldRefs)
		if not ok then
			warn(("[Main] %s failed to start: %s"):format(name, tostring(err)))
		end
	end
end

-- First sync once a profile loads (menu needs it).
Services.Data.onLoaded(function(player)
	Services.sync(player)
	Net.fire("ShowMenu", player)
end)

print("[PROJECT: ZERO] Server ready - " .. Config.Version)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000001F"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">CinematicService</string><ProtectedString name="Source"><![CDATA[--[[
	CinematicService
	Tells clients to play a data-driven cinematic. While a player watches,
	they are flagged InCinematic: zombies ignore them and they take no
	damage. The flag clears when the client reports it finished/skipped,
	or automatically after the cinematic's length (exploit-safe timeout).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cinematics = require(Shared:WaitForChild("Cinematics"))
local Net = require(Shared:WaitForChild("Net"))

local CinematicService = {}

local playing = {} -- [player] = { id, token }

function CinematicService.length(id)
	local c = Cinematics[id]
	local total = 0
	if c then
		for _, shot in ipairs(c.shots) do
			total = total + (shot.duration or 0)
		end
	end
	return total
end

function CinematicService.play(players, id)
	if not Cinematics[id] then
		warn("[Cinematic] Unknown cinematic " .. tostring(id))
		return
	end
	local length = CinematicService.length(id)
	for _, player in ipairs(players) do
		local token = {}
		playing[player] = { id = id, token = token }
		player:SetAttribute("InCinematic", true)
		Net.fire("PlayCinematic", player, id)
		task.delay(length + 3, function()
			local current = playing[player]
			if current and current.token == token then
				playing[player] = nil
				if player.Parent then
					player:SetAttribute("InCinematic", false)
				end
			end
		end)
	end
end

function CinematicService.playAll(id)
	CinematicService.play(Players:GetPlayers(), id)
end

function CinematicService.init() end

function CinematicService.start()
	Net.on("CinematicDone", function(player, id)
		local current = playing[player]
		if current and current.id == id then
			playing[player] = nil
			player:SetAttribute("InCinematic", false)
		end
	end, 4)
	Players.PlayerRemoving:Connect(function(player)
		playing[player] = nil
	end)
end

return CinematicService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--[[
	CombatService
	Melee weapons as Tools. Tool.Activated fires on the server, so hit
	detection, cooldowns and damage are fully server-authoritative - the
	client only plays the swing animation (via the standard "toolanim" value).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local CombatService = {}
local Services

local lastSwing = {} -- [player] = os.clock()

local function playSound(parent, id, speed, volume)
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.PlaybackSpeed = speed or 1
	s.Volume = volume or 0.7
	s.RollOffMaxDistance = 70
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 3)
end

local function buildTool(id)
	local def = Config.Weapons[id]
	local tool = Instance.new("Tool")
	tool.Name = def.name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = def.name
	tool:SetAttribute("WeaponId", id)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.35, 0.35, 4.2)
	handle.Material = id == "axe" and Enum.Material.Wood or Enum.Material.Metal
	handle.Color = id == "axe" and Color3.fromRGB(110, 75, 40) or def.color
	handle.CanCollide = false
	handle.Massless = true
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.Parent = tool

	if id == "axe" then
		local head = Instance.new("Part")
		head.Name = "AxeHead"
		head.Size = Vector3.new(0.3, 1.5, 1.1)
		head.Material = Enum.Material.Metal
		head.Color = def.color
		head.CanCollide = false
		head.Massless = true
		head.CFrame = handle.CFrame * CFrame.new(0, 0.6, -1.8)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = head
		weld.Parent = head
		head.Parent = tool
	end

	-- Hold like a classic sword: the long axis points up out of the fist.
	tool.GripPos = Vector3.new(0, 0, -1.5)
	tool.GripForward = Vector3.new(-1, 0, 0)
	tool.GripRight = Vector3.new(0, 1, 0)
	tool.GripUp = Vector3.new(0, 0, 1)
	return tool
end

local function swing(player, tool, id)
	local def = Config.Weapons[id]
	local now = os.clock()
	if lastSwing[player] and now - lastSwing[player] < def.cooldown then
		return
	end
	lastSwing[player] = now

	local character, humanoid, root = Services.Player.getParts(player)
	if not character or humanoid.Health <= 0 or character:GetAttribute("Downed") or tool.Parent ~= character then
		return
	end

	-- Tell the default Animate script to play the slash animation.
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 1)
	playSound(tool.Handle, Config.Sounds.Swing, id == "axe" and 0.8 or 1, 0.6)

	task.wait(0.15)
	if not root.Parent then
		return
	end
	local boxCF = root.CFrame * CFrame.new(0, 0, -(def.reach / 2 + 0.5))
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace:FindFirstChild("Zombies") or workspace }
	local parts = workspace:GetPartBoundsInBox(boxCF, Vector3.new(def.width, 7, def.reach + 1), params)

	local hit = {}
	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		while model and not CollectionService:HasTag(model, "Zombie") do
			model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model") or nil
		end
		if model and not hit[model] then
			hit[model] = true
			local dir = (model:GetPivot().Position - root.Position)
			dir = Vector3.new(dir.X, 0, dir.Z)
			if dir.Magnitude > 0.01 then
				dir = dir.Unit
			end
			Services.Zombies.damage(model, def.damage, player, dir * def.knockback)
		end
	end
	if next(hit) then
		playSound(tool.Handle, Config.Sounds.Hit, 0.7, 0.8)
	end
end

function CombatService.giveWeapon(player, id)
	if not Config.Weapons[id] then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local name = Config.Weapons[id].name
	if backpack:FindFirstChild(name) or (player.Character and player.Character:FindFirstChild(name)) then
		return
	end
	local tool = buildTool(id)
	tool.Activated:Connect(function()
		swing(player, tool, id)
	end)
	tool.Parent = backpack
end

function CombatService.init(services)
	Services = services
end

function CombatService.start()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
	end)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService
	Persistent player profiles using DataStoreService.
	- UpdateAsync everywhere (no blind overwrites)
	- Session locking so two servers never overwrite each other
	- Retries with exponential backoff
	- Autosave + save on leave + BindToClose
	- Falls back to an in-memory profile when DataStores are unavailable
	  (e.g. Studio without "Enable Studio Access to API Services") and tells
	  the player their progress will not be saved.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local DataService = {}

local TEMPLATE = {
	schema = 1,
	chapters = {
		ch1 = { completed = false, checkpointStage = 1, bestTime = 0, completions = 0 },
	},
	highestChapter = 1,
	documents = {},
	achievements = {},
	cosmetics = {
		owned = { light_default = true, gear_none = true, title_none = true, emote_wave = true, emote_point = true },
		equipped = { light = Cosmetics.Defaults.light, gear = Cosmetics.Defaults.gear, title = Cosmetics.Defaults.title },
	},
	storyFlags = {},
	stats = { zombiesDefeated = 0, deaths = 0, revives = 0, playTime = 0 },
	daily = { lastDay = 0, streak = 0 },
	settings = { graphics = "Auto", music = 0.6, sfx = 0.8, subtitles = true, cameraShake = true, tutorials = true },
	hintsSeen = {},
	endings = {},
	purchases = {},
}

local store = nil
local useMemory = false
local profiles = {} -- [player] = data
local loadedCallbacks = {}
local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. tostring(math.random(1, 1e9)))

local function withRetries(fn)
	local delay = 1
	local lastErr
	for attempt = 1, Config.Data.MaxRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		if attempt < Config.Data.MaxRetries then
			task.wait(delay)
			delay = delay * 2
		end
	end
	return false, lastErr
end

local function keyFor(player)
	return "u_" .. player.UserId
end

function DataService.init(services)
	DataService.Services = services
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.ProfileStore)
	end)
	if ok then
		store = result
	else
		useMemory = true
		warn("[DataService] DataStores unavailable - using in-memory profiles. (" .. tostring(result) .. ")")
	end
end

function DataService.isMemoryMode()
	return useMemory
end

function DataService.onLoaded(callback)
	table.insert(loadedCallbacks, callback)
	for player, data in pairs(profiles) do
		task.spawn(callback, player, data)
	end
end

function DataService.get(player)
	return profiles[player]
end

-- Waits (bounded) for a player's profile.
function DataService.waitFor(player, timeout)
	local deadline = os.clock() + (timeout or 20)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

local function loadProfile(player)
	if useMemory then
		return Util.deepCopy(TEMPLATE), true
	end
	local key = keyFor(player)
	local loaded
	for attempt = 1, 5 do
		local lockedByOther = false
		local ok, err = withRetries(function()
			store:UpdateAsync(key, function(old)
				local data = old or Util.deepCopy(TEMPLATE)
				local lock = data.lock
				if lock and lock.job ~= jobId and os.time() - (lock.time or 0) < Config.Data.SessionLockTimeout and attempt < 5 then
					lockedByOther = true
					return nil -- do not write; another server still owns this profile
				end
				data.lock = { job = jobId, time = os.time() }
				loaded = data
				return data
			end)
		end)
		if not ok then
			warn("[DataService] Load failed for " .. player.Name .. ": " .. tostring(err))
			return nil, false
		end
		if not lockedByOther and loaded then
			return loaded, true
		end
		task.wait(3) -- previous server is probably still saving
	end
	return loaded, loaded ~= nil
end

function DataService.save(player, release)
	local data = profiles[player]
	if not data or useMemory then
		return true
	end
	local key = keyFor(player)
	local ok, err = withRetries(function()
		store:UpdateAsync(key, function(old)
			if old and old.lock and old.lock.job ~= jobId then
				-- Another server took over the session; never clobber it.
				return nil
			end
			data.lock = (not release) and { job = jobId, time = os.time() } or nil
			return data
		end)
	end)
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

local function onPlayerAdded(player)
	local data, ok = loadProfile(player)
	if not player.Parent then
		return
	end
	if (not ok or not data) and RunService:IsStudio() then
		-- Studio without API access: keep testing with a temporary profile.
		warn("[DataService] Studio has no DataStore access - progress will not be saved this session.")
		useMemory = true
		data, ok = Util.deepCopy(TEMPLATE), true
	end
	if not ok or not data then
		-- Do not risk overwriting good data with a fresh template.
		player:Kick("PROJECT: ZERO could not load your save data. Please rejoin in a moment.")
		return
	end
	Util.reconcile(data, TEMPLATE)
	profiles[player] = data
	player:SetAttribute("ProfileLoaded", true)
	for _, cb in ipairs(loadedCallbacks) do
		task.spawn(cb, player, data)
	end
end

function DataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end

	Players.PlayerRemoving:Connect(function(player)
		if profiles[player] then
			DataService.save(player, true)
			profiles[player] = nil
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for player in pairs(profiles) do
				if player.Parent then
					task.spawn(DataService.save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if useMemory then
			return
		end
		local pending = 0
		for player in pairs(profiles) do
			pending = pending + 1
			task.spawn(function()
				DataService.save(player, true)
				pending = pending - 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">DialogueService</string><ProtectedString name="Source"><![CDATA[--[[
	DialogueService
	Server-driven branching dialogue. The server owns the conversation state,
	so a client can only pick choices that exist on its current node.
	Choices update persistent story flags (trust, secrets) used by later
	chapters and the endings.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Dialogues = require(Shared:WaitForChild("Dialogues"))
local Net = require(Shared:WaitForChild("Net"))

local DialogueService = {}
local Services

local active = {} -- [player] = { id, node }
local eventHandlers = {}

function DialogueService.onEvent(callback)
	table.insert(eventHandlers, callback)
end

local function sendNode(player, dialogueId, nodeId)
	local dialogue = Dialogues[dialogueId]
	local node = dialogue and dialogue.nodes[nodeId]
	if not node then
		active[player] = nil
		Net.fire("DialogueClose", player)
		return
	end
	active[player] = { id = dialogueId, node = nodeId }
	local choices = {}
	if node.choices then
		for i, c in ipairs(node.choices) do
			choices[i] = c.text
		end
	end
	Net.fire("DialogueShow", player, {
		speaker = node.speaker,
		text = node.text,
		choices = choices,
		final = node.choices == nil and node.next == nil,
	})
	if node.event then
		for _, cb in ipairs(eventHandlers) do
			task.spawn(cb, player, node.event, dialogueId)
		end
	end
end

function DialogueService.begin(player, dialogueId)
	local dialogue = Dialogues[dialogueId]
	if not dialogue then
		return
	end
	sendNode(player, dialogueId, dialogue.start)
end

function DialogueService.isTalking(player)
	return active[player] ~= nil
end

local function applyChoice(player, choice)
	local profile = Services.Data.get(player)
	if not profile then
		return
	end
	if choice.trust then
		profile.storyFlags.mayaTrust = (profile.storyFlags.mayaTrust or 0) + choice.trust
	end
	if choice.flag then
		profile.storyFlags[choice.flag] = true
	end
end

local function onChoice(player, index)
	local state = active[player]
	if not state or type(index) ~= "number" then
		return
	end
	local node = Dialogues[state.id].nodes[state.node]
	if node.choices then
		local choice = node.choices[math.floor(index)]
		if not choice then
			return
		end
		applyChoice(player, choice)
		sendNode(player, state.id, choice.next)
	elseif node.next then
		sendNode(player, state.id, node.next)
	else
		active[player] = nil
		Net.fire("DialogueClose", player)
	end
end

function DialogueService.init(services)
	Services = services
end

function DialogueService.start()
	Net.on("DialogueChoice", onChoice, 6)
	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
	end)
end

return DialogueService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">EnvironmentService</string><ProtectedString name="Source"><![CDATA[--[[
	EnvironmentService
	Cinematic lighting: dusk sky, dense atmospheric haze, desaturated colour
	grading, bloom and sun rays. Clients scale these down locally on Low
	graphics (see SettingsController), so the server sets the High look.
]]

local Lighting = game:GetService("Lighting")

local EnvironmentService = {}

local function ensure(className, name)
	local obj = Lighting:FindFirstChild(name)
	if not obj then
		obj = Instance.new(className)
		obj.Name = name
		obj.Parent = Lighting
	end
	return obj
end

function EnvironmentService.init() end

function EnvironmentService.start()
	Lighting.ClockTime = 18.9
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 1.4
	Lighting.Ambient = Color3.fromRGB(38, 42, 48)
	Lighting.OutdoorAmbient = Color3.fromRGB(70, 74, 86)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.ExposureCompensation = -0.1
	Lighting.FogEnd = 100000 -- Atmosphere handles fog

	local atmosphere = ensure("Atmosphere", "PZ_Atmosphere")
	atmosphere.Density = 0.42
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(150, 155, 165)
	atmosphere.Decay = Color3.fromRGB(75, 70, 80)
	atmosphere.Glare = 0.25
	atmosphere.Haze = 2.2

	local cc = ensure("ColorCorrectionEffect", "PZ_Grade")
	cc.Saturation = -0.28
	cc.Contrast = 0.14
	cc.Brightness = 0.02
	cc.TintColor = Color3.fromRGB(228, 236, 240)

	local bloom = ensure("BloomEffect", "PZ_Bloom")
	bloom.Intensity = 0.55
	bloom.Size = 26
	bloom.Threshold = 1.5

	local rays = ensure("SunRaysEffect", "PZ_SunRays")
	rays.Intensity = 0.05
	rays.Spread = 0.6

	local dof = ensure("DepthOfFieldEffect", "PZ_DOF")
	dof.Enabled = false -- enabled by clients on High graphics / during cinematics
	dof.FarIntensity = 0.25
	dof.FocusDistance = 25
	dof.InFocusRadius = 30
	dof.NearIntensity = 0

	-- Overcast sky made from built-in Roblox sky textures.
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end
	sky.Name = "PZ_Sky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 1500
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
end

return EnvironmentService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">InteractionService</string><ProtectedString name="Source"><![CDATA[--[[
	InteractionService
	Thin wrapper around ProximityPrompt (works with keyboard, gamepad and
	touch out of the box). Every trigger is re-validated on the server:
	distance, alive, not downed, not in a cinematic, and a per-player debounce.
]]

local Players = game:GetService("Players")

local InteractionService = {}

local debounce = {}

local function validPlayer(player, part, maxDistance)
	local character = player.Character
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return false
	end
	if character:GetAttribute("Downed") or player:GetAttribute("InCinematic") then
		return false
	end
	if (root.Position - part.Position).Magnitude > maxDistance + 8 then
		return false
	end
	return true
end

--[[
	opts: action, object, hold (seconds), distance, id (attribute), kind, lineOfSight
	handler(player, prompt) -> nothing
]]
function InteractionService.add(part, opts, handler)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = opts.action or "Interact"
	prompt.ObjectText = opts.object or ""
	prompt.HoldDuration = opts.hold or 0
	prompt.MaxActivationDistance = opts.distance or 9
	prompt.RequiresLineOfSight = opts.lineOfSight == true
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	if opts.id then
		prompt:SetAttribute("PickupId", opts.id)
	end
	if opts.kind then
		prompt:SetAttribute("PickupKind", opts.kind)
	end
	prompt.Parent = part

	prompt.Triggered:Connect(function(player)
		local now = os.clock()
		local key = player.UserId
		if debounce[key] and now - debounce[key] < 0.35 then
			return
		end
		debounce[key] = now
		if not validPlayer(player, part, prompt.MaxActivationDistance) then
			return
		end
		local ok, err = pcall(handler, player, prompt)
		if not ok then
			warn("[Interaction] handler error: " .. tostring(err))
		end
	end)
	return prompt
end

function InteractionService.init() end

function InteractionService.start()
	Players.PlayerRemoving:Connect(function(player)
		debounce[player.UserId] = nil
	end)
end

return InteractionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--[[
	InventoryService
	- Personal consumables (bandages, medkits) per player, per chapter run
	- Shared party key items (keycards, fuses) so any co-op member can use them
	All mutations happen here on the server; clients only receive snapshots.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared:WaitForChild("Items"))
local Net = require(Shared:WaitForChild("Net"))

local InventoryService = {}
local Services

local personal = {} -- [player] = { itemId = count }
local party = {} -- { itemId = count }

function InventoryService.getPersonal(player)
	return personal[player] or {}
end

function InventoryService.getParty()
	return party
end

function InventoryService.add(player, itemId, count)
	local def = Items[itemId]
	local inv = personal[player]
	if not def or not inv then
		return false
	end
	local current = inv[itemId] or 0
	local maxStack = def.maxStack or 99
	if current >= maxStack then
		Net.fire("Notify", player, def.name .. ": you can't carry more.", "info")
		return false
	end
	inv[itemId] = math.min(maxStack, current + (count or 1))
	Services.sync(player)
	return true
end

function InventoryService.addParty(itemId)
	party[itemId] = (party[itemId] or 0) + 1
	Net.fireAll("PartyInventory", party)
end

function InventoryService.hasParty(itemId)
	return (party[itemId] or 0) > 0
end

function InventoryService.consumeParty(itemId)
	if (party[itemId] or 0) <= 0 then
		return false
	end
	party[itemId] = party[itemId] - 1
	if party[itemId] <= 0 then
		party[itemId] = nil
	end
	Net.fireAll("PartyInventory", party)
	return true
end

function InventoryService.resetSession()
	party = {}
	for player in pairs(personal) do
		personal[player] = {}
	end
	Net.fireAll("PartyInventory", party)
end

function InventoryService.resetPlayer(player)
	personal[player] = {}
end

local function useItem(player, itemId)
	if type(itemId) ~= "string" then
		return
	end
	local def = Items[itemId]
	local inv = personal[player]
	if not def or not inv or def.kind ~= "consumable" or (inv[itemId] or 0) <= 0 then
		return
	end
	local character, humanoid = Services.Player.getParts(player)
	if not character or humanoid.Health <= 0 or character:GetAttribute("Downed") then
		return
	end
	if humanoid.Health >= humanoid.MaxHealth then
		Net.fire("Notify", player, "You're already at full health.", "info")
		return
	end
	if def.heal and Services.Player.heal(player, def.heal) then
		inv[itemId] = inv[itemId] - 1
		Net.fire("Notify", player, "Used " .. def.name .. " (+" .. def.heal .. " health)", "good")
		Services.sync(player)
	end
end

function InventoryService.init(services)
	Services = services
end

function InventoryService.start()
	local function added(player)
		personal[player] = {}
	end
	Players.PlayerAdded:Connect(added)
	for _, p in ipairs(Players:GetPlayers()) do
		added(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		personal[player] = nil
	end)
	Net.on("UseItem", useItem, 4)
end

return InventoryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">MissionService</string><ProtectedString name="Source"><![CDATA[--[[
	MissionService - Chapter 1 "The Outbreak" story controller.

	The whole server shares one story session (co-op party of up to 4).
	- Stages advance on shared story events and are broadcast to everyone.
	- Each stage is a checkpoint saved to every participant's profile.
	- Joining mid-session, dying or resuming from a save restores the
	  world to the current stage (doors, key items, equipment), so one
	  player's actions can never soft-lock another player.
	- Personal collectibles (documents, equipment) are per player;
	  key items (keycard, fuse) are shared by the party.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared:WaitForChild("Layout"))
local Chapters = require(Shared:WaitForChild("Chapters"))
local Documents = require(Shared:WaitForChild("Documents"))
local Items = require(Shared:WaitForChild("Items"))
local Cinematics = require(Shared:WaitForChild("Cinematics"))
local Net = require(Shared:WaitForChild("Net"))

local World = script.Parent.Parent:WaitForChild("World")
local Doors = require(World:WaitForChild("Doors"))
local Pickups = require(World:WaitForChild("Pickups"))

local MissionService = {}
local Services
local refs

local P = Layout.Points
local STAGES = Chapters.Chapter1
local IDX = Chapters.Chapter1Index

local session = {
	running = false,
	stage = 0,
	startedAt = 0,
	code = "0000",
	breakers = { false, false, false },
	keypadFails = 0,
	participants = {}, -- [player] = { kills = 0 }
	completing = false,
}

local pickupFolder
local maya

-- Utility ------------------------------------------------------------------------------------
local function participants()
	local list = {}
	for player in pairs(session.participants) do
		if player.Parent then
			table.insert(list, player)
		end
	end
	return list
end

local function notifyAll(text, kind)
	for _, p in ipairs(participants()) do
		Net.fire("Notify", p, text, kind)
	end
end

local function sendObjective(player)
	local stage = STAGES[session.stage]
	if stage then
		Net.fire("Objective", player, stage.text, stage.target, session.stage)
	end
end

local function sendHint(player, hintId)
	local profile = Services.Data.get(player)
	if not hintId or not profile or profile.hintsSeen[hintId] or not profile.settings.tutorials then
		return
	end
	profile.hintsSeen[hintId] = true
	Net.fire("Hint", player, hintId)
end

local function checkpointPosition()
	local stage = STAGES[session.stage] or STAGES[1]
	local cp = Layout.Checkpoints[stage.checkpoint] or Layout.Checkpoints[1]
	return cp.position
end

local function grantStageEquipment(player)
	local stage = STAGES[session.stage]
	if not stage then
		return
	end
	for _, id in ipairs(stage.grants) do
		Services.Player.grantEquipment(player, id, true)
	end
end

function MissionService.getCode()
	return session.running and session.code or nil
end

function MissionService.getStage()
	return session.running and session.stage or 0
end

-- Maya NPC ----------------------------------------------------------------------------------------
local function buildMaya()
	local model
	local ok = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		local skin = Color3.fromRGB(198, 140, 105)
		desc.HeadColor = skin
		desc.LeftArmColor = skin
		desc.RightArmColor = skin
		desc.TorsoColor = Color3.fromRGB(35, 50, 85) -- paramedic jacket
		desc.LeftLegColor = Color3.fromRGB(40, 40, 45)
		desc.RightLegColor = Color3.fromRGB(40, 40, 45)
		model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		model = Instance.new("Model")
		local root = Instance.new("Part")
		root.Name = "HumanoidRootPart"
		root.Size = Vector3.new(2, 5, 1)
		root.Color = Color3.fromRGB(35, 50, 85)
		root.Parent = model
		local head = Instance.new("Part")
		head.Name = "Head"
		head.Size = Vector3.new(1.2, 1.2, 1.2)
		head.Color = Color3.fromRGB(198, 140, 105)
		head.CFrame = root.CFrame * CFrame.new(0, 3.1, 0)
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = head
		w.Parent = head
		head.Parent = model
		Instance.new("Humanoid").Parent = model
		model.PrimaryPart = root
	end
	model.Name = "Maya"
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = "Maya"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.NameDisplayDistance = 40
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	local root = model:FindFirstChild("HumanoidRootPart")
	root.Anchored = true
	-- red headband + bat (her weapon)
	local head = model:FindFirstChild("Head")
	if head then
		local band = Instance.new("Part")
		band.Name = "Headband"
		band.Size = Vector3.new(head.Size.X * 1.05, 0.25, head.Size.Z * 1.05)
		band.Color = Color3.fromRGB(190, 30, 30)
		band.CanCollide = false
		band.Massless = true
		band.CFrame = head.CFrame * CFrame.new(0, 0.25, 0)
		local w = Instance.new("WeldConstraint")
		w.Part0 = head
		w.Part1 = band
		w.Parent = band
		band.Parent = model
	end
	local hand = model:FindFirstChild("RightHand") or root
	local bat = Instance.new("Part")
	bat.Name = "Bat"
	bat.Size = Vector3.new(0.35, 3.6, 0.35)
	bat.Material = Enum.Material.Wood
	bat.Color = Color3.fromRGB(150, 110, 70)
	bat.CanCollide = false
	bat.Massless = true
	bat.CFrame = hand.CFrame * CFrame.new(0, -1.4, 0)
	local bw = Instance.new("WeldConstraint")
	bw.Part0 = hand
	bw.Part1 = bat
	bw.Parent = bat
	bat.Parent = model

	model.Parent = workspace:FindFirstChild("Interactables") or workspace
	local prompt = Services.Interaction.add(root, { action = "Talk", object = "Maya", distance = 10 }, function(player)
		MissionService.talkToMaya(player)
	end)
	prompt.Name = "TalkPrompt"
	return model
end

local function placeMaya(position, faceTowards)
	if not maya then
		return
	end
	local h = 3
	local hum = maya:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		h = hum.HipHeight + (maya:FindFirstChild("HumanoidRootPart").Size.Y / 2)
	end
	local pos = position + Vector3.new(0, h + 0.2, 0)
	maya:PivotTo(CFrame.lookAt(pos, Vector3.new(faceTowards.X, pos.Y, faceTowards.Z)))
end

-- Pickups ----------------------------------------------------------------------------------------------
local PICKUPS = {
	{ id = "flashlight", style = "flashlight", pos = P.Flashlight, kind = "equip" },
	{ id = "pipe", style = "pipe", pos = P.Pipe, kind = "equip" },
	{ id = "axe", style = "axe", pos = P.FireAxe, kind = "equip" },
	{ id = "patient_log", style = "document", pos = P.PatientLog, kind = "doc" },
	{ id = "shift_note", style = "document", pos = P.ShiftNote, kind = "doc" },
	{ id = "maintenance_memo", style = "document", pos = P.MaintenanceMemo, kind = "doc" },
	{ id = "evac_order", style = "document", pos = P.EvacOrder, kind = "doc" },
	{ id = "rf_01", style = "research", pos = P.ResearchFile1, kind = "doc" },
	{ id = "rf_02", style = "research", pos = P.ResearchFile2, kind = "doc" },
	{ id = "rf_03", style = "research", pos = P.ResearchFile3, kind = "doc" },
	{ id = "rf_04", style = "research", pos = P.ResearchFile4, kind = "doc" },
	{ id = "rf_05", style = "research", pos = P.ResearchFile5, kind = "doc" },
	{ id = "keycard_hospital", style = "keycard", pos = P.Keycard, kind = "party", removeFrom = 5 },
	{ id = "fuse", style = "fuse", pos = P.Fuse, kind = "party", removeFrom = 8 },
	{ id = "bandage_a", item = "bandage", style = "bandage", pos = P.Bandage1, kind = "consumable" },
	{ id = "bandage_b", item = "bandage", style = "bandage", pos = P.Bandage2, kind = "consumable" },
	{ id = "medkit_a", item = "medkit", style = "medkit", pos = P.Medkit1, kind = "consumable" },
}

local onStoryEvent -- forward declaration

local function readDocument(player, docId)
	local doc = Documents[docId]
	if not doc then
		return
	end
	local text = doc.text:gsub("{CODE}", session.code)
	Net.fire("ReadDocument", player, docId, doc.title, text)
end

local function createPickup(def)
	local model, main = Pickups.create(def.style, def.pos, pickupFolder, true)
	local objectName
	if def.kind == "doc" then
		objectName = Documents[def.id].title
	else
		local item = Items[def.item or def.id]
		objectName = item and item.name or def.id
	end
	local action = def.kind == "doc" and "Read" or "Take"
	Services.Interaction.add(main, { action = action, object = objectName, distance = 9, id = def.id, kind = def.kind }, function(player)
		if def.kind == "equip" then
			if Services.Player.grantEquipment(player, def.id) then
				Net.fire("Notify", player, "Picked up: " .. objectName, "good")
				onStoryEvent("got_" .. def.id, player)
			else
				Net.fire("Notify", player, "You already have the " .. objectName .. ".", "info")
			end
		elseif def.kind == "doc" then
			local isNew = Services.Rewards.collectDocument(player, def.id)
			readDocument(player, def.id)
			if isNew and Documents[def.id].kind == "research" then
				Net.fire("Notify", player, "Research file collected!", "reward")
			end
			onStoryEvent("doc_" .. def.id, player)
		elseif def.kind == "party" then
			Services.Inventory.addParty(def.id)
			model:Destroy()
			notifyAll(player.DisplayName .. " found the " .. objectName .. ".", "good")
			onStoryEvent("got_" .. def.id, player)
		elseif def.kind == "consumable" then
			if Services.Inventory.add(player, def.item, 1) then
				Net.fire("Notify", player, "Picked up: " .. objectName, "good")
				model:Destroy()
			end
		end
	end)
	return model
end

local function setupPickups(stageIndex)
	pickupFolder:ClearAllChildren()
	for _, def in ipairs(PICKUPS) do
		if not def.removeFrom or stageIndex < def.removeFrom then
			createPickup(def)
		end
	end
end

local dropCounter = 0
local function dropConsumable(itemId, position)
	dropCounter = dropCounter + 1
	local style = itemId == "medkit" and "medkit" or "bandage"
	local ground = position - Vector3.new(0, 2.6, 0)
	createPickup({ id = "drop_" .. dropCounter, item = itemId, style = style, pos = Vector3.new(ground.X, math.max(0.4, ground.Y), ground.Z), kind = "consumable" })
end

-- World state ----------------------------------------------------------------------------------------------
local function setLight(part, on)
	if part then
		part.Color = on and Color3.fromRGB(60, 255, 120) or Color3.fromRGB(255, 40, 40)
	end
end

local function setBreakerVisual(i, on)
	local lever = refs.city.breakerLevers[i]
	if lever then
		lever.Color = on and Color3.fromRGB(60, 220, 90) or Color3.fromRGB(200, 40, 40)
		local base = CFrame.new(P.BreakerPanel + Vector3.new(0.45, -0.6, (i - 2) * 1.8))
		lever.CFrame = on and (base * CFrame.new(0, 1.2, 0)) or base
	end
end

local function applyWorldState(stageIndex)
	for _, door in pairs(Doors.all()) do
		door:close()
	end
	if stageIndex >= 5 then
		Doors.get("security"):open(true)
	end
	if stageIndex >= 6 then
		Doors.get("lobby"):open(true)
	end
	if stageIndex >= 8 then
		Doors.get("armory"):open(true)
	end
	if stageIndex >= 10 then
		Doors.get("subway_gate"):open(true)
	end
	refs.hospital.chains.Transparency = stageIndex >= 6 and 1 or 0
	setLight(refs.hospital.keypad.Parent:FindFirstChild("KeypadLight"), stageIndex >= 5)
	setLight(refs.hospital.reader.Parent:FindFirstChild("ReaderLight"), stageIndex >= 6)
	setLight(refs.city.generatorLight, stageIndex >= 9)
	session.breakers = { false, false, false }
	for i = 1, 3 do
		setBreakerVisual(i, stageIndex >= 8 and i ~= 2)
	end
	local secretPrompt = refs.secretPrompt
	if secretPrompt then
		secretPrompt.Enabled = true
	end
	if stageIndex == 5 then
		Services.Inventory.addParty("keycard_hospital")
	elseif stageIndex == 8 then
		Services.Inventory.addParty("fuse")
	end
	if stageIndex >= 10 then
		placeMaya(P.MayaSubway, P.BossSpawn)
	else
		placeMaya(P.MayaSpot, P.Pharmacy)
	end
end

-- Stage flow ------------------------------------------------------------------------------------------------
local function spawnBoss()
	if Services.Zombies.countBosses() == 0 and session.stage == IDX.boss then
		Services.Zombies.spawn("Warden", P.BossSpawn, { aggro = true })
	end
end

local function advance(stageIndex)
	if not session.running or stageIndex <= session.stage then
		return
	end
	session.stage = stageIndex
	Services.Zombies.setStage(stageIndex)
	local stage = STAGES[stageIndex]
	for _, player in ipairs(participants()) do
		local profile = Services.Data.get(player)
		if profile then
			profile.chapters.ch1.checkpointStage = stageIndex
		end
		grantStageEquipment(player)
		sendObjective(player)
		sendHint(player, stage.hint)
		Services.sync(player)
	end
	notifyAll("Checkpoint reached", "checkpoint")
end

local function completeChapter()
	if session.completing then
		return
	end
	session.completing = true
	local elapsed = os.clock() - session.startedAt
	Services.Cinematic.play(participants(), "escape")
	for _, player in ipairs(participants()) do
		local profile = Services.Data.get(player)
		local pSession = Services.Player.getSession(player)
		if profile then
			local ch = profile.chapters.ch1
			ch.completed = true
			ch.completions = (ch.completions or 0) + 1
			ch.checkpointStage = 1
			if ch.bestTime == 0 or elapsed < ch.bestTime then
				ch.bestTime = math.floor(elapsed)
			end
			profile.highestChapter = math.max(profile.highestChapter, 2)
			profile.storyFlags.ch1Complete = true
			Services.Rewards.unlock(player, "chapter1")
			if pSession and not pSession.wentDown then
				Services.Rewards.unlock(player, "untouchable1")
			end
			if elapsed < 15 * 60 then
				Services.Rewards.unlock(player, "speedrunner1")
			end
			task.spawn(Services.Data.save, player, false)
		end
	end
	local length = Services.Cinematic.length("escape")
	task.delay(length + 0.5, function()
		for _, player in ipairs(participants()) do
			local profile = Services.Data.get(player)
			local found = 0
			if profile then
				for _, id in ipairs(Documents.ResearchChapter1) do
					if profile.documents[id] then
						found = found + 1
					end
				end
			end
			local data = session.participants[player]
			Net.fire("ChapterComplete", player, {
				chapter = 1,
				title = "The Outbreak",
				time = math.floor(elapsed),
				kills = data and data.kills or 0,
				files = found,
				filesTotal = #Documents.ResearchChapter1,
				trust = profile and profile.storyFlags.mayaTrust or 0,
			})
		end
		MissionService.endSession()
	end)
end

-- Story events ---------------------------------------------------------------------------------------------
onStoryEvent = function(event, player)
	local stage = session.stage
	if event == "got_flashlight" and stage == IDX.find_light then
		advance(IDX.find_weapon)
	elseif event == "got_pipe" and stage == IDX.find_weapon then
		advance(IDX.find_code)
		-- the first infected hears the noise from the corridor
		task.delay(1.5, function()
			Services.Zombies.spawn("Normal", Vector3.new(104, 0, 30), { aggro = true })
		end)
	elseif event == "doc_shift_note" and stage == IDX.find_code then
		advance(IDX.security)
	elseif event == "got_keycard_hospital" and stage == IDX.security then
		advance(IDX.lobby)
	elseif event == "got_fuse" and stage == IDX.fuse then
		advance(IDX.generator)
	elseif event == "got_axe" then
		Services.Rewards.unlock(player, "heavy_hitter")
	elseif event == "doc_cctv_log" then
		Net.fire("Shake", player, 0.2, 0.4)
	end
end

function MissionService.talkToMaya(player)
	if Services.Dialogue.isTalking(player) then
		return
	end
	Services.Rewards.unlock(player, "first_contact")
	if session.stage == IDX.survivor then
		Services.Cinematic.play({ player }, "meet_maya")
		task.delay(Services.Cinematic.length("meet_maya"), function()
			if player.Parent then
				Services.Dialogue.begin(player, "maya_intro")
			end
		end)
	elseif session.stage >= IDX.escape then
		Services.Dialogue.begin(player, "maya_gate")
	elseif session.stage > IDX.survivor then
		Services.Dialogue.begin(player, "maya_repeat")
	else
		Net.fire("Notify", player, "Maya is hiding. She doesn't trust you yet.", "info")
	end
end

-- Puzzles / interactables ---------------------------------------------------------------------------------------
local function setupInteractables()
	-- Security keypad
	Services.Interaction.add(refs.hospital.keypad, { action = "Enter Code", object = "Security Keypad", distance = 8 }, function(player)
		if Doors.get("security").isOpen then
			return
		end
		Net.fire("KeypadOpen", player, "security")
	end)

	Net.on("KeypadSubmit", function(player, doorId, code)
		if doorId ~= "security" or type(code) ~= "string" or #code ~= 4 or not session.running then
			return
		end
		local _, _, root = Services.Player.getParts(player)
		if not root or (root.Position - refs.hospital.keypad.Position).Magnitude > 16 then
			return
		end
		if Doors.get("security").isOpen then
			Net.fire("KeypadResult", player, true)
			return
		end
		if code == session.code then
			Doors.get("security"):open()
			setLight(refs.hospital.keypad.Parent:FindFirstChild("KeypadLight"), true)
			Net.fire("KeypadResult", player, true)
			Services.Rewards.unlock(player, "code_breaker")
			notifyAll("The security office is open.", "good")
			if session.stage < IDX.security then
				advance(IDX.security)
			end
		else
			session.keypadFails = session.keypadFails + 1
			Net.fire("KeypadResult", player, false)
		end
	end, 3)

	-- CCTV terminal
	Services.Interaction.add(refs.hospital.cctvScreen, { action = "View Footage", object = "CCTV Terminal", distance = 8, id = "cctv_log", kind = "doc" }, function(player)
		Services.Rewards.collectDocument(player, "cctv_log")
		readDocument(player, "cctv_log")
		onStoryEvent("doc_cctv_log", player)
	end)

	-- Lobby keycard reader
	Services.Interaction.add(refs.hospital.reader, { action = "Use Keycard", object = "Lobby Doors", distance = 8 }, function(player)
		if Doors.get("lobby").isOpen then
			return
		end
		if not Services.Inventory.hasParty("keycard_hospital") then
			Net.fire("Notify", player, "Requires a Security Keycard.", "info")
			return
		end
		Services.Inventory.consumeParty("keycard_hospital")
		Doors.get("lobby"):open()
		refs.hospital.chains.Transparency = 1
		setLight(refs.hospital.reader.Parent:FindFirstChild("ReaderLight"), true)
		Services.Cinematic.play(participants(), "lobby_open")
		advance(IDX.survivor)
	end)

	-- Secret bookshelf
	local shelf = Doors.get("secret_shelf")
	refs.secretPrompt = Services.Interaction.add(shelf.panels[1].part, { action = "Pull the red book", object = "Bookshelf", distance = 7, hold = 0.6 }, function(player)
		if shelf.isOpen then
			return
		end
		shelf:open()
		refs.secretPrompt.Enabled = false
		Services.Rewards.unlock(player, "secret_keeper")
		Net.fire("Notify", player, "A hidden room!", "reward")
	end)

	-- Breaker puzzle (correct: 1 and 3 up, 2 down - see the maintenance memo)
	for i, lever in ipairs(refs.city.breakerLevers) do
		Services.Interaction.add(lever, { action = "Flip", object = "Breaker " .. i, distance = 8 }, function(player)
			if Doors.get("armory").isOpen then
				return
			end
			session.breakers[i] = not session.breakers[i]
			setBreakerVisual(i, session.breakers[i])
			local b = session.breakers
			if b[2] then
				Net.fire("Notify", player, "An alarm buzzes from the cell block... breaker 2 trips back down.", "bad")
				task.delay(0.8, function()
					session.breakers[2] = false
					setBreakerVisual(2, false)
				end)
			elseif b[1] and b[3] then
				Doors.get("armory"):open()
				Services.Rewards.unlock(player, "electrician")
				notifyAll("Power restored - the armory door slides open.", "good")
			end
		end)
	end

	-- Generator
	local generator = refs.city.generatorLight
	Services.Interaction.add(generator, { action = "Install Fuse", object = "Generator", distance = 10 }, function(player)
		if session.stage ~= IDX.generator then
			if session.stage < IDX.generator then
				Net.fire("Notify", player, "The generator is missing a fuse.", "info")
			end
			return
		end
		if not Services.Inventory.consumeParty("fuse") then
			Net.fire("Notify", player, "You need a fuse from the police armory.", "info")
			return
		end
		setLight(generator, true)
		advance(IDX.boss)
		Services.Cinematic.play(participants(), "boss_reveal")
		task.delay(Services.Cinematic.length("boss_reveal") - 1, spawnBoss)
	end)
end

-- Session lifecycle ------------------------------------------------------------------------------------------
local function startSession(stageIndex)
	session.running = true
	session.completing = false
	session.stage = stageIndex
	session.startedAt = os.clock()
	session.code = string.format("%04d", math.random(1000, 9999))
	session.keypadFails = 0
	Services.Inventory.resetSession()
	setupPickups(stageIndex)
	Services.Zombies.clearAll()
	Services.Zombies.skipFixedBefore(stageIndex)
	applyWorldState(stageIndex)
	Services.Zombies.setEnabled(true)
	Services.Zombies.setStage(stageIndex)
	if stageIndex == IDX.boss then
		task.delay(4, spawnBoss)
	end
	print(("[Mission] Chapter 1 session started at stage %d (%s)"):format(stageIndex, STAGES[stageIndex].key))
end

function MissionService.endSession()
	session.running = false
	session.completing = false
	session.stage = 0
	Services.Zombies.setEnabled(false)
	Services.Zombies.clearAll()
	for player in pairs(session.participants) do
		if player.Parent then
			Services.Player.clearEquipment(player)
			Services.Player.despawn(player)
			Services.Inventory.resetPlayer(player)
			Services.sync(player)
		end
	end
	session.participants = {}
end

local function joinSession(player, isNewRun)
	session.participants[player] = { kills = 0 }
	local pSession = Services.Player.getSession(player)
	if pSession then
		pSession.wentDown = false
	end
	Services.Player.spawn(player, checkpointPosition())
	grantStageEquipment(player)
	sendObjective(player)
	Net.fire("PartyInventory", player, Services.Inventory.getParty())
	if session.stage == IDX.find_light and isNewRun then
		Services.Cinematic.play({ player }, "intro")
		Services.Rewards.unlock(player, "wake_up")
	end
	sendHint(player, "move")
	sendHint(player, STAGES[session.stage].hint)
	task.delay(25, function()
		if player.Parent then
			sendHint(player, "inventory")
		end
	end)
	Services.sync(player)
end

local function onRequestPlay(player, mode)
	if mode ~= "continue" and mode ~= "new" then
		return
	end
	local profile = Services.Data.get(player)
	if not profile or session.participants[player] or session.completing then
		return
	end
	local isNewRun = false
	if not session.running then
		local stageIndex = 1
		if mode == "continue" then
			stageIndex = math.clamp(math.floor(tonumber(profile.chapters.ch1.checkpointStage) or 1), 1, #STAGES)
		else
			profile.chapters.ch1.checkpointStage = 1
		end
		isNewRun = stageIndex == 1
		startSession(stageIndex)
	end
	joinSession(player, isNewRun)
end

function MissionService.respawn(player)
	if session.running and session.participants[player] then
		Services.Player.spawn(player, checkpointPosition())
		grantStageEquipment(player)
		sendObjective(player)
	else
		Services.Player.despawn(player)
		Net.fire("ShowMenu", player)
	end
end

local function leaveSession(player)
	if not session.participants[player] then
		return
	end
	session.participants[player] = nil
	if session.running and #participants() == 0 then
		MissionService.endSession()
	end
end

-- Escape trigger --------------------------------------------------------------------------------------------
local escapeAccumulator = 0
local function escapeCheck(dt)
	escapeAccumulator = escapeAccumulator + dt
	if escapeAccumulator < 0.5 then
		return
	end
	escapeAccumulator = 0
	if not session.running or session.stage ~= IDX.escape or session.completing then
		return
	end
	for _, player in ipairs(participants()) do
		local _, humanoid, root = Services.Player.getParts(player)
		if root and humanoid.Health > 0 then
			local flat = Vector3.new(root.Position.X - P.EscapeZone.X, 0, root.Position.Z - P.EscapeZone.Z)
			if flat.Magnitude < 7 then
				completeChapter()
				return
			end
		end
	end
end

function MissionService.init(services)
	Services = services
end

function MissionService.start(worldRefs)
	refs = worldRefs
	pickupFolder = Instance.new("Folder")
	pickupFolder.Name = "Pickups"
	pickupFolder.Parent = worldRefs.interactables
	maya = buildMaya()
	setupInteractables()
	applyWorldState(1)

	Services.Dialogue.onEvent(function(player, event)
		if event == "maya_done" and session.stage == IDX.survivor then
			advance(IDX.fuse)
		end
	end)

	Services.Zombies.onKilled(function(typeName, killer, position, def)
		if killer and killer.Parent then
			Services.Rewards.addStat(killer, "zombiesDefeated", 1)
			local data = session.participants[killer]
			if data then
				data.kills = data.kills + 1
			end
		end
		if not session.running then
			return
		end
		if def.boss then
			dropConsumable("medkit", position)
			if session.stage == IDX.boss then
				for _, p in ipairs(participants()) do
					Services.Rewards.unlock(p, "warden_down")
				end
				Doors.get("subway_gate"):open()
				placeMaya(P.MayaSubway, P.BossSpawn)
				notifyAll("The Warden is down! The subway gate is open.", "good")
				advance(IDX.escape)
			end
		elseif math.random() < (typeName == "Heavy" and 0.5 or 0.1) then
			dropConsumable("bandage", position)
		end
	end)

	Net.on("RequestPlay", onRequestPlay, 2)
	Net.on("ReturnToMenu", function(player)
		if session.participants[player] then
			leaveSession(player)
			Services.Player.clearEquipment(player)
			Services.Player.despawn(player)
			Services.Inventory.resetPlayer(player)
			Services.sync(player)
			Net.fire("ShowMenu", player)
		end
	end, 2)
	Players.PlayerRemoving:Connect(leaveSession)
	RunService.Heartbeat:Connect(escapeCheck)

	-- sanity check: every cinematic referenced by the mission exists
	for _, id in ipairs({ "intro", "lobby_open", "meet_maya", "boss_reveal", "escape" }) do
		assert(Cinematics[id], "Missing cinematic " .. id)
	end
end

return MissionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[--[[
	MonetizationService
	Fair, cosmetic-only monetization through Roblox's official
	MarketplaceService.
	- VIP Game Pass: cosmetic VIP items (gold beam, VIP pack, VIP title)
	- Developer Products: cosmetic bundles
	ProcessReceipt is idempotent: each PurchaseId is recorded inside the
	player's profile and only reported as granted after a successful save.
	Nothing story-related or power-related is ever sold.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Net = require(Shared:WaitForChild("Net"))

local MonetizationService = {}
local Services

local productsById = {}
local productsByKey = {}
for _, p in ipairs(Config.Monetization.Products) do
	productsByKey[p.key] = p
	if p.productId and p.productId ~= 0 then
		productsById[p.productId] = p
	end
end

local function grantVip(player)
	player:SetAttribute("VIP", true)
	for _, id in ipairs(Cosmetics.VipItems) do
		Services.Rewards.grantCosmetic(player, id, true)
	end
	Services.sync(player)
end

local function checkVip(player)
	local passId = Config.Monetization.VipGamePassId
	if passId == 0 then
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	if ok and owns then
		grantVip(player)
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = Services.Data.waitFor(player, 10)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	profile.purchases = profile.purchases or {}
	if profile.purchases[info.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already handled
	end
	local product = productsById[info.ProductId]
	if not product then
		warn("[Monetization] Unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local newlyGranted = {}
	for _, cosmeticId in ipairs(product.cosmetics) do
		if not profile.cosmetics.owned[cosmeticId] then
			profile.cosmetics.owned[cosmeticId] = true
			table.insert(newlyGranted, cosmeticId)
		end
	end
	profile.purchases[info.PurchaseId] = os.time()
	if not Services.Data.save(player, false) then
		-- roll back so Roblox retries later
		profile.purchases[info.PurchaseId] = nil
		for _, id in ipairs(newlyGranted) do
			profile.cosmetics.owned[id] = nil
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Net.fire("Notify", player, "Thank you! " .. product.name .. " unlocked.", "reward")
	Services.sync(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Catalog shown in the client shop (only configured items).
function MonetizationService.catalog()
	local list = {}
	if Config.Monetization.VipGamePassId ~= 0 then
		table.insert(list, { key = "vip", name = "VIP Membership", cosmetics = Cosmetics.VipItems, gamepass = true })
	end
	for _, p in ipairs(Config.Monetization.Products) do
		if p.productId ~= 0 then
			table.insert(list, { key = p.key, name = p.name, cosmetics = p.cosmetics, price = p.price })
		end
	end
	return list
end

local function onBuy(player, key)
	if type(key) ~= "string" then
		return
	end
	if key == "vip" then
		local passId = Config.Monetization.VipGamePassId
		if passId ~= 0 and not player:GetAttribute("VIP") then
			MarketplaceService:PromptGamePassPurchase(player, passId)
		end
		return
	end
	local product = productsByKey[key]
	if product and product.productId ~= 0 then
		MarketplaceService:PromptProductPurchase(player, product.productId)
	end
end

function MonetizationService.init(services)
	Services = services
end

function MonetizationService.start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Config.Monetization.VipGamePassId then
			grantVip(player)
			Net.fire("Notify", player, "Welcome to VIP! Your cosmetics are unlocked.", "reward")
		end
	end)
	Services.Data.onLoaded(function(player)
		checkVip(player)
	end)
	Net.on("BuyProduct", onBuy, 2)
end

return MonetizationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[--[[
	PlayerService
	Server-authoritative player state: spawning, health, sprint stamina,
	flashlight, equipment, downed/revive (co-op), cosmetics visuals.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local PlayerService = {}
local Services

local sessions = {} -- [player] = session table
local PC = Config.Player

local function newSession()
	return {
		sprintRequested = false,
		sprinting = false,
		stamina = PC.MaxStamina,
		lastSprintAt = 0,
		lastDamageAt = 0,
		equipment = {},
		flashlightOn = false,
		wentDown = false,
		playing = false,
	}
end

function PlayerService.getSession(player)
	return sessions[player]
end

local function getParts(player)
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return nil
	end
	return character, humanoid, root
end
PlayerService.getParts = getParts

function PlayerService.isAlive(player)
	local character, humanoid = getParts(player)
	return character ~= nil and humanoid.Health > 0
end

function PlayerService.isActive(player)
	local character, humanoid = getParts(player)
	return character ~= nil and humanoid.Health > 0 and not character:GetAttribute("Downed")
end

-- Cosmetics visuals -------------------------------------------------------------
local function torsoOf(character)
	return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
end

local function weldPart(parentPart, offset, props, model)
	local part = Instance.new("Part")
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		part[k] = v
	end
	part.CFrame = parentPart.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parentPart
	weld.Part1 = part
	weld.Parent = part
	part.Parent = model
	return part
end

function PlayerService.applyCosmetics(player)
	local character = player.Character
	local profile = Services.Data.get(player)
	if not character or not profile then
		return
	end
	local equipped = profile.cosmetics.equipped
	-- flashlight colour
	local head = character:FindFirstChild("Head")
	local light = head and head:FindFirstChild("Flashlight")
	local lightDef = Cosmetics[equipped.light] or Cosmetics.light_default
	if light then
		light.Color = lightDef.color
	end
	-- gear
	local old = character:FindFirstChild("CosmeticGear")
	if old then
		old:Destroy()
	end
	local gearDef = Cosmetics[equipped.gear]
	local torso = torsoOf(character)
	if gearDef and gearDef.style ~= "none" and torso then
		local model = Instance.new("Model")
		model.Name = "CosmeticGear"
		if gearDef.style == "pack" then
			weldPart(torso, CFrame.new(0, 0, 0.95), { Size = Vector3.new(1.7, 2, 0.9), Material = Enum.Material.Fabric, Color = gearDef.color }, model)
			weldPart(torso, CFrame.new(0, -0.55, 1.42), { Size = Vector3.new(1.3, 0.7, 0.2), Material = Enum.Material.Fabric, Color = gearDef.accent }, model)
			weldPart(torso, CFrame.new(0, 1.05, 0.9), { Size = Vector3.new(1.5, 0.35, 0.7), Material = Enum.Material.Fabric, Color = gearDef.accent }, model)
		elseif gearDef.style == "tank" then
			for _, x in ipairs({ -0.45, 0.45 }) do
				weldPart(torso, CFrame.new(x, 0, 0.95) * CFrame.Angles(0, 0, math.rad(90)), { Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.2, 0.8, 0.8), Material = Enum.Material.Metal, Color = gearDef.color }, model)
			end
			weldPart(torso, CFrame.new(0, 1.1, 0.95), { Size = Vector3.new(1.4, 0.25, 0.4), Material = Enum.Material.Metal, Color = gearDef.accent }, model)
		end
		model.Parent = character
	end
	-- title
	if head then
		local oldTag = head:FindFirstChild("TitleTag")
		if oldTag then
			oldTag:Destroy()
		end
		local titleDef = Cosmetics[equipped.title]
		if titleDef and titleDef.text and titleDef.text ~= "" then
			local bb = Instance.new("BillboardGui")
			bb.Name = "TitleTag"
			bb.Size = UDim2.fromOffset(160, 22)
			bb.StudsOffset = Vector3.new(0, 2.6, 0)
			bb.MaxDistance = 60
			bb.LightInfluence = 0
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamBlack
			label.TextScaled = true
			label.TextColor3 = titleDef.color or Color3.new(1, 1, 1)
			label.TextStrokeTransparency = 0.4
			label.Text = titleDef.text
			label.Parent = bb
			bb.Parent = head
		end
	end
end

-- Flashlight -------------------------------------------------------------------------
local function ensureFlashlight(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head or head:FindFirstChild("Flashlight") then
		return
	end
	local light = Instance.new("SpotLight")
	light.Name = "Flashlight"
	light.Face = Enum.NormalId.Front
	light.Range = 48
	light.Angle = 55
	light.Brightness = 3.2
	light.Shadows = true
	light.Enabled = false
	light.Parent = head
	local s = sessions[player]
	if s and s.flashlightOn then
		light.Enabled = true
	end
	PlayerService.applyCosmetics(player)
end

function PlayerService.setFlashlight(player, on)
	local s = sessions[player]
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local light = head and head:FindFirstChild("Flashlight")
	if not s or not light then
		return
	end
	s.flashlightOn = on
	light.Enabled = on
	character:SetAttribute("LightOn", on)
end

-- Equipment ------------------------------------------------------------------------------
function PlayerService.hasEquipment(player, id)
	local s = sessions[player]
	return s ~= nil and s.equipment[id] == true
end

function PlayerService.grantEquipment(player, id, silent)
	local s = sessions[player]
	if not s then
		return false
	end
	if s.equipment[id] then
		return false
	end
	s.equipment[id] = true
	if id == "flashlight" then
		ensureFlashlight(player)
		PlayerService.setFlashlight(player, true)
	elseif Config.Weapons[id] then
		Services.Combat.giveWeapon(player, id)
	end
	if not silent then
		Services.sync(player)
	end
	return true
end

function PlayerService.clearEquipment(player)
	local s = sessions[player]
	if s then
		s.equipment = {}
		s.flashlightOn = false
	end
end

-- Spawning ---------------------------------------------------------------------------------
function PlayerService.spawn(player, position)
	local s = sessions[player]
	if not s or not player.Parent then
		return
	end
	s.playing = true
	s.stamina = PC.MaxStamina
	player:LoadCharacter()
	local character = player.Character
	if character and position then
		character:PivotTo(CFrame.new(position + Vector3.new(math.random(-2, 2), 0, math.random(-2, 2))))
	end
end

function PlayerService.despawn(player)
	local s = sessions[player]
	if s then
		s.playing = false
	end
	if player.Character then
		player.Character:Destroy()
		player.Character = nil
	end
end

-- Damage / downed / revive ----------------------------------------------------------------------
local function removeRevivePrompt(character)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local prompt = root and root:FindFirstChild("RevivePrompt")
	if prompt then
		prompt:Destroy()
	end
	local hl = character and character:FindFirstChild("DownedHighlight")
	if hl then
		hl:Destroy()
	end
end

local function activeTeammates(except)
	local n = 0
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= except and PlayerService.isActive(other) then
			n = n + 1
		end
	end
	return n
end

function PlayerService.revive(player, reviver)
	local character, humanoid = getParts(player)
	if not character or not character:GetAttribute("Downed") then
		return
	end
	character:SetAttribute("Downed", false)
	removeRevivePrompt(character)
	humanoid.Health = math.max(humanoid.Health, 40)
	humanoid.WalkSpeed = PC.WalkSpeed
	Net.fire("Notify", player, (reviver and reviver.DisplayName or "Someone") .. " revived you!", "good")
	if reviver then
		Net.fire("Notify", reviver, "You revived " .. player.DisplayName .. ".", "good")
		Services.Rewards.addStat(reviver, "revives", 1)
		Services.Rewards.unlock(reviver, "team_player")
	end
end

local function down(player)
	local character, humanoid, root = getParts(player)
	local s = sessions[player]
	if not character or not s then
		return
	end
	s.wentDown = true
	character:SetAttribute("Downed", true)
	humanoid.Health = 15
	humanoid.WalkSpeed = PC.DownedSpeed
	s.sprinting = false

	local hl = Instance.new("Highlight")
	hl.Name = "DownedHighlight"
	hl.FillTransparency = 0.8
	hl.FillColor = Color3.fromRGB(255, 60, 60)
	hl.OutlineColor = Color3.fromRGB(255, 80, 80)
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = character

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive"
	prompt.ObjectText = player.DisplayName
	prompt.HoldDuration = PC.ReviveHoldTime
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = root
	prompt.Triggered:Connect(function(reviver)
		if reviver ~= player and PlayerService.isActive(reviver) then
			local _, _, rRoot = getParts(reviver)
			if rRoot and (rRoot.Position - root.Position).Magnitude < 14 then
				PlayerService.revive(player, reviver)
			end
		end
	end)

	Net.fire("Notify", player, "You are down! A teammate can revive you.", "bad")
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			Net.fire("Notify", other, player.DisplayName .. " is down! Hold E / tap to revive.", "bad")
		end
	end

	local downedCharacter = character
	task.delay(PC.DownedDuration, function()
		if downedCharacter.Parent and downedCharacter:GetAttribute("Downed") then
			local h = downedCharacter:FindFirstChildOfClass("Humanoid")
			if h then
				h.Health = 0
			end
		end
	end)

	-- if nobody is left standing, the whole party falls
	if activeTeammates(nil) == 0 then
		for _, other in ipairs(Players:GetPlayers()) do
			local c, h = getParts(other)
			if c and c:GetAttribute("Downed") then
				h.Health = 0
			end
		end
	end
end

function PlayerService.damage(player, amount, attackerName)
	local character, humanoid = getParts(player)
	local s = sessions[player]
	if not character or not s or humanoid.Health <= 0 then
		return false
	end
	if character:GetAttribute("Downed") or player:GetAttribute("InCinematic") then
		return false
	end
	s.lastDamageAt = os.clock()
	local newHealth = humanoid.Health - amount
	if newHealth <= 0 then
		if activeTeammates(player) > 0 then
			down(player)
		else
			s.wentDown = true
			humanoid.Health = 0
		end
	else
		humanoid.Health = newHealth
	end
	Net.fire("Shake", player, math.clamp(amount / 30, 0.15, 0.8), 0.25)
	return true
end

function PlayerService.heal(player, amount)
	local _, humanoid = getParts(player)
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
		return true
	end
	return false
end

function PlayerService.slow(player, seconds)
	local character, humanoid = getParts(player)
	if not character then
		return
	end
	character:SetAttribute("SlowUntil", os.clock() + seconds)
	humanoid.WalkSpeed = PC.WalkSpeed * 0.6
end

-- Character setup ---------------------------------------------------------------------------------------
local function onCharacterAdded(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	local s = sessions[player]
	humanoid.MaxHealth = PC.MaxHealth
	humanoid.Health = PC.MaxHealth
	humanoid.WalkSpeed = PC.WalkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.HealthDisplayDistance = 0
	humanoid.NameDisplayDistance = 60
	character:SetAttribute("Downed", false)
	character:SetAttribute("LightOn", false)

	character:WaitForChild("Head", 10)
	if s then
		if s.equipment.flashlight then
			ensureFlashlight(player)
			PlayerService.setFlashlight(player, s.flashlightOn)
		end
		for id in pairs(s.equipment) do
			if Config.Weapons[id] then
				Services.Combat.giveWeapon(player, id)
			end
		end
	end
	PlayerService.applyCosmetics(player)

	humanoid.Died:Connect(function()
		removeRevivePrompt(character)
		if s then
			s.wentDown = true
		end
		Services.Rewards.addStat(player, "deaths", 1)
		task.delay(4, function()
			if player.Parent and player.Character == character then
				Services.Mission.respawn(player)
			end
		end)
	end)
end

-- Loop: stamina, sprint speed, passive regen ---------------------------------------------------------------
local accumulator = 0
local function tick(dt)
	for player, s in pairs(sessions) do
		local character, humanoid, root = getParts(player)
		if character and humanoid.Health > 0 then
			local downed = character:GetAttribute("Downed")
			local slowUntil = character:GetAttribute("SlowUntil")
			local slowed = slowUntil and os.clock() < slowUntil
			local v = root.AssemblyLinearVelocity
			local moving = Vector3.new(v.X, 0, v.Z).Magnitude > 2
			local canSprint = not downed and s.sprintRequested and moving
				and (s.sprinting and s.stamina > 0 or s.stamina >= PC.MinStaminaToSprint)
			s.sprinting = canSprint and true or false
			if s.sprinting then
				s.stamina = math.max(0, s.stamina - PC.SprintDrain * dt)
				s.lastSprintAt = os.clock()
			elseif os.clock() - s.lastSprintAt > PC.RegenDelay then
				s.stamina = math.min(PC.MaxStamina, s.stamina + PC.StaminaRegen * dt)
			end
			local speed
			if downed then
				speed = PC.DownedSpeed
			elseif s.sprinting then
				speed = PC.SprintSpeed
			else
				speed = PC.WalkSpeed
			end
			if slowed and not downed then
				speed = speed * 0.6
			end
			if humanoid.WalkSpeed ~= speed then
				humanoid.WalkSpeed = speed
			end
			character:SetAttribute("Sprinting", s.sprinting)
			local rounded = math.floor(s.stamina + 0.5)
			if player:GetAttribute("Stamina") ~= rounded then
				player:SetAttribute("Stamina", rounded)
			end
			-- passive regeneration (only a little - bandages do the rest)
			if not downed and os.clock() - s.lastDamageAt > 6 and humanoid.Health < PC.PassiveRegenCap then
				humanoid.Health = math.min(PC.PassiveRegenCap, humanoid.Health + PC.PassiveRegenRate * dt)
			end
		end
	end
end

function PlayerService.init(services)
	Services = services
end

function PlayerService.start()
	Players.CharacterAutoLoads = false

	local function onPlayerAdded(player)
		sessions[player] = newSession()
		player:SetAttribute("Stamina", PC.MaxStamina)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayerAdded(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)

	Net.on("SetSprint", function(player, on)
		local s = sessions[player]
		if s and type(on) == "boolean" then
			s.sprintRequested = on
		end
	end, 20)

	Net.on("ToggleFlashlight", function(player)
		local s = sessions[player]
		if s and s.equipment.flashlight then
			PlayerService.setFlashlight(player, not s.flashlightOn)
		end
	end, 6)

	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator >= 0.1 then
			local step = accumulator
			accumulator = 0
			tick(step)
		end
	end)
end

return PlayerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">RewardService</string><ProtectedString name="Source"><![CDATA[--[[
	RewardService
	Achievements, statistics, daily cosmetic rewards and cosmetic equipping.
	Everything here is cosmetic or informational - no power progression.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Achievements = require(Shared:WaitForChild("Achievements"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local RewardService = {}
local Services

function RewardService.grantCosmetic(player, cosmeticId, silent)
	local profile = Services.Data.get(player)
	local def = Cosmetics[cosmeticId]
	if not profile or not def then
		return false
	end
	if profile.cosmetics.owned[cosmeticId] then
		return false
	end
	profile.cosmetics.owned[cosmeticId] = true
	if not silent then
		Net.fire("Notify", player, "New cosmetic unlocked: " .. def.name, "reward")
	end
	return true
end

function RewardService.unlock(player, achievementId)
	local profile = Services.Data.get(player)
	local def = Achievements[achievementId]
	if not profile or not def or profile.achievements[achievementId] then
		return
	end
	profile.achievements[achievementId] = os.time()
	Net.fire("Notify", player, "Achievement: " .. def.name, "achievement")
	if def.reward then
		RewardService.grantCosmetic(player, def.reward)
	end
	Services.sync(player)
end

function RewardService.addStat(player, stat, amount)
	local profile = Services.Data.get(player)
	if not profile then
		return
	end
	profile.stats[stat] = (profile.stats[stat] or 0) + amount
	if stat == "zombiesDefeated" then
		RewardService.unlock(player, "first_takedown")
		if profile.stats.zombiesDefeated >= 100 then
			RewardService.unlock(player, "exterminator")
		end
	end
end

function RewardService.collectDocument(player, docId)
	local profile = Services.Data.get(player)
	if not profile or profile.documents[docId] then
		return false
	end
	profile.documents[docId] = true
	local Documents = require(Shared:WaitForChild("Documents"))
	local all = true
	for _, id in ipairs(Documents.ResearchChapter1) do
		if not profile.documents[id] then
			all = false
		end
	end
	if all then
		RewardService.unlock(player, "archivist1")
	end
	Services.sync(player)
	return true
end

-- Daily rewards: one claim per UTC day, streak advances on consecutive days.
local function claimDaily(player)
	local profile = Services.Data.get(player)
	if not profile then
		return
	end
	local today = Util.dayNumber()
	local daily = profile.daily
	if daily.lastDay == today then
		Net.fire("Notify", player, "Daily reward already claimed. Come back tomorrow!", "info")
		return
	end
	if daily.lastDay == today - 1 then
		daily.streak = daily.streak + 1
	else
		daily.streak = 1
	end
	daily.lastDay = today
	-- Give the first cosmetic in the rotation the player doesn't own yet.
	local list = Config.DailyRewards
	local granted = nil
	for i = 0, #list - 1 do
		local id = list[((daily.streak - 1 + i) % #list) + 1]
		if not profile.cosmetics.owned[id] then
			granted = id
			break
		end
	end
	if granted then
		RewardService.grantCosmetic(player, granted)
	else
		Net.fire("Notify", player, "Day " .. daily.streak .. " streak! You own every daily cosmetic.", "reward")
	end
	Services.sync(player)
end

local function equip(player, cosmeticId)
	local profile = Services.Data.get(player)
	local def = type(cosmeticId) == "string" and Cosmetics[cosmeticId]
	if not profile or not def or def.category == "emote" then
		return
	end
	if not profile.cosmetics.owned[cosmeticId] then
		return
	end
	profile.cosmetics.equipped[def.category] = cosmeticId
	Services.Player.applyCosmetics(player)
	Services.sync(player)
end

local SETTINGS_SCHEMA = {
	graphics = { "Auto", "Low", "Medium", "High" },
	music = "number",
	sfx = "number",
	subtitles = "boolean",
	cameraShake = "boolean",
	tutorials = "boolean",
}

local function saveSettings(player, incoming)
	local profile = Services.Data.get(player)
	if not profile or type(incoming) ~= "table" then
		return
	end
	for key, rule in pairs(SETTINGS_SCHEMA) do
		local v = incoming[key]
		if rule == "number" and type(v) == "number" and v == v then
			profile.settings[key] = math.clamp(v, 0, 1)
		elseif rule == "boolean" and type(v) == "boolean" then
			profile.settings[key] = v
		elseif type(rule) == "table" and type(v) == "string" and table.find(rule, v) then
			profile.settings[key] = v
		end
	end
end

function RewardService.init(services)
	Services = services
end

function RewardService.start()
	Net.on("ClaimDaily", claimDaily, 2)
	Net.on("EquipCosmetic", equip, 6)
	Net.on("SaveSettings", saveSettings, 3)
end

return RewardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">ZombieService</string><ProtectedString name="Source"><![CDATA[--[[
	ZombieService
	Spawning, AI and combat for all infected.

	Performance design (mobile friendly):
	- One shared AI loop (no script per zombie), ticking every Config.Zombies.TickRate
	- Rigs are built once per type and cloned
	- Pathfinding only when the direct route is blocked, throttled per zombie
	- Server network ownership (no jitter), zombie-zombie collisions disabled
	- Population cap scales with party size; far zombies despawn

	Behaviour: idle/wander -> detect (sight with line-of-sight, hearing for
	sprinting players, flashlight attraction) -> chase (direct or path) ->
	attack with wind-up -> lose interest when the target escapes.
]]

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local PhysicsService = game:GetService("PhysicsService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local ZombieTypes = require(Shared:WaitForChild("ZombieTypes"))
local Layout = require(Shared:WaitForChild("Layout"))
local Net = require(Shared:WaitForChild("Net"))

local ZombieService = {}
local Services

local ZC = Config.Zombies
local templates = {}
local zombies = {} -- [model] = state
local folder
local stage = 0
local activeRegions = {}
local fixedSpawned = {}
local killedCallbacks = {}
local lastAmbientSpawn = 0
local enabled = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

-- Rig construction --------------------------------------------------------------------------
local function addEyes(model, def)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local face = head:FindFirstChildOfClass("Decal")
	if face then
		face:Destroy()
	end
	local s = head.Size.Y / 1.2
	for _, x in ipairs({ -0.22, 0.22 }) do
		local eye = Instance.new("Part")
		eye.Name = "Eye"
		eye.Shape = Enum.PartType.Ball
		eye.Size = Vector3.new(0.22, 0.22, 0.22) * s
		eye.Material = Enum.Material.Neon
		eye.Color = def.eyes
		eye.CanCollide = false
		eye.CanQuery = false
		eye.CanTouch = false
		eye.Massless = true
		eye.CastShadow = false
		eye.CFrame = head.CFrame * CFrame.new(x * s, 0.12 * s, -0.55 * s)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = eye
		weld.Parent = eye
		eye.Parent = model
	end
	local mouth = Instance.new("Part")
	mouth.Name = "Mouth"
	mouth.Size = Vector3.new(0.5, 0.12, 0.05) * s
	mouth.Color = Color3.fromRGB(25, 15, 15)
	mouth.Material = Enum.Material.SmoothPlastic
	mouth.CanCollide = false
	mouth.CanQuery = false
	mouth.Massless = true
	mouth.CFrame = head.CFrame * CFrame.new(0, -0.25 * s, -0.6 * s)
	local w = Instance.new("WeldConstraint")
	w.Part0 = head
	w.Part1 = mouth
	w.Parent = mouth
	mouth.Parent = model
end

local function addDetails(model, typeName, def)
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if not torso then
		return
	end
	if def.glow then
		local light = Instance.new("PointLight")
		light.Color = def.glow
		light.Range = typeName == "Warden" and 18 or 10
		light.Brightness = 1.5
		light.Parent = torso
		local att = Instance.new("Attachment")
		att.Parent = torso
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
		pe.Color = ColorSequence.new(def.glow)
		pe.LightEmission = 0.6
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1) })
		pe.Size = NumberSequence.new(1.2, 2.5)
		pe.Rate = 6
		pe.Lifetime = NumberRange.new(1, 1.6)
		pe.Speed = NumberRange.new(0.5, 1.5)
		pe.Parent = att
		CollectionService:AddTag(pe, "OptionalParticle")
	end
	if typeName == "Warden" then
		-- riot armour plates (old hospital security)
		local function plate(cf, size)
			local p = Instance.new("Part")
			p.Name = "Armor"
			p.Size = size
			p.Material = Enum.Material.DiamondPlate
			p.Color = Color3.fromRGB(45, 50, 60)
			p.CanCollide = false
			p.Massless = true
			p.CFrame = torso.CFrame * cf
			local w = Instance.new("WeldConstraint")
			w.Part0 = torso
			w.Part1 = p
			w.Parent = p
			p.Parent = model
		end
		local sx, sy = torso.Size.X, torso.Size.Y
		plate(CFrame.new(0, 0, -torso.Size.Z / 2 - 0.1), Vector3.new(sx * 0.9, sy * 0.8, 0.3))
		plate(CFrame.new(-sx * 0.55, sy * 0.45, 0), Vector3.new(sx * 0.4, 0.4, torso.Size.Z * 1.2))
		plate(CFrame.new(sx * 0.55, sy * 0.45, 0), Vector3.new(sx * 0.4, 0.4, torso.Size.Z * 1.2))
	end
end

local function buildFallbackRig(def)
	-- Used only if Roblox's avatar service is unavailable: a simple block rig.
	local model = Instance.new("Model")
	local h = def.scale.height
	local w = def.scale.width
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2 * w, 2 * h, 1 * w)
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model
	local function limb(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.CFrame = root.CFrame * offset
		p.CanCollide = name == "Torso"
		local wc = Instance.new("WeldConstraint")
		wc.Part0 = root
		wc.Part1 = p
		wc.Parent = p
		p.Parent = model
	end
	limb("Torso", Vector3.new(2 * w, 2 * h, 1 * w), CFrame.new(), def.shirt)
	limb("Head", Vector3.new(1.2, 1.2, 1.2) * def.scale.head, CFrame.new(0, 1.6 * h, 0), def.skin)
	limb("Left Arm", Vector3.new(1 * w, 2 * h, 1 * w), CFrame.new(-1.5 * w, 0.3 * h, -0.8) * CFrame.Angles(math.rad(80), 0, 0), def.skin)
	limb("Right Arm", Vector3.new(1 * w, 2 * h, 1 * w), CFrame.new(1.5 * w, 0.3 * h, -0.8) * CFrame.Angles(math.rad(80), 0, 0), def.skin)
	limb("Left Leg", Vector3.new(1 * w, 2 * h, 1 * w), CFrame.new(-0.5 * w, -2 * h, 0), def.pants)
	limb("Right Leg", Vector3.new(1 * w, 2 * h, 1 * w), CFrame.new(0.5 * w, -2 * h, 0), def.pants)
	local hum = Instance.new("Humanoid")
	hum.HipHeight = 2 * h
	hum.Parent = model
	model.PrimaryPart = root
	return model
end

local function buildTemplate(typeName)
	local def = ZombieTypes[typeName]
	local model
	local ok, err = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = def.skin
		desc.LeftArmColor = def.skin
		desc.RightArmColor = def.skin
		desc.TorsoColor = def.shirt
		desc.LeftLegColor = def.pants
		desc.RightLegColor = def.pants
		-- Avatar scales are limited by Roblox, so build a normal-sized rig with a
		-- thinner/thicker build and then scale the whole model uniformly.
		desc.HeightScale = 1
		desc.WidthScale = math.clamp(def.scale.width / def.scale.height, 0.7, 1)
		desc.DepthScale = math.clamp(def.scale.depth / def.scale.height, 0.7, 1)
		desc.HeadScale = 1
		desc.BodyTypeScale = 0
		desc.ProportionScale = 0
		model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		if math.abs(def.scale.height - 1) > 0.01 then
			model:ScaleTo(def.scale.height)
		end
	end)
	if not ok or not model then
		warn("[ZombieService] Avatar rig unavailable, using block rig for " .. typeName .. ": " .. tostring(err))
		model = buildFallbackRig(def)
	end
	model.Name = def.displayName
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.MaxHealth = def.health
	humanoid.Health = def.health
	humanoid.WalkSpeed = def.walkSpeed
	if not humanoid:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = humanoid
	end
	addEyes(model, def)
	addDetails(model, typeName, def)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Zombies"
			d.CastShadow = d.Name ~= "Eye"
		end
	end
	CollectionService:AddTag(model, "Zombie")
	return model
end

-- Helpers ---------------------------------------------------------------------------------------
local function playSound(parent, id, speed, volume)
	if not id or id == "" or not parent then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.PlaybackSpeed = speed or 1
	s.Volume = volume or 0.6
	s.RollOffMinDistance = 8
	s.RollOffMaxDistance = 90
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 4)
end

local function groundAt(position)
	-- cast from just above the spawn point so indoor spawns don't land on roofs
	rayParams.FilterDescendantsInstances = { folder }
	local result = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -40, 0), rayParams)
	if result then
		return result.Position
	end
	return Vector3.new(position.X, 0, position.Z)
end

-- True when a zombie-sized box at 'position' does not overlap solid geometry.
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
local function isClear(position)
	overlapParams.FilterDescendantsInstances = { folder }
	local parts = workspace:GetPartBoundsInBox(CFrame.new(position + Vector3.new(0, 3.2, 0)), Vector3.new(2.5, 4, 2.5), overlapParams)
	for _, part in ipairs(parts) do
		if part.CanCollide then
			return false
		end
	end
	return true
end

-- Finds a free spot near 'center' (tries a few random points within 'radius').
local function findSpawnPoint(center, radius)
	for _ = 1, 8 do
		local angle = math.random() * math.pi * 2
		local candidate = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * math.random() * radius
		if isClear(candidate) then
			return candidate
		end
	end
	return isClear(center) and center or nil
end
ZombieService.findSpawnPoint = findSpawnPoint

local function hasLineOfSight(fromPos, toPos, ignore)
	rayParams.FilterDescendantsInstances = ignore
	local dir = toPos - fromPos
	local result = workspace:Raycast(fromPos, dir, rayParams)
	return result == nil
end

local function playerCharacters()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 and not character:GetAttribute("Downed") and not player:GetAttribute("InCinematic") then
			table.insert(list, { player = player, character = character, root = root })
		end
	end
	return list
end

local function countAlive(filter)
	local n = 0
	for _, z in pairs(zombies) do
		if not z.dead and (not filter or filter(z)) then
			n = n + 1
		end
	end
	return n
end

-- Spawning ----------------------------------------------------------------------------------------
function ZombieService.spawn(typeName, position, opts)
	opts = opts or {}
	local def = ZombieTypes[typeName]
	local template = templates[typeName]
	if not def or not template then
		return nil
	end
	local model = template:Clone()
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	local health = def.health
	if def.boss then
		health = math.floor(def.health * (1 + 0.6 * math.max(0, #Players:GetPlayers() - 1)))
	end
	humanoid.MaxHealth = health
	humanoid.Health = health
	local ground = groundAt(position)
	model:PivotTo(CFrame.new(ground + Vector3.new(0, 3 * def.scale.height, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local animator = humanoid:FindFirstChildOfClass("Animator")
	local tracks = {}
	if animator then
		for key, animId in pairs({ idle = Config.Animations.ZombieIdle, walk = Config.Animations.ZombieWalk, run = Config.Animations.ZombieRun }) do
			local anim = Instance.new("Animation")
			anim.AnimationId = animId
			local ok, track = pcall(function()
				return animator:LoadAnimation(anim)
			end)
			if ok and track then
				track.Looped = true
				tracks[key] = track
			end
		end
		if tracks.idle then
			tracks.idle:Play(0.3)
		end
	end

	local state = {
		model = model,
		humanoid = humanoid,
		root = root,
		typeName = typeName,
		def = def,
		home = ground,
		region = opts.region,
		ambient = opts.ambient,
		target = nil,
		lastSeen = 0,
		lastAttack = 0,
		lastSlam = os.clock(),
		lastSummon = os.clock(),
		nextWander = os.clock() + math.random(2, 6),
		nextGroan = os.clock() + math.random(3, 10),
		path = nil,
		pathIndex = 0,
		lastPath = 0,
		computing = false,
		lastPos = root.Position,
		lastMoveCheck = os.clock(),
		tracks = tracks,
		anim = "idle",
		attacking = false,
		lastAttacker = nil,
		dead = false,
	}
	zombies[model] = state

	humanoid.Died:Connect(function()
		ZombieService._onDeath(state)
	end)

	if opts.aggro then
		local list = playerCharacters()
		local best, bestDist = nil, math.huge
		for _, c in ipairs(list) do
			local d = (c.root.Position - root.Position).Magnitude
			if d < bestDist then
				best, bestDist = c, d
			end
		end
		if best then
			state.target = best.player
			state.lastSeen = os.clock()
		end
	end
	if def.boss then
		Net.fireAll("BossBar", def.displayName, 1)
	end
	return model
end

function ZombieService.onKilled(callback)
	table.insert(killedCallbacks, callback)
end

function ZombieService._onDeath(state)
	if state.dead then
		return
	end
	state.dead = true
	for _, track in pairs(state.tracks) do
		track:Stop(0.2)
	end
	playSound(state.root, Config.Sounds.ZombieGroan, state.def.groanPitch * 0.8, 0.8)
	if state.def.boss then
		Net.fireAll("BossBar", nil, nil)
	end
	for _, cb in ipairs(killedCallbacks) do
		task.spawn(cb, state.typeName, state.lastAttacker, state.root.Position, state.def)
	end
	-- Non-graphic defeat: collapse and fade out.
	local model = state.model
	local root = state.root
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
	end)
	task.delay(0.6, function()
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				TweenService:Create(d, TweenInfo.new(1.2), { Transparency = 1 }):Play()
			elseif d:IsA("PointLight") then
				d.Enabled = false
			elseif d:IsA("ParticleEmitter") then
				d.Enabled = false
			end
		end
	end)
	task.delay(2, function()
		zombies[model] = nil
		model:Destroy()
	end)
end

function ZombieService.damage(model, amount, attacker, knock)
	local state = zombies[model]
	if not state or state.dead then
		return
	end
	state.lastAttacker = attacker
	state.humanoid:TakeDamage(amount)
	if attacker then
		state.target = attacker
		state.lastSeen = os.clock()
	end
	-- hit flash
	local hl = Instance.new("Highlight")
	hl.FillColor = Color3.new(1, 1, 1)
	hl.FillTransparency = 0.5
	hl.OutlineTransparency = 1
	hl.Parent = model
	Debris:AddItem(hl, 0.12)
	if knock and not state.dead then
		local resist = state.def.knockbackResist or 0
		local v = knock * (1 - resist)
		if v.Magnitude > 1 then
			state.root.AssemblyLinearVelocity = v + Vector3.new(0, 6 * (1 - resist), 0)
		end
	end
	if state.def.boss then
		Net.fireAll("BossBar", state.def.displayName, math.max(0, state.humanoid.Health / state.humanoid.MaxHealth))
	end
end

function ZombieService.clearAll()
	for model, state in pairs(zombies) do
		state.dead = true
		model:Destroy()
	end
	zombies = {}
	fixedSpawned = {}
	Net.fireAll("BossBar", nil, nil)
end

function ZombieService.setEnabled(on)
	enabled = on
end

function ZombieService.setStage(newStage)
	stage = newStage
	activeRegions = {}
	for _, region in ipairs(Layout.SpawnRegions) do
		if stage >= region.minStage and stage <= region.maxStage then
			table.insert(activeRegions, region)
			if region.fixed and not fixedSpawned[region.id] then
				fixedSpawned[region.id] = true
				for _, typeName in ipairs(region.fixed) do
					local point = findSpawnPoint(region.center, region.radius * 0.7)
					if point then
						ZombieService.spawn(typeName, point, { region = region.id })
					end
				end
			end
		end
	end
end

-- Mark fixed regions as already spawned (used when resuming from a later checkpoint).
function ZombieService.skipFixedBefore(stageIndex)
	for _, region in ipairs(Layout.SpawnRegions) do
		if region.fixed and region.maxStage < stageIndex then
			fixedSpawned[region.id] = true
		end
	end
end

function ZombieService.countBosses()
	return countAlive(function(z)
		return z.def.boss
	end)
end

local function ambientCap()
	return ZC.MaxActiveBase + ZC.MaxActivePerPlayer * #Players:GetPlayers()
end

local function trySpawnAmbient(chars)
	if os.clock() - lastAmbientSpawn < ZC.AmbientRespawnDelay or #chars == 0 then
		return
	end
	lastAmbientSpawn = os.clock()
	if countAlive() >= ambientCap() then
		return
	end
	local candidates = {}
	for _, region in ipairs(activeRegions) do
		if region.ambient then
			local nearest = math.huge
			for _, c in ipairs(chars) do
				nearest = math.min(nearest, (c.root.Position - region.center).Magnitude)
			end
			if nearest > 45 and nearest < 170 then
				table.insert(candidates, region)
			end
		end
	end
	if #candidates == 0 then
		return
	end
	local region = candidates[math.random(1, #candidates)]
	local typeName = "Normal"
	local roll = math.random()
	local mutatedAlive = countAlive(function(z)
		return z.typeName == "Mutated"
	end)
	if roll < ZC.MutatedChance and mutatedAlive == 0 and stage >= 7 then
		typeName = "Mutated"
	elseif roll < ZC.FastChance then
		typeName = "Fast"
	end
	local point = findSpawnPoint(region.center, region.radius)
	if point then
		ZombieService.spawn(typeName, point, { region = region.id, ambient = true })
	end
end

-- AI ------------------------------------------------------------------------------------------------
local function setAnim(state, name)
	if state.anim == name then
		return
	end
	state.anim = name
	for key, track in pairs(state.tracks) do
		if key == name then
			if not track.IsPlaying then
				track:Play(0.25)
			end
			track:AdjustSpeed(state.def.animSpeed or 1)
		elseif track.IsPlaying then
			track:Stop(0.25)
		end
	end
end

local function requestPath(state, goal)
	if state.computing or os.clock() - state.lastPath < ZC.PathRecomputeInterval then
		return
	end
	state.computing = true
	state.lastPath = os.clock()
	task.spawn(function()
		local scale = state.def.scale
		local path = PathfindingService:CreatePath({
			AgentRadius = 2 * scale.width,
			AgentHeight = 5 * scale.height,
			AgentCanJump = true,
			WaypointSpacing = 5,
		})
		local ok = pcall(function()
			path:ComputeAsync(state.root.Position, goal)
		end)
		state.computing = false
		if ok and path.Status == Enum.PathStatus.Success and not state.dead then
			state.path = path:GetWaypoints()
			state.pathIndex = 2
		else
			state.path = nil
		end
	end)
end

local function bossSlam(state, chars)
	local slam = state.def.slam
	state.attacking = true
	state.humanoid:MoveTo(state.root.Position)
	local center = state.root.Position - Vector3.new(0, 3 * state.def.scale.height - 0.2, 0)
	local ring = Instance.new("Part")
	ring.Name = "SlamWarning"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 40, 30)
	ring.Transparency = 0.5
	ring.Size = Vector3.new(0.2, 2, 2)
	ring.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(slam.windup), { Size = Vector3.new(0.2, slam.radius * 2, slam.radius * 2) }):Play()
	playSound(state.root, Config.Sounds.ZombieGroan, 0.2, 1)
	task.delay(slam.windup, function()
		ring:Destroy()
		state.attacking = false
		if state.dead then
			return
		end
		for _, c in ipairs(playerCharacters()) do
			if (c.root.Position - state.root.Position).Magnitude <= slam.radius then
				Services.Player.damage(c.player, slam.damage, "Warden")
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			Net.fire("Shake", p, 0.9, 0.6)
		end
	end)
	state.lastSlam = os.clock()
end

local function attack(state, targetChar)
	state.attacking = true
	state.lastAttack = os.clock()
	local root = state.root
	local look = Vector3.new(targetChar.root.Position.X, root.Position.Y, targetChar.root.Position.Z)
	if (look - root.Position).Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(root.Position, look)
	end
	playSound(root, Config.Sounds.ZombieGroan, state.def.groanPitch * 1.2, 0.5)
	task.delay(0.35, function()
		state.attacking = false
		if state.dead or not targetChar.root.Parent then
			return
		end
		local dist = (targetChar.root.Position - root.Position).Magnitude
		if dist <= state.def.attack.reach + 2 then
			local hit = Services.Player.damage(targetChar.player, state.def.attack.damage, state.def.displayName)
			if hit and state.def.attack.slow then
				Services.Player.slow(targetChar.player, state.def.attack.slow)
			end
		end
	end)
end

local function findTarget(state, chars)
	local root = state.root
	local def = state.def
	local eye = root.Position + Vector3.new(0, 2 * def.scale.height, 0)
	local best, bestScore = nil, math.huge
	for _, c in ipairs(chars) do
		local dist = (c.root.Position - root.Position).Magnitude
		local sprinting = c.character:GetAttribute("Sprinting")
		local lightOn = c.character:GetAttribute("LightOn")
		local detected = false
		if dist <= def.hear * 0.35 then
			detected = true -- too close to miss
		elseif sprinting and dist <= def.hear then
			detected = true -- heard running footsteps
		elseif dist <= def.sight * (lightOn and 1.3 or 1) then
			detected = hasLineOfSight(eye, c.root.Position, { folder, c.character })
		end
		if detected and dist < bestScore then
			best, bestScore = c, dist
		end
	end
	return best
end

local function updateZombie(state, chars, byPlayer, now)
	local def = state.def
	local root = state.root
	local humanoid = state.humanoid
	if state.attacking then
		return
	end

	-- keep or drop current target
	local targetChar = state.target and byPlayer[state.target]
	if targetChar then
		local dist = (targetChar.root.Position - root.Position).Magnitude
		if dist > def.sight * 1.7 or now - state.lastSeen > 8 then
			targetChar = nil
			state.target = nil
		elseif dist < def.sight then
			state.lastSeen = now
		end
	end
	if not targetChar then
		local found = findTarget(state, chars)
		if found then
			targetChar = found
			state.target = found.player
			state.lastSeen = now
			playSound(root, Config.Sounds.ZombieGroan, def.groanPitch, 0.7)
		end
	end

	if now > state.nextGroan then
		state.nextGroan = now + math.random(8, 16)
		playSound(root, Config.Sounds.ZombieGroan, def.groanPitch * (0.9 + math.random() * 0.2), 0.35)
	end

	if not targetChar then
		-- wander around home
		humanoid.WalkSpeed = def.walkSpeed
		if now > state.nextWander then
			state.nextWander = now + math.random(5, 10)
			if not state.region or math.random() < 0.7 then
				local angle = math.random() * math.pi * 2
				local goal = state.home + Vector3.new(math.cos(angle), 0, math.sin(angle)) * math.random(3, 10)
				humanoid:MoveTo(goal)
				setAnim(state, "walk")
			end
		end
		if humanoid.MoveDirection.Magnitude < 0.1 and root.AssemblyLinearVelocity.Magnitude < 1 then
			setAnim(state, "idle")
		end
		return
	end

	-- chase
	humanoid.WalkSpeed = def.chaseSpeed
	setAnim(state, def.chaseSpeed >= 14 and "run" or "walk")
	local targetPos = targetChar.root.Position
	local dist = (targetPos - root.Position).Magnitude

	if def.slam and now - state.lastSlam > def.slam.cooldown and dist < def.slam.radius * 0.75 then
		bossSlam(state, chars)
		return
	end
	if def.boss and now - state.lastSummon > 22 and countAlive() < ambientCap() then
		state.lastSummon = now
		for i = 1, 2 do
			local point = findSpawnPoint(Vector3.new(root.Position.X, 0, root.Position.Z), 20)
			if point then
				ZombieService.spawn(i == 1 and "Normal" or "Fast", point, { aggro = true })
			end
		end
	end

	local reach = def.attack.reach + 1.2 * def.scale.width
	if dist <= reach and now - state.lastAttack >= def.attack.cooldown then
		attack(state, targetChar)
		return
	end

	local heightDiff = math.abs(targetPos.Y - root.Position.Y)
	local eye = root.Position + Vector3.new(0, 1.5, 0)
	local direct = heightDiff < 5 and hasLineOfSight(eye, targetPos, { folder, targetChar.character })
	if direct then
		state.path = nil
		humanoid:MoveTo(targetPos)
	else
		requestPath(state, targetPos)
		local waypoints = state.path
		if waypoints and waypoints[state.pathIndex] then
			local wp = waypoints[state.pathIndex]
			if (wp.Position - root.Position).Magnitude < 4 then
				state.pathIndex = state.pathIndex + 1
				wp = waypoints[state.pathIndex]
			end
			if wp then
				if wp.Action == Enum.PathWaypointAction.Jump then
					humanoid.Jump = true
				end
				humanoid:MoveTo(wp.Position)
			end
		else
			humanoid:MoveTo(targetPos)
		end
	end

	-- stuck detection
	if now - state.lastMoveCheck > 2 then
		if (root.Position - state.lastPos).Magnitude < 1.5 then
			humanoid.Jump = true
			state.lastPath = 0
		end
		state.lastPos = root.Position
		state.lastMoveCheck = now
	end
end

local function aiLoop()
	while true do
		task.wait(ZC.TickRate)
		if enabled then
			local chars = playerCharacters()
			local byPlayer = {}
			for _, c in ipairs(chars) do
				byPlayer[c.player] = c
			end
			local now = os.clock()
			for model, state in pairs(zombies) do
				if not state.dead and model.Parent then
					-- despawn far ambient zombies
					local nearest = math.huge
					for _, c in ipairs(chars) do
						nearest = math.min(nearest, (c.root.Position - state.root.Position).Magnitude)
					end
					if state.ambient and #chars > 0 and nearest > ZC.DespawnDistance then
						state.dead = true
						zombies[model] = nil
						model:Destroy()
					elseif state.root.Position.Y < -50 then
						state.humanoid.Health = 0
					else
						local ok, err = pcall(updateZombie, state, chars, byPlayer, now)
						if not ok then
							warn("[ZombieService] AI error: " .. tostring(err))
						end
					end
				end
			end
			trySpawnAmbient(chars)
		end
	end
end

function ZombieService.init(services)
	Services = services
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Zombies")
	end)
	PhysicsService:CollisionGroupSetCollidable("Zombies", "Zombies", false)
end

function ZombieService.start(worldRefs)
	folder = worldRefs.zombieFolder
	local storage = Instance.new("Folder")
	storage.Name = "ZombieTemplates"
	storage.Parent = game:GetService("ServerStorage")
	for typeName in pairs(ZombieTypes) do
		local t = buildTemplate(typeName)
		t.Parent = storage
		templates[typeName] = t
	end
	task.spawn(aiLoop)
end

return ZombieService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000027"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Builder</string><ProtectedString name="Source"><![CDATA[--[[
	Builder
	Low-level helpers to build optimized, anchored geometry from code.
	All parts are anchored, use smooth surfaces and avoid unnecessary
	collision/touch/shadow work so mobile devices stay fast.
]]

local CollectionService = game:GetService("CollectionService")

local Builder = {}

local DEFAULT_PROPS = {
	Anchored = true,
	TopSurface = Enum.SurfaceType.Smooth,
	BottomSurface = Enum.SurfaceType.Smooth,
	CanTouch = false,
}

function Builder.part(props, parent)
	local className = props.ClassName or "Part"
	local p = Instance.new(className)
	for k, v in pairs(DEFAULT_PROPS) do
		p[k] = v
	end
	for k, v in pairs(props) do
		if k ~= "ClassName" and k ~= "Tags" then
			p[k] = v
		end
	end
	if props.Tags then
		for _, tag in ipairs(props.Tags) do
			CollectionService:AddTag(p, tag)
		end
	end
	p.Parent = parent
	return p
end

-- Box defined by min/max corners (axis aligned).
function Builder.box(minV, maxV, material, color, parent, extra)
	local size = maxV - minV
	local props = {
		Size = Vector3.new(math.abs(size.X), math.abs(size.Y), math.abs(size.Z)),
		CFrame = CFrame.new((minV + maxV) / 2),
		Material = material,
		Color = color,
	}
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return Builder.part(props, parent)
end

function Builder.model(name, parent)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Builder.folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

--[[
	Axis-aligned wall with optional openings.
	axis "x": wall runs along X at constant z = 'at', from a to b.
	axis "z": wall runs along Z at constant x = 'at', from a to b.
	openings: { { center = number, width = number, height = number, sill = number? } }
	  sill > 0 makes a window (wall below and above the opening).
	window glass is added when opening.glass = true.
]]
function Builder.wall(axis, at, a, b, opts, parent)
	local height = opts.height or 14
	local thick = opts.thickness or 1
	local base = opts.base or 0
	local material = opts.material or Enum.Material.Concrete
	local color = opts.color or Color3.fromRGB(200, 200, 200)
	local openings = opts.openings or {}
	table.sort(openings, function(o1, o2)
		return o1.center < o2.center
	end)

	local lo, hi = math.min(a, b), math.max(a, b)

	local function seg(s0, s1, y0, y1)
		if s1 - s0 < 0.05 or y1 - y0 < 0.05 then
			return
		end
		local minV, maxV
		if axis == "x" then
			minV = Vector3.new(s0, base + y0, at - thick / 2)
			maxV = Vector3.new(s1, base + y1, at + thick / 2)
		else
			minV = Vector3.new(at - thick / 2, base + y0, s0)
			maxV = Vector3.new(at + thick / 2, base + y1, s1)
		end
		Builder.box(minV, maxV, material, color, parent)
	end

	local cursor = lo
	for _, o in ipairs(openings) do
		local o0 = o.center - o.width / 2
		local o1 = o.center + o.width / 2
		seg(cursor, o0, 0, height)
		local sill = o.sill or 0
		local top = sill + (o.height or 8)
		if sill > 0 then
			seg(o0, o1, 0, sill)
		end
		seg(o0, o1, top, height)
		if o.glass then
			local gMin, gMax
			if axis == "x" then
				gMin = Vector3.new(o0, base + sill, at - 0.1)
				gMax = Vector3.new(o1, base + top, at + 0.1)
			else
				gMin = Vector3.new(at - 0.1, base + sill, o0)
				gMax = Vector3.new(at + 0.1, base + top, o1)
			end
			-- Broken windows keep an invisible collider so players cannot
			-- climb out and skip story areas; boards make that readable.
			Builder.box(gMin, gMax, Enum.Material.Glass, Color3.fromRGB(120, 150, 160), parent, {
				Transparency = o.broken and 1 or 0.6,
				CanCollide = true,
				CastShadow = false,
			})
			if o.broken then
				local center = (gMin + gMax) / 2
				local span = o.width * 1.05
				local rot = axis == "x" and CFrame.new() or CFrame.Angles(0, math.rad(90), 0)
				for i, ang in ipairs({ 18, -14, 4 }) do
					Builder.part({
						Name = "Board",
						Size = Vector3.new(span, 0.7, 0.25),
						CFrame = CFrame.new(center + Vector3.new(0, (i - 2) * 1.4, 0)) * rot * CFrame.Angles(0, 0, math.rad(ang)) * CFrame.new(0, 0, -0.3),
						Material = Enum.Material.WoodPlanks,
						Color = Color3.fromRGB(110, 85, 55),
						CanCollide = false,
					}, parent)
				end
			end
		end
		cursor = o1
	end
	seg(cursor, hi, 0, height)
end

-- Ceiling lamp (neon panel + light). Flickering lamps are animated on the client.
function Builder.lamp(position, opts, parent)
	opts = opts or {}
	local lamp = Builder.part({
		Name = "Lamp",
		Size = opts.size or Vector3.new(4, 0.3, 1.2),
		CFrame = CFrame.new(position),
		Material = Enum.Material.Neon,
		Color = opts.color or Color3.fromRGB(220, 235, 255),
		CanCollide = false,
		CastShadow = false,
		Tags = opts.flicker and { "FlickerLight" } or nil,
	}, parent)
	local light = Instance.new("PointLight")
	light.Range = opts.range or 22
	light.Brightness = opts.brightness or 1.2
	light.Color = opts.color or Color3.fromRGB(220, 235, 255)
	light.Shadows = opts.shadows == true
	light.Parent = lamp
	return lamp
end

-- Simple floating label used for room signs.
function Builder.sign(text, cf, size, parent, color)
	local board = Builder.part({
		Name = "Sign",
		Size = size or Vector3.new(6, 1.4, 0.2),
		CFrame = cf,
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(30, 40, 45),
		CanCollide = false,
	}, parent)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.4
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = color or Color3.fromRGB(200, 230, 220)
	label.Parent = gui
	return board
end

-- Makes a part shine softly so players can spot interactables.
function Builder.glint(part, color)
	local att = Instance.new("Attachment")
	att.Parent = part
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Glint"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Rate = 2
	pe.Lifetime = NumberRange.new(0.6, 1)
	pe.Speed = NumberRange.new(0.2)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
	pe.Color = ColorSequence.new(color or Color3.fromRGB(255, 240, 180))
	pe.LightEmission = 1
	pe.Parent = att
	CollectionService:AddTag(pe, "OptionalParticle")
	return pe
end

return Builder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">City</string><ProtectedString name="Source"><![CDATA[--[[
	City - the destroyed streets of Ashford Bay around the hospital:
	hospital plaza, Harbor Avenue, Kessler Street, pharmacy, Police
	Precinct 9, collapsed offices, an alley and the Line 4 subway plaza.
]]

local Layout = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Layout"))
local Builder = require(script.Parent:WaitForChild("Builder"))
local Props = require(script.Parent:WaitForChild("Props"))
local Doors = require(script.Parent:WaitForChild("Doors"))

local M = Enum.Material
local rgb = Color3.fromRGB
local V = Vector3.new

local City = {}

local ASPHALT = rgb(42, 42, 46)
local SIDEWALK = rgb(110, 108, 104)

-- Solid ruined block with dark windows on the given faces. Cheap: 1 body part + window strips.
local function ruinedBlock(minX, minZ, maxX, maxZ, height, color, parent, rng)
	local m = Builder.model("Ruin", parent)
	Builder.box(V(minX, 0, minZ), V(maxX, height, maxZ), M.Concrete, color, m)
	-- broken roofline chunks
	for _ = 1, 3 do
		local w = rng:NextNumber(4, 10)
		local x = rng:NextNumber(minX + w / 2, math.max(minX + w / 2, maxX - w / 2))
		local z = rng:NextNumber(minZ + 2, math.max(minZ + 2, maxZ - 2))
		local h = rng:NextNumber(2, 6)
		Builder.part({
			Size = V(w, h, rng:NextNumber(3, 8)),
			CFrame = CFrame.new(x, height + h / 2 - 0.5, z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3)),
			Material = M.Concrete,
			Color = color:Lerp(rgb(40, 40, 40), 0.3),
		}, m)
	end
	-- window rows on all four faces (dark glass, a few lit for life)
	local floors = math.floor(height / 8)
	for f = 0, floors - 1 do
		local y = 4 + f * 8
		local function strip(cf, len)
			local lit = rng:NextNumber() < 0.08
			Builder.part({
				Size = V(len, 2.6, 0.2),
				CFrame = cf,
				Material = lit and M.Neon or M.Glass,
				Color = lit and rgb(255, 190, 110) or rgb(20, 24, 28),
				CanCollide = false,
				CastShadow = false,
			}, m)
		end
		strip(CFrame.new((minX + maxX) / 2, y, minZ - 0.1), (maxX - minX) - 4)
		strip(CFrame.new((minX + maxX) / 2, y, maxZ + 0.1), (maxX - minX) - 4)
		strip(CFrame.new(minX - 0.1, y, (minZ + maxZ) / 2) * CFrame.Angles(0, math.rad(90), 0), (maxZ - minZ) - 4)
		strip(CFrame.new(maxX + 0.1, y, (minZ + maxZ) / 2) * CFrame.Angles(0, math.rad(90), 0), (maxZ - minZ) - 4)
	end
	return m
end

-- Enterable building shell with walls, roof and given doorway openings.
local function shell(name, minX, minZ, maxX, maxZ, height, color, openings, parent)
	local m = Builder.model(name, parent)
	local opts = { height = height, thickness = 1, material = M.Brick, color = color }
	opts.openings = openings.south or {}
	Builder.wall("x", minZ, minX, maxX, opts, m)
	opts.openings = openings.north or {}
	Builder.wall("x", maxZ, minX, maxX, opts, m)
	opts.openings = openings.west or {}
	Builder.wall("z", minX, minZ, maxZ, opts, m)
	opts.openings = openings.east or {}
	Builder.wall("z", maxX, minZ, maxZ, opts, m)
	Builder.box(V(minX, 0, minZ), V(maxX, 0.2, maxZ), M.WoodPlanks, rgb(90, 75, 60), m)
	Builder.box(V(minX - 0.5, height, minZ - 0.5), V(maxX + 0.5, height + 1, maxZ + 0.5), M.Concrete, color:Lerp(rgb(30, 30, 30), 0.4), m)
	return m
end

function City.build(parent)
	local root = Builder.model("City", parent)
	local ground = Builder.folder("Ground", root)
	local buildings = Builder.folder("Buildings", root)
	local props = Builder.folder("Props", root)
	local rng = Random.new(1337)
	local B = Layout.WorldBounds

	-- Ground -----------------------------------------------------------------------
	Builder.box(V(B.minX - 30, -4, B.minZ - 30), V(B.maxX + 30, 0, B.maxZ + 30), M.Concrete, SIDEWALK, ground)
	Builder.box(V(0, 0, 80), V(120, 0.1, 100), M.Pavement, rgb(125, 122, 118), ground) -- plaza
	Builder.box(V(-60, 0, 100), V(220, 0.12, 124), M.Asphalt, ASPHALT, ground) -- Harbor Ave
	Builder.box(V(90, 0, 124), V(110, 0.12, 244), M.Asphalt, ASPHALT, ground) -- Kessler St
	Builder.box(V(60, 0, 240), V(150, 0.1, 304), M.Pavement, rgb(105, 100, 95), ground) -- subway plaza
	-- lane markings
	for x = -55, 215, 12 do
		Builder.box(V(x, 0.12, 111.7), V(x + 5, 0.16, 112.3), M.SmoothPlastic, rgb(200, 180, 90), ground, { CanCollide = false })
	end
	for z = 128, 236, 12 do
		Builder.box(V(99.7, 0.12, z), V(100.3, 0.16, z + 5), M.SmoothPlastic, rgb(200, 180, 90), ground, { CanCollide = false })
	end
	-- cracks / patches
	for _ = 1, 26 do
		local x = rng:NextNumber(-55, 215)
		local z = rng:NextNumber(101, 123)
		Builder.part({
			Size = V(rng:NextNumber(3, 9), 0.05, rng:NextNumber(0.4, 1.2)),
			CFrame = CFrame.new(x, 0.15, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
			Material = M.Slate,
			Color = rgb(28, 28, 30),
			CanCollide = false,
		}, ground)
	end

	-- Invisible world boundary -----------------------------------------------------------
	local function boundary(minV, maxV)
		Builder.box(minV, maxV, M.SmoothPlastic, rgb(0, 0, 0), ground, { Transparency = 1, CastShadow = false, Name = "Boundary" })
	end
	boundary(V(B.minX - 2, 0, B.minZ), V(B.minX, 80, B.maxZ))
	boundary(V(B.maxX, 0, B.minZ), V(B.maxX + 2, 80, B.maxZ))
	boundary(V(B.minX, 0, B.minZ - 2), V(B.maxX, 80, B.minZ))
	boundary(V(B.minX, 0, B.maxZ), V(B.maxX, 80, B.maxZ + 2))

	-- Ruined city blocks (frame the playable streets) --------------------------------------
	local blocks = {
		{ -60, 0, -5, 95, 42 },
		{ 125, 0, 225, 95, 50 },
		{ -60, 130, -12, 180, 38 },
		{ -60, 190, 2, 240, 46 },
		{ 22, 192, 85, 236, 34 },
		{ 170, 130, 225, 185, 40 },
		{ 205, 190, 225, 240, 30 },
		{ -60, 250, 55, 304, 52 },
		{ 155, 250, 225, 304, 44 },
		{ 0, -10, 120, -2, 20 },
	}
	for i, b in ipairs(blocks) do
		local shade = 95 + (i * 13) % 40
		ruinedBlock(b[1], b[2], b[3], b[4], b[5], rgb(shade, shade - 6, shade - 12), buildings, rng)
	end

	-- Hospital plaza -------------------------------------------------------------------------
	for _, x in ipairs({ 20, 40, 90, 110 }) do
		Builder.box(V(x - 4, 0, 86), V(x + 4, 1.4, 94), M.Brick, rgb(100, 70, 60), props) -- planters
		Props.deadTree(CFrame.new(x, 1.4, 90), props, rng)
	end
	Props.policeBarrier(CFrame.new(54, 0.1, 97), props)
	Props.policeBarrier(CFrame.new(78, 0.1, 97) * CFrame.Angles(0, math.rad(15), 0), props)
	Props.barrel(CFrame.new(66, 0.1, 94), props, true)
	Props.bench(CFrame.new(30, 0.1, 82) * CFrame.Angles(0, math.pi, 0), props)

	-- Harbor Avenue ---------------------------------------------------------------------------
	Props.ambulance(CFrame.new(Layout.Points.Ambulance) * CFrame.Angles(0, math.rad(80), 0), props)
	local cars = {
		{ -30, 108, 20, rgb(40, 60, 120) }, { 0, 117, -70, rgb(150, 150, 150) }, { 35, 106, 95, rgb(120, 30, 30) },
		{ 128, 118, 10, rgb(30, 90, 60) }, { 160, 107, 75, rgb(200, 180, 60) }, { 196, 116, 110, rgb(60, 60, 70) },
		{ 96, 140, 5, rgb(110, 40, 40) }, { 104, 175, -8, rgb(170, 170, 175) }, { 95, 205, 20, rgb(40, 40, 45) },
		{ 75, 258, 60, rgb(90, 100, 120) }, { 135, 262, -30, rgb(120, 100, 70) },
	}
	for _, c in ipairs(cars) do
		Props.car(CFrame.new(c[1], 0.12, c[2]) * CFrame.Angles(0, math.rad(c[3]), 0), props, c[4], true)
	end
	Props.barricade(CFrame.new(-50, 0.1, 112) * CFrame.Angles(0, math.rad(90), 0), props)
	Props.barricade(CFrame.new(214, 0.1, 112) * CFrame.Angles(0, math.rad(90), 0), props)
	for _, pos in ipairs({ V(-20, 0, 120), V(55, 0, 121), V(140, 0, 102), V(185, 0, 121), V(112, 0, 160), V(88, 0, 196), V(112, 0, 228) }) do
		Props.debris(CFrame.new(pos), props, rng, 5)
	end
	for _, pos in ipairs({ V(10, 0, 126), V(150, 0, 126), V(88, 0, 170), V(112, 0, 190) }) do
		Props.trashBags(CFrame.new(pos), props, rng)
	end
	Props.barrel(CFrame.new(-8, 0.1, 104), props, true)
	Props.barrel(CFrame.new(150, 0.1, 121), props, true)
	Props.barrel(CFrame.new(112, 0.1, 214), props, true)
	Props.trafficLight(CFrame.new(88, 0.1, 126), props)
	Props.trafficLight(CFrame.new(112, 0.1, 98) * CFrame.Angles(0, math.pi, 0), props)

	-- Street lamps
	local lampModes = { "on", "off", "flicker", "on", "off", "on", "flicker", "off" }
	local li = 0
	for x = -45, 205, 30 do
		li = li + 1
		Props.streetLamp(CFrame.new(x, 0, 99) * CFrame.Angles(0, math.pi, 0), props, lampModes[(li % #lampModes) + 1])
		Props.streetLamp(CFrame.new(x + 15, 0, 125), props, lampModes[((li + 3) % #lampModes) + 1])
	end
	for z = 140, 230, 30 do
		li = li + 1
		Props.streetLamp(CFrame.new(88, 0, z) * CFrame.Angles(0, math.rad(-90), 0), props, lampModes[(li % #lampModes) + 1])
		Props.streetLamp(CFrame.new(112, 0, z + 15) * CFrame.Angles(0, math.rad(90), 0), props, lampModes[((li + 2) % #lampModes) + 1])
	end

	-- Pharmacy (Maya's hideout) -------------------------------------------------------------------
	local pharm = shell("Pharmacy", 130, 135, 165, 170, 16, rgb(120, 140, 120), {
		west = { { center = 152, width = 6, height = 9 }, { center = 142, width = 6, height = 4, sill = 3, glass = true, broken = true } },
	}, buildings)
	Builder.sign("PHARMACY +", CFrame.new(129.3, 12, 152) * CFrame.Angles(0, math.rad(90), 0), V(12, 2, 0.3), pharm, rgb(120, 255, 140))
	for i = 0, 2 do
		Props.shelf(CFrame.new(140 + i * 8, 0.2, 166), pharm, rgb(200, 200, 200))
	end
	Props.counter(CFrame.new(158, 0.2, 145), 10, pharm)
	Props.crate(CFrame.new(134, 0.2, 160), pharm)
	Builder.lamp(V(148, 15.6, 152), { range = 24, brightness = 0.9, color = rgb(255, 230, 190) }, pharm)
	-- rooftop flare
	local flare = Builder.part({
		Name = "Flare",
		Size = V(0.5, 1.2, 0.5),
		CFrame = CFrame.new(150, 17.6, 150),
		Material = M.Neon,
		Color = rgb(255, 50, 40),
		CanCollide = false,
	}, pharm)
	local flareLight = Instance.new("PointLight")
	flareLight.Color = rgb(255, 60, 40)
	flareLight.Range = 40
	flareLight.Brightness = 3
	flareLight.Parent = flare
	local smoke = Instance.new("Smoke")
	smoke.Color = rgb(255, 90, 80)
	smoke.Opacity = 0.25
	smoke.RiseVelocity = 8
	smoke.Size = 3
	smoke.Parent = flare

	-- Police Precinct 9 ----------------------------------------------------------------------------
	local police = shell("Precinct9", 20, 140, 70, 185, 16, rgb(70, 80, 105), {
		east = { { center = 162, width = 8, height = 10 }, { center = 148, width = 8, height = 4, sill = 4, glass = true } },
		north = { { center = 45, width = 8, height = 4, sill = 5, glass = true } },
	}, buildings)
	Builder.sign("POLICE - PRECINCT 9", CFrame.new(70.7, 12.5, 162) * CFrame.Angles(0, math.rad(-90), 0), V(16, 2, 0.3), police, rgb(150, 190, 255))
	Builder.wall("x", 165, 20, 70, { height = 16, thickness = 1, material = M.Brick, color = rgb(80, 85, 95), openings = { { center = 45, width = 6, height = 9 } } }, police)
	Doors.create("armory", CFrame.new(45, 0.2, 165), 6, 9, { color = rgb(60, 60, 65), label = "ARMORY", labelSide = -1, labelColor = rgb(255, 200, 80) }, police)
	Props.desk(CFrame.new(36, 0.2, 146), police)
	Props.desk(CFrame.new(58, 0.2, 146), police)
	Props.chair(CFrame.new(36, 0.2, 150) * CFrame.Angles(0, math.pi, 0), police, true)
	Props.cabinet(CFrame.new(24, 0.2, 162), police)
	Props.cabinet(CFrame.new(66, 0.2, 143), police)
	Props.desk(CFrame.new(45, 0.2, 180), police, rgb(70, 70, 75))
	Props.desk(CFrame.new(30, 0.2, 180), police, rgb(70, 70, 75))
	for i = 0, 3 do
		Props.cabinet(CFrame.new(56 + i * 3.2, 0.2, 182), police, 7)
	end
	Props.crate(CFrame.new(24, 0.2, 170), police)
	Builder.lamp(V(45, 15.6, 152), { range = 26, brightness = 0.7, flicker = true }, police)
	Builder.lamp(V(45, 15.6, 176), { range = 18, brightness = 0.5, color = rgb(255, 80, 60) }, police)
	-- breaker panel (west wall, faces east)
	local panel = Builder.part({
		Name = "BreakerPanel",
		Size = V(0.4, 4, 6),
		CFrame = CFrame.new(Layout.Points.BreakerPanel),
		Material = M.DiamondPlate,
		Color = rgb(110, 115, 120),
	}, police)
	local levers = {}
	for i = 1, 3 do
		local lever = Builder.part({
			Name = "Breaker" .. i,
			Size = V(0.6, 1.2, 0.5),
			CFrame = CFrame.new(Layout.Points.BreakerPanel + V(0.45, -0.6, (i - 2) * 1.8)),
			Material = M.SmoothPlastic,
			Color = rgb(200, 40, 40),
		}, police)
		Builder.sign(tostring(i), CFrame.new(Layout.Points.BreakerPanel + V(0.25, 1.2, (i - 2) * 1.8)) * CFrame.Angles(0, math.rad(-90), 0), V(0.8, 0.8, 0.1), police)
		levers[i] = lever
	end

	-- Alley (research file 3) ------------------------------------------------------------------------
	Props.dumpster(CFrame.new(8, 0, 214) * CFrame.Angles(0, math.rad(90), 0), props)
	Props.trashBags(CFrame.new(16, 0, 220), props, rng)
	Props.crate(CFrame.new(14, 0, 226), props, 1)
	Builder.lamp(V(12, 9, 230), { range = 14, brightness = 0.6, flicker = true, color = rgb(255, 200, 140) }, props)

	-- Collapsed offices (optional Fire Axe) ------------------------------------------------------------
	local ruins = shell("CollapsedOffices", 130, 190, 200, 235, 14, rgb(130, 115, 100), {
		west = { { center = 212, width = 10, height = 10 } },
		south = { { center = 150, width = 6, height = 8 }, { center = 180, width = 12, height = 6, sill = 3 } },
	}, buildings)
	Props.desk(CFrame.new(185, 0.2, 228), ruins)
	Props.desk(CFrame.new(150, 0.2, 220), ruins)
	Props.cabinet(CFrame.new(195, 0.2, 200), ruins)
	Props.debris(CFrame.new(165, 0.2, 210), ruins, rng, 8)
	Props.debris(CFrame.new(140, 0.2, 228), ruins, rng, 6)
	Props.chair(CFrame.new(185, 0.2, 224), ruins, true)
	Builder.lamp(V(185, 13.6, 226), { range = 14, brightness = 0.5, flicker = true }, ruins)

	-- Newsstand (research file 4)
	Props.kiosk(CFrame.new(126, 0, 210) * CFrame.Angles(0, math.rad(90), 0), props)
	Props.crate(CFrame.new(120, 0, 210), props, 3)
	-- medical bag behind the ambulance (research file 2)
	Props.crate(CFrame.new(84, 0.12, 113.6), props, 1)

	-- Subway plaza ---------------------------------------------------------------------------------------
	local subway = Builder.model("Line4Subway", buildings)
	Builder.wall("x", 300, 70, 130, { height = 16, thickness = 2, material = M.Concrete, color = rgb(85, 80, 75), openings = { { center = 100, width = 16, height = 10 } } }, subway)
	Builder.box(V(70, 16, 296), V(130, 18, 304), M.Concrete, rgb(70, 66, 62), subway)
	Builder.sign("LINE 4  -  ASHFORD CENTRAL", CFrame.new(100, 12.5, 298.8), V(22, 2, 0.3), subway, rgb(255, 210, 90))
	Doors.create("subway_gate", CFrame.new(100, 0.1, 300), 16, 10, { style = "shutter", color = rgb(110, 105, 95), material = M.CorrodedMetal, thickness = 0.8 }, subway)
	-- tunnel interior behind the gate (descending stairs into darkness)
	Builder.box(V(90, 0, 301), V(110, 0.2, 312), M.Concrete, rgb(60, 60, 60), subway)
	for i = 0, 4 do
		Builder.box(V(92, -0.6 - i * 0.6, 304 + i * 1.6), V(108, 0.1 - i * 0.6, 305.6 + i * 1.6), M.Concrete, rgb(80, 80, 80), subway)
	end
	Builder.box(V(90, 0, 301), V(91, 12, 312), M.Concrete, rgb(60, 60, 60), subway)
	Builder.box(V(109, 0, 301), V(110, 12, 312), M.Concrete, rgb(60, 60, 60), subway)
	Builder.box(V(90, 10, 301), V(110, 12, 312), M.Concrete, rgb(50, 50, 50), subway)
	Builder.lamp(V(100, 9.6, 306), { range = 16, brightness = 0.6, color = rgb(255, 200, 120), flicker = true }, subway)
	-- generator
	local generator = Builder.model("Generator", subway)
	Builder.box(V(124, 0.1, 278), V(132, 5, 286), M.DiamondPlate, rgb(170, 140, 40), generator)
	Builder.box(V(125, 5, 279), V(131, 6.5, 285), M.Metal, rgb(60, 60, 60), generator)
	local genLight = Builder.part({
		Name = "GeneratorLight",
		Size = V(0.3, 1, 3),
		CFrame = CFrame.new(123.8, 3.5, 282),
		Material = M.Neon,
		Color = rgb(255, 40, 40),
		CanCollide = false,
	}, generator)
	-- ticket booth (research file 5)
	local booth = Builder.model("TicketBooth", subway)
	Builder.box(V(76, 0.1, 283), V(84, 0.6, 291), M.Concrete, rgb(90, 90, 90), booth)
	Builder.box(V(76, 0.6, 290.5), V(84, 9, 291), M.Metal, rgb(60, 70, 80), booth)
	Builder.box(V(76, 0.6, 283), V(76.5, 9, 291), M.Metal, rgb(60, 70, 80), booth)
	Builder.box(V(83.5, 0.6, 283), V(84, 9, 291), M.Metal, rgb(60, 70, 80), booth)
	Builder.box(V(76, 9, 283), V(84, 9.6, 291), M.Metal, rgb(50, 55, 60), booth)
	Props.desk(CFrame.new(80, 0.3, 287), booth, rgb(80, 80, 85))
	Builder.sign("TICKETS", CFrame.new(80, 8.3, 282.8), V(5, 1, 0.2), booth, rgb(255, 220, 120))
	-- arena cover
	for _, pos in ipairs({ V(80, 0, 262), V(120, 0, 262), V(90, 0, 280), V(112, 0, 278), V(70, 0, 275), V(135, 0, 250) }) do
		Builder.box(pos - V(3, 0, 0.8), pos + V(3, 3, 0.8), M.Concrete, rgb(150, 145, 140), props)
	end
	Props.barrel(CFrame.new(70, 0.1, 290), props, true)
	Props.barrel(CFrame.new(140, 0.1, 270), props, true)
	Props.streetLamp(CFrame.new(64, 0, 250) * CFrame.Angles(0, math.rad(-90), 0), props, "flicker")
	Props.streetLamp(CFrame.new(146, 0, 290) * CFrame.Angles(0, math.rad(90), 0), props, "on")

	return {
		root = root,
		breakerLevers = levers,
		breakerPanel = panel,
		generatorLight = genLight,
		flare = flare,
	}
end

return City
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Doors</string><ProtectedString name="Source"><![CDATA[--[[
	Doors
	Server-owned doors with a registry so missions can open/close/reset them.
	style:
	  "slide"  - one panel slides sideways
	  "double" - two panels slide apart
	  "shutter"- panel rises into the ceiling (subway gate)
	cf: CFrame at the bottom-centre of the opening; local X runs along the wall.
]]

local TweenService = game:GetService("TweenService")

local Builder = require(script.Parent:WaitForChild("Builder"))

local Doors = {}
local registry = {}

local Door = {}
Door.__index = Door

local TWEEN = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

function Doors.create(id, cf, width, height, opts, parent)
	opts = opts or {}
	local style = opts.style or "slide"
	local model = Builder.model("Door_" .. id, parent)
	local color = opts.color or Color3.fromRGB(150, 160, 165)
	local material = opts.material or Enum.Material.Metal
	local thick = opts.thickness or 0.6

	local self = setmetatable({
		id = id,
		model = model,
		isOpen = false,
		panels = {},
	}, Door)

	local function makePanel(localOffset, w, openOffset)
		local closedCF = cf * CFrame.new(localOffset.X, height / 2, 0)
		local part = Builder.part({
			Name = "Panel",
			Size = Vector3.new(w, height, thick),
			CFrame = closedCF,
			Material = material,
			Color = color,
		}, model)
		-- window strip for readability
		if opts.window then
			local glass = Builder.part({
				Name = "Window",
				Size = Vector3.new(math.max(0.5, w * 0.4), height * 0.25, thick + 0.05),
				CFrame = closedCF * CFrame.new(0, height * 0.18, 0),
				Material = Enum.Material.Glass,
				Color = Color3.fromRGB(80, 110, 120),
				Transparency = 0.4,
				Anchored = false,
				CanCollide = false,
				Massless = true,
			}, model)
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = part
			weld.Part1 = glass
			weld.Parent = part
		end
		table.insert(self.panels, {
			part = part,
			closed = closedCF,
			open = closedCF * CFrame.new(openOffset),
		})
	end

	if style == "double" then
		makePanel(Vector3.new(-width / 4, 0, 0), width / 2, Vector3.new(-width / 2 + 0.3, 0, 0))
		makePanel(Vector3.new(width / 4, 0, 0), width / 2, Vector3.new(width / 2 - 0.3, 0, 0))
	elseif style == "shutter" then
		makePanel(Vector3.new(0, 0, 0), width, Vector3.new(0, height - 0.8, 0))
	else
		makePanel(Vector3.new(0, 0, 0), width, Vector3.new(width - 0.3, 0, 0))
	end

	if opts.label then
		-- labelSide = 1 puts the sign on the door's local +Z side, -1 on the -Z side.
		local side = opts.labelSide or 1
		local signCF = cf * CFrame.new(0, height + 0.9, side * 0.65)
		if side > 0 then
			signCF = signCF * CFrame.Angles(0, math.pi, 0)
		end
		Builder.sign(opts.label, signCF, Vector3.new(math.min(width, 8), 1.1, 0.15), model, opts.labelColor)
	end

	registry[id] = self
	return self
end

function Door:open(instant)
	if self.isOpen then
		return
	end
	self.isOpen = true
	for _, panel in ipairs(self.panels) do
		if instant then
			panel.part.CFrame = panel.open
		else
			TweenService:Create(panel.part, TWEEN, { CFrame = panel.open }):Play()
		end
	end
	if not instant then
		local snd = Instance.new("Sound")
		snd.SoundId = "rbxasset://sounds/action_jump.mp3"
		snd.PlaybackSpeed = 0.45
		snd.Volume = 0.8
		snd.RollOffMaxDistance = 80
		snd.Parent = self.panels[1].part
		snd:Play()
		game:GetService("Debris"):AddItem(snd, 3)
	end
end

function Door:close()
	if not self.isOpen then
		return
	end
	self.isOpen = false
	for _, panel in ipairs(self.panels) do
		panel.part.CFrame = panel.closed
	end
end

function Doors.get(id)
	return registry[id]
end

function Doors.all()
	return registry
end

return Doors
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Hospital</string><ProtectedString name="Source"><![CDATA[--[[
	Hospital - St. Aurelia Medical Center (Chapter 1 start).
	Single-storey hospital with ward, nurse station, storage, security
	office, janitor closet, emergency room, lobby, records room and a
	hidden room behind a sliding bookshelf.
]]

local Layout = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Layout"))
local Builder = require(script.Parent:WaitForChild("Builder"))
local Props = require(script.Parent:WaitForChild("Props"))
local Doors = require(script.Parent:WaitForChild("Doors"))

local M = Enum.Material
local rgb = Color3.fromRGB
local V = Vector3.new

local Hospital = {}

local WALL = rgb(176, 192, 186)
local WALL_DARK = rgb(120, 135, 130)
local EXTERIOR = rgb(150, 150, 145)

function Hospital.build(parent)
	local root = Builder.model("Hospital", parent)
	local structure = Builder.folder("Structure", root)
	local props = Builder.folder("Props", root)
	local lights = Builder.folder("Lights", root)
	local H = Layout.Hospital.wallHeight
	local rooms = Layout.Hospital.rooms
	local rng = Random.new(2037)

	-- Floor, ceiling, roof -------------------------------------------------
	Builder.box(V(0, 0, 0), V(120, 0.2, 80), M.Marble, rgb(196, 200, 192), structure)
	Builder.box(V(0, 0.2, 25), V(120, 0.25, 35), M.SmoothPlastic, rgb(150, 165, 160), structure) -- corridor runner
	Builder.box(V(0, H, 0), V(120, H + 1, 80), M.Concrete, rgb(170, 170, 168), structure, { CastShadow = true })
	Builder.box(V(-1, H + 1, -1), V(121, H + 2, 81), M.Concrete, rgb(90, 90, 92), structure)

	-- Exterior walls ---------------------------------------------------------
	local ext = { height = H, thickness = 1, material = M.Concrete, color = EXTERIOR }
	local function win(center, broken)
		return { center = center, width = 6, height = 5, sill = 4, glass = true, broken = broken }
	end
	ext.openings = { win(rooms.ward.doorX, true), win(rooms.nurse.doorX), win(rooms.storage.doorX), win(rooms.security.doorX), win(rooms.janitor.doorX) }
	Builder.wall("x", 0, 0, 120, ext, structure)
	ext.openings = { win(20, true), { center = 65, width = 12, height = 10 }, win(105) }
	Builder.wall("x", 80, 0, 120, ext, structure)
	ext.openings = { win(12), win(58, true) }
	Builder.wall("z", 0, 0, 80, ext, structure)
	ext.openings = { win(12), win(50) }
	Builder.wall("z", 120, 0, 80, ext, structure)

	-- Interior walls ---------------------------------------------------------
	local int = { height = H, thickness = 1, material = M.SmoothPlastic, color = WALL }
	local function door(center, width)
		return { center = center, width = width or 6, height = 9 }
	end
	int.openings = { door(rooms.ward.doorX), door(rooms.nurse.doorX), door(rooms.storage.doorX), door(rooms.security.doorX), door(rooms.janitor.doorX) }
	Builder.wall("x", 25, 0, 120, int, structure)
	int.openings = { door(rooms.er.doorX, 8), door(rooms.lobby.doorX, 16), door(rooms.records.doorX) }
	Builder.wall("x", 35, 0, 120, int, structure)
	int.openings = {}
	for _, x in ipairs({ 30, 55, 75, 100 }) do
		Builder.wall("z", x, 0, 25, int, structure)
	end
	Builder.wall("z", 40, 35, 80, int, structure)
	Builder.wall("z", 90, 35, 80, int, structure)
	-- hidden room walls
	Builder.wall("x", 65, 110, 120, { height = H, thickness = 1, material = M.SmoothPlastic, color = WALL_DARK }, structure)
	Builder.wall("z", 110, 65, 80, { height = H, thickness = 1, material = M.SmoothPlastic, color = WALL_DARK, openings = { { center = 72, width = 5, height = 8 } } }, structure)

	-- Wall trim (cheap detail): a darker band along the corridor
	Builder.box(V(0, 0.25, 25.5), V(120, 1.2, 25.7), M.SmoothPlastic, WALL_DARK, structure)
	Builder.box(V(0, 0.25, 34.3), V(120, 1.2, 34.5), M.SmoothPlastic, WALL_DARK, structure)

	-- Doors -----------------------------------------------------------------
	Doors.create("security", CFrame.new(rooms.security.doorX, 0.2, 25), 6, 9, {
		color = rgb(70, 80, 100), window = true, label = "SECURITY", labelSide = 1, labelColor = rgb(255, 120, 120),
	}, structure)
	Doors.create("lobby", CFrame.new(65, 0.2, 80), 12, 10, {
		style = "double", color = rgb(60, 70, 75), window = true,
	}, structure)
	-- Chains on the lobby doors (purely visual, removed when opened)
	local chains = Builder.part({
		Name = "LobbyChains",
		Size = V(3, 3, 0.4),
		CFrame = CFrame.new(65, 4.5, 79.4),
		Material = M.DiamondPlate,
		Color = rgb(90, 90, 90),
		CanCollide = false,
	}, structure)
	-- Secret bookshelf door
	local shelfDoor = Doors.create("secret_shelf", CFrame.new(109.6, 0.2, 72) * CFrame.Angles(0, math.rad(90), 0), 5, 8, {
		color = rgb(95, 70, 50), material = M.Wood, thickness = 1.2,
	}, structure)
	-- books on the shelf door so it looks like the other shelves
	for i = 0, 2 do
		Builder.part({
			Name = "Books",
			Size = V(0.6, 1.4, 4.4),
			CFrame = CFrame.new(108.75, 1.5 + i * 2.4, 72),
			Material = M.Cardboard,
			Color = rgb(150 - i * 20, 60 + i * 30, 50),
			Anchored = false,
			CanCollide = false,
			Massless = true,
		}, shelfDoor.model)
		local books = shelfDoor.model:FindFirstChild("Books", false)
		if books then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = shelfDoor.panels[1].part
			weld.Part1 = books
			weld.Parent = books
			books.Name = "BooksWelded"
		end
	end

	-- Lighting ---------------------------------------------------------------
	for x = 6, 114, 12 do
		Builder.lamp(V(x, H - 0.3, 30), { flicker = (x == 18 or x == 66 or x == 102), range = 20, brightness = 0.9 }, lights)
	end
	Builder.lamp(V(15, H - 0.3, 12), { flicker = true, range = 22, brightness = 0.8 }, lights) -- ward
	Builder.lamp(V(42.5, H - 0.3, 12), { range = 22, brightness = 0.9, color = rgb(255, 240, 210) }, lights)
	Builder.lamp(V(65, H - 0.3, 12), { flicker = true, range = 18, brightness = 0.6 }, lights)
	Builder.lamp(V(87.5, H - 0.3, 12), { range = 22, brightness = 1, shadows = true }, lights)
	Builder.lamp(V(20, H - 0.3, 58), { color = rgb(255, 40, 30), range = 30, brightness = 1.6, flicker = true }, lights) -- ER emergency
	Builder.lamp(V(65, H - 0.3, 58), { range = 26, brightness = 0.7, flicker = true }, lights)
	Builder.lamp(V(100, H - 0.3, 50), { range = 20, brightness = 0.5 }, lights)
	Builder.lamp(V(115, H - 0.3, 72), { color = rgb(120, 255, 200), range = 12, brightness = 0.8 }, lights) -- hidden room

	-- Ward 3B ----------------------------------------------------------------
	local bedCF = CFrame.new(Layout.Points.WardBed)
	Props.bed(bedCF, props)
	Props.bed(CFrame.new(24, 0, 10), props)
	local monitor = Props.terminal(CFrame.new(2.5, 0, 4) * CFrame.Angles(0, math.rad(-90), 0), props, "HR  --\nSUBJECT 00\n<CONNECTION LOST>")
	monitor.Name = "HeartMonitor"
	Builder.box(V(10, 0.2, 2), V(10.2, 9, 18), M.Fabric, rgb(150, 190, 200), props, { CanCollide = false, Transparency = 0.15 }) -- curtain
	Props.chair(CFrame.new(18, 0, 18), props, true)
	Props.cabinet(CFrame.new(28, 0, 3), props, 5)

	-- Nurse station ------------------------------------------------------------
	Props.counter(CFrame.new(42.5, 0.2, 6), 20, props)
	Props.chair(CFrame.new(40, 0.2, 2.5), props)
	Props.terminal(CFrame.new(48, 0.2, 5.6), props, "WARD 3B\nSTATUS: QUARANTINE")
	Props.cabinet(CFrame.new(32.5, 0.2, 22), props)
	Props.cabinet(CFrame.new(52.5, 0.2, 22), props)

	-- Storage -------------------------------------------------------------------
	Props.desk(CFrame.new(70, 0.2, 4), props, rgb(90, 90, 95))
	Props.shelf(CFrame.new(58.5, 0.2, 12) * CFrame.Angles(0, math.rad(90), 0), props, rgb(120, 125, 130))
	Props.crate(CFrame.new(60, 0.2, 20), props)
	Props.crate(CFrame.new(63, 0.2, 21), props, 2.4)
	Props.crate(CFrame.new(72, 0.2, 18), props)

	-- Security office ---------------------------------------------------------------
	Props.desk(CFrame.new(80, 0.2, 4), props, rgb(70, 75, 80))
	Props.desk(CFrame.new(96, 0.2, 6), props, rgb(70, 75, 80))
	Props.chair(CFrame.new(80, 0.2, 8) * CFrame.Angles(0, math.pi, 0), props)
	local _, cctvScreen = Props.terminal(CFrame.new(80, -0.1, 3.4) * CFrame.Angles(0, math.pi, 0), props, "CAM 07\n03:14\n[PLAYBACK READY]")
	for i = 0, 2 do
		Props.terminal(CFrame.new(78 + i * 3.5, 4, 1.2) * CFrame.Angles(0, math.pi, 0), props, "CAM 0" .. (i + 5) .. "\n[NO SIGNAL]")
	end
	Props.cabinet(CFrame.new(98, 0.2, 20), props)

	-- Janitor ---------------------------------------------------------------------
	Props.desk(CFrame.new(112, 0.2, 4), props, rgb(80, 80, 70))
	Props.barrel(CFrame.new(116, 0.2, 18), props, false)
	Props.shelf(CFrame.new(103, 0.2, 14) * CFrame.Angles(0, math.rad(-90), 0), props, rgb(110, 110, 100))

	-- Emergency room ----------------------------------------------------------------
	for i = 0, 2 do
		Props.gurney(CFrame.new(8 + i * 11, 0.2, 48) * CFrame.Angles(0, math.rad(rng:NextNumber(-20, 20)), 0), props)
		Builder.box(V(3 + i * 11, 0.2, 54), V(13 + i * 11, 9, 54.2), M.Fabric, rgb(140, 175, 185), props, { CanCollide = false, Transparency = 0.2 })
	end
	Props.desk(CFrame.new(6, 0.2, 74), props, rgb(200, 200, 195))
	Props.desk(CFrame.new(30, 0.2, 70), props, rgb(200, 200, 195))
	Props.cabinet(CFrame.new(38, 0.2, 76), props)
	Props.chair(CFrame.new(14, 0.2, 66), props, true)
	Props.debris(CFrame.new(25, 0.2, 60), props, rng, 4)

	-- Lobby -----------------------------------------------------------------------
	Props.counter(CFrame.new(52, 0.2, 60) * CFrame.Angles(0, math.rad(90), 0), 14, props)
	for i = 0, 3 do
		Props.chair(CFrame.new(70 + i * 3, 0.2, 48) * CFrame.Angles(0, math.pi, 0), props, i == 2)
		Props.chair(CFrame.new(70 + i * 3, 0.2, 66), props, i == 0)
	end
	for _, pos in ipairs({ V(48, 0.2, 42), V(82, 0.2, 42), V(48, 0.2, 74), V(82, 0.2, 74) }) do
		Builder.box(pos - V(1.2, 0, 1.2), pos + V(1.2, H - 0.2, 1.2), M.Concrete, rgb(185, 185, 180), structure)
	end
	Props.barricade(CFrame.new(56, 0.2, 76), props)
	Builder.sign("ST. AURELIA MEDICAL CENTER", CFrame.new(65, 12, 80.7) * CFrame.Angles(0, math.pi, 0), V(30, 2.2, 0.3), structure, rgb(220, 240, 235))
	Builder.sign("EXIT", CFrame.new(65, 11, 79.3), V(3, 1, 0.2), structure, rgb(80, 255, 120))
	-- keycard reader beside the lobby doors (faces into the lobby)
	local reader = Builder.part({
		Name = "KeycardReader",
		Size = V(1, 1.6, 0.3),
		CFrame = CFrame.new(Layout.Points.LobbyReader),
		Material = M.SmoothPlastic,
		Color = rgb(30, 30, 35),
	}, structure)
	Builder.part({
		Name = "ReaderLight",
		Size = V(0.6, 0.2, 0.1),
		CFrame = CFrame.new(Layout.Points.LobbyReader + V(0, 0.5, -0.2)),
		Material = M.Neon,
		Color = rgb(255, 40, 40),
		CanCollide = false,
	}, structure)

	-- Security keypad (corridor side)
	local keypad = Builder.part({
		Name = "Keypad",
		Size = V(1, 1.4, 0.3),
		CFrame = CFrame.new(Layout.Points.SecurityKeypad),
		Material = M.SmoothPlastic,
		Color = rgb(40, 40, 45),
	}, structure)
	Builder.part({
		Name = "KeypadLight",
		Size = V(0.6, 0.2, 0.1),
		CFrame = CFrame.new(Layout.Points.SecurityKeypad + V(0, 0.45, 0.2)),
		Material = M.Neon,
		Color = rgb(255, 40, 40),
		CanCollide = false,
	}, structure)

	-- Records room ------------------------------------------------------------------
	for row = 0, 2 do
		Props.shelf(CFrame.new(98 + row * 0.1, 0.2, 44 + row * 9), props)
	end
	Props.shelf(CFrame.new(108.4, 0.2, 60) * CFrame.Angles(0, math.rad(90), 0), props)
	Props.desk(CFrame.new(100, 0.2, 75), props)
	-- Hidden room
	Props.desk(CFrame.new(116, 0.2, 76), props, rgb(60, 50, 40))
	Props.terminal(CFrame.new(116, 0.2, 69) * CFrame.Angles(0, math.pi, 0), props, "PROJECT ZERO\nARCHIVE\n> SUBJECT 00\n> TIMELINE ?")

	return {
		root = root,
		keypad = keypad,
		reader = reader,
		chains = chains,
		cctvScreen = cctvScreen,
	}
end

return Hospital
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Pickups</string><ProtectedString name="Source"><![CDATA[--[[
	Pickups - visual models for collectible objects. Each returns the main
	part, which carries the ProximityPrompt.
]]

local Builder = require(script.Parent:WaitForChild("Builder"))

local M = Enum.Material
local rgb = Color3.fromRGB
local V = Vector3.new

local Pickups = {}

local STYLES = {
	document = function(pos, parent)
		local paper = Builder.part({ Name = "Document", Size = V(1.1, 0.06, 1.5), CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(15), 0), Material = M.SmoothPlastic, Color = rgb(235, 232, 215), CanCollide = false }, parent)
		Builder.part({ Name = "Ink", Size = V(0.8, 0.02, 0.9), CFrame = paper.CFrame * CFrame.new(0, 0.04, -0.1), Material = M.SmoothPlastic, Color = rgb(150, 150, 150), CanCollide = false }, parent)
		return paper
	end,
	research = function(pos, parent)
		local folder = Builder.part({ Name = "ResearchFile", Size = V(1.2, 0.15, 1.6), CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(-20), 0), Material = M.SmoothPlastic, Color = rgb(200, 50, 50), CanCollide = false }, parent)
		Builder.part({ Name = "Stamp", Size = V(0.6, 0.02, 0.3), CFrame = folder.CFrame * CFrame.new(0, 0.085, -0.4), Material = M.Neon, Color = rgb(255, 230, 80), CanCollide = false }, parent)
		local light = Instance.new("PointLight")
		light.Color = rgb(255, 120, 90)
		light.Range = 6
		light.Brightness = 0.8
		light.Parent = folder
		return folder
	end,
	flashlight = function(pos, parent)
		return Builder.part({ Name = "FlashlightPickup", Shape = Enum.PartType.Cylinder, Size = V(1.6, 0.5, 0.5), CFrame = CFrame.new(pos + V(0, 0.05, 0)), Material = M.Metal, Color = rgb(40, 40, 45), CanCollide = false }, parent)
	end,
	pipe = function(pos, parent)
		return Builder.part({ Name = "PipePickup", Shape = Enum.PartType.Cylinder, Size = V(4.4, 0.4, 0.4), CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(25), 0), Material = M.Metal, Color = rgb(130, 135, 140), CanCollide = false }, parent)
	end,
	axe = function(pos, parent)
		local handle = Builder.part({ Name = "AxePickup", Size = V(4, 0.35, 0.35), CFrame = CFrame.new(pos), Material = M.Wood, Color = rgb(110, 75, 40), CanCollide = false }, parent)
		Builder.part({ Name = "AxeHead", Size = V(0.4, 0.3, 1.4), CFrame = handle.CFrame * CFrame.new(1.8, 0, 0.4), Material = M.Metal, Color = rgb(180, 30, 30), CanCollide = false }, parent)
		return handle
	end,
	keycard = function(pos, parent)
		return Builder.part({ Name = "KeycardPickup", Size = V(0.7, 0.05, 1.1), CFrame = CFrame.new(pos), Material = M.SmoothPlastic, Color = rgb(80, 160, 255), CanCollide = false }, parent)
	end,
	fuse = function(pos, parent)
		return Builder.part({ Name = "FusePickup", Shape = Enum.PartType.Cylinder, Size = V(1.2, 0.6, 0.6), CFrame = CFrame.new(pos + V(0, 0.1, 0)), Material = M.Neon, Color = rgb(255, 170, 40), CanCollide = false }, parent)
	end,
	bandage = function(pos, parent)
		return Builder.part({ Name = "BandagePickup", Size = V(0.8, 0.4, 0.8), CFrame = CFrame.new(pos), Material = M.Fabric, Color = rgb(240, 240, 230), CanCollide = false }, parent)
	end,
	medkit = function(pos, parent)
		local box = Builder.part({ Name = "MedkitPickup", Size = V(1.4, 0.7, 1), CFrame = CFrame.new(pos + V(0, 0.1, 0)), Material = M.SmoothPlastic, Color = rgb(200, 40, 40), CanCollide = false }, parent)
		Builder.part({ Name = "Cross", Size = V(0.6, 0.72, 0.15), CFrame = box.CFrame, Material = M.SmoothPlastic, Color = rgb(255, 255, 255), CanCollide = false }, parent)
		return box
	end,
}

function Pickups.create(style, position, parent, withGlint)
	local model = Builder.model("Pickup_" .. style, parent)
	local make = STYLES[style] or STYLES.document
	local main = make(position, model)
	model.PrimaryPart = main
	if withGlint ~= false then
		Builder.glint(main)
	end
	return model, main
end

return Pickups
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[--[[
	Props
	Reusable, low-part-count environment props built from primitives.
	Every function takes a CFrame (position + facing) and a parent.
	Props are original designs built from basic parts (no external assets).
]]

local Builder = require(script.Parent:WaitForChild("Builder"))

local M = Enum.Material
local rgb = Color3.fromRGB

local Props = {}

local function p(model, cf, size, material, color, extra)
	local props = { CFrame = cf, Size = size, Material = material, Color = color }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return Builder.part(props, model)
end

function Props.bed(cf, parent)
	local m = Builder.model("HospitalBed", parent)
	p(m, cf * CFrame.new(0, 1.6, 0), Vector3.new(4, 0.6, 8), M.Metal, rgb(170, 175, 180))
	p(m, cf * CFrame.new(0, 2.2, 0), Vector3.new(3.6, 0.6, 7.6), M.Fabric, rgb(215, 225, 230))
	p(m, cf * CFrame.new(0, 2.6, -3), Vector3.new(2.6, 0.5, 1.4), M.Fabric, rgb(240, 240, 240))
	p(m, cf * CFrame.new(0, 2.4, 1.2), Vector3.new(3.7, 0.25, 4.8), M.Fabric, rgb(140, 175, 195))
	for _, x in ipairs({ -1.7, 1.7 }) do
		for _, z in ipairs({ -3.6, 3.6 }) do
			p(m, cf * CFrame.new(x, 0.65, z), Vector3.new(0.3, 1.3, 0.3), M.Metal, rgb(120, 120, 125))
		end
	end
	p(m, cf * CFrame.new(0, 3.2, -3.9), Vector3.new(4, 2.6, 0.3), M.Metal, rgb(170, 175, 180))
	return m
end

function Props.desk(cf, parent, color)
	local m = Builder.model("Desk", parent)
	p(m, cf * CFrame.new(0, 3, 0), Vector3.new(7, 0.4, 3.4), M.WoodPlanks, color or rgb(110, 85, 60))
	for _, x in ipairs({ -3.2, 3.2 }) do
		p(m, cf * CFrame.new(x, 1.4, 0), Vector3.new(0.4, 2.8, 3.2), M.Wood, rgb(80, 60, 45))
	end
	return m
end

function Props.counter(cf, length, parent)
	local m = Builder.model("Counter", parent)
	p(m, cf * CFrame.new(0, 1.5, 0), Vector3.new(length, 3, 2.5), M.SmoothPlastic, rgb(190, 195, 200))
	p(m, cf * CFrame.new(0, 3.1, 0), Vector3.new(length + 0.4, 0.2, 2.9), M.Marble, rgb(225, 225, 220))
	return m
end

function Props.chair(cf, parent, toppled)
	local m = Builder.model("Chair", parent)
	local base = toppled and (cf * CFrame.Angles(0, 0, math.rad(90)) * CFrame.new(-0.6, 0, 0)) or cf
	p(m, base * CFrame.new(0, 1.8, 0), Vector3.new(2, 0.3, 2), M.Fabric, rgb(60, 70, 80))
	p(m, base * CFrame.new(0, 3, 0.9), Vector3.new(2, 2.2, 0.3), M.Fabric, rgb(60, 70, 80))
	p(m, base * CFrame.new(0, 0.85, 0), Vector3.new(0.3, 1.7, 0.3), M.Metal, rgb(90, 90, 95))
	return m
end

function Props.cabinet(cf, parent, height)
	local h = height or 6
	local m = Builder.model("Cabinet", parent)
	p(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(3, h, 2), M.Metal, rgb(120, 130, 135))
	for i = 1, 3 do
		p(m, cf * CFrame.new(0, h * i / 4, -1.05), Vector3.new(1, 0.2, 0.1), M.Metal, rgb(60, 60, 60))
	end
	return m
end

function Props.shelf(cf, parent, color)
	local m = Builder.model("Shelf", parent)
	local c = color or rgb(95, 70, 50)
	p(m, cf * CFrame.new(0, 4, 0.9), Vector3.new(6, 8, 0.3), M.Wood, c)
	for _, x in ipairs({ -2.9, 2.9 }) do
		p(m, cf * CFrame.new(x, 4, 0), Vector3.new(0.3, 8, 2), M.Wood, c)
	end
	for i = 0, 3 do
		p(m, cf * CFrame.new(0, 0.3 + i * 2.4, 0), Vector3.new(5.6, 0.25, 2), M.Wood, c)
		-- binders / boxes
		p(m, cf * CFrame.new(-1.2 + (i % 2) * 1.5, 1.1 + i * 2.4, 0), Vector3.new(2.2, 1.4, 1.4), M.Cardboard, rgb(170 - i * 15, 140, 100))
	end
	return m
end

function Props.gurney(cf, parent)
	local m = Builder.model("Gurney", parent)
	p(m, cf * CFrame.new(0, 2.4, 0), Vector3.new(2.6, 0.4, 6.5), M.Fabric, rgb(200, 210, 215))
	p(m, cf * CFrame.new(0, 2.1, 0), Vector3.new(2.4, 0.2, 6.3), M.Metal, rgb(160, 160, 165))
	p(m, cf * CFrame.new(0, 1.05, 0), Vector3.new(0.3, 2.1, 5), M.Metal, rgb(130, 130, 135))
	return m
end

-- Computer terminal with a glowing screen.
function Props.terminal(cf, parent, text)
	local m = Builder.model("Terminal", parent)
	p(m, cf * CFrame.new(0, 3.5, 0.3), Vector3.new(2.4, 0.2, 1.4), M.SmoothPlastic, rgb(40, 40, 45))
	local screen = p(m, cf * CFrame.new(0, 4.6, 0.6), Vector3.new(2.6, 1.8, 0.2), M.SmoothPlastic, rgb(15, 25, 20))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.Parent = screen
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = rgb(5, 20, 12)
	label.TextColor3 = rgb(80, 255, 140)
	label.Font = Enum.Font.Code
	label.TextScaled = true
	label.Text = text or "> HELIX SECURE\n> ACCESS LOG"
	label.Parent = gui
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Front
	light.Color = rgb(80, 255, 140)
	light.Brightness = 0.6
	light.Range = 6
	light.Parent = screen
	return m, screen
end

function Props.crate(cf, parent, size)
	local s = size or 3
	local m = Builder.model("Crate", parent)
	p(m, cf * CFrame.new(0, s / 2, 0), Vector3.new(s, s, s), M.WoodPlanks, rgb(130, 100, 65))
	return m
end

function Props.barrel(cf, parent, burning)
	local m = Builder.model(burning and "FireBarrel" or "Barrel", parent)
	local b = p(m, cf * CFrame.new(0, 1.9, 0) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(3.8, 2.6, 2.6), M.CorrodedMetal, rgb(90, 60, 40), { Shape = Enum.PartType.Cylinder })
	if burning then
		local fire = Instance.new("Fire")
		fire.Size = 5
		fire.Heat = 9
		fire.Color = rgb(255, 140, 40)
		fire.SecondaryColor = rgb(255, 60, 20)
		fire.Parent = b
		local light = Instance.new("PointLight")
		light.Color = rgb(255, 150, 70)
		light.Range = 22
		light.Brightness = 2
		light.Shadows = false
		light.Parent = b
	end
	return m
end

-- Wrecked car. 'wreck' tilts it and darkens the paint.
function Props.car(cf, parent, color, wreck)
	local m = Builder.model("Car", parent)
	local base = wreck and (cf * CFrame.Angles(math.rad(4), 0, math.rad(6))) or cf
	local paint = color or rgb(120, 30, 30)
	if wreck then
		paint = paint:Lerp(rgb(40, 35, 30), 0.45)
	end
	p(m, base * CFrame.new(0, 1.9, 0), Vector3.new(6, 1.8, 12), M.SmoothPlastic, paint)
	p(m, base * CFrame.new(0, 3.5, 0.5), Vector3.new(5.4, 1.6, 6), M.SmoothPlastic, paint)
	p(m, base * CFrame.new(0, 3.5, -2.55), Vector3.new(5, 1.4, 0.1), M.Glass, rgb(40, 50, 55), { Transparency = 0.3 })
	for _, x in ipairs({ -2.8, 2.8 }) do
		for _, z in ipairs({ -3.8, 3.8 }) do
			p(m, base * CFrame.new(x, 1, z) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(1, 2.2, 2.2), M.Rubber, rgb(25, 25, 25), { Shape = Enum.PartType.Cylinder })
		end
	end
	p(m, base * CFrame.new(-2, 2, -6.05), Vector3.new(1, 0.6, 0.1), M.Neon, wreck and rgb(60, 60, 50) or rgb(255, 250, 220))
	p(m, base * CFrame.new(2, 2, -6.05), Vector3.new(1, 0.6, 0.1), M.Neon, wreck and rgb(60, 60, 50) or rgb(255, 250, 220))
	return m
end

function Props.ambulance(cf, parent)
	local m = Builder.model("Ambulance", parent)
	local base = cf * CFrame.Angles(0, 0, math.rad(3))
	p(m, base * CFrame.new(0, 4, 2), Vector3.new(7, 6, 10), M.SmoothPlastic, rgb(225, 225, 220))
	p(m, base * CFrame.new(0, 3, -5), Vector3.new(6.6, 4, 4.5), M.SmoothPlastic, rgb(225, 225, 220))
	p(m, base * CFrame.new(0, 4.5, -7.3), Vector3.new(6, 1.6, 0.1), M.Glass, rgb(40, 50, 60), { Transparency = 0.3 })
	p(m, base * CFrame.new(3.55, 4.5, 2), Vector3.new(0.1, 1.2, 8), M.SmoothPlastic, rgb(200, 40, 40))
	p(m, base * CFrame.new(-3.55, 4.5, 2), Vector3.new(0.1, 1.2, 8), M.SmoothPlastic, rgb(200, 40, 40))
	local beacon = p(m, base * CFrame.new(0, 7.2, -2.5), Vector3.new(3, 0.5, 0.8), M.Neon, rgb(255, 40, 40), { Tags = { "FlickerLight" } })
	local l = Instance.new("PointLight")
	l.Color = rgb(255, 40, 40)
	l.Range = 14
	l.Brightness = 1.5
	l.Parent = beacon
	-- open rear doors (one hanging)
	p(m, base * CFrame.new(-1.75, 4, 7.1), Vector3.new(3.4, 5.6, 0.2), M.SmoothPlastic, rgb(220, 220, 215))
	p(m, base * CFrame.new(3.3, 4, 8.4) * CFrame.Angles(0, math.rad(70), 0), Vector3.new(3.4, 5.6, 0.2), M.SmoothPlastic, rgb(220, 220, 215))
	for _, x in ipairs({ -3.2, 3.2 }) do
		for _, z in ipairs({ -4.5, 4.5 }) do
			p(m, base * CFrame.new(x, 1.1, z) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(1.1, 2.3, 2.3), M.Rubber, rgb(25, 25, 25), { Shape = Enum.PartType.Cylinder })
		end
	end
	return m
end

-- Street lamp. mode: "on" | "flicker" | "off"
function Props.streetLamp(cf, parent, mode)
	local m = Builder.model("StreetLamp", parent)
	p(m, cf * CFrame.new(0, 7, 0), Vector3.new(0.6, 14, 0.6), M.Metal, rgb(50, 55, 60))
	p(m, cf * CFrame.new(0, 14, -1.5), Vector3.new(0.5, 0.5, 3.5), M.Metal, rgb(50, 55, 60))
	local head = p(m, cf * CFrame.new(0, 13.6, -3), Vector3.new(1.4, 0.4, 1.8), M.Neon, mode == "off" and rgb(50, 50, 45) or rgb(255, 210, 150), {
		CanCollide = false,
		Tags = mode == "flicker" and { "FlickerLight" } or nil,
	})
	if mode ~= "off" then
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Bottom
		light.Angle = 110
		light.Range = 30
		light.Brightness = 2.2
		light.Color = rgb(255, 205, 150)
		light.Shadows = false
		light.Parent = head
	end
	return m
end

function Props.barricade(cf, parent)
	local m = Builder.model("Barricade", parent)
	for i = -1, 1 do
		p(m, cf * CFrame.new(i * 4, 2, 0) * CFrame.Angles(0, 0, math.rad(i * 8)), Vector3.new(4.2, 4, 0.5), M.WoodPlanks, rgb(120, 95, 60))
	end
	p(m, cf * CFrame.new(0, 3.2, -0.4), Vector3.new(13, 0.6, 0.4), M.Metal, rgb(200, 170, 40))
	return m
end

function Props.policeBarrier(cf, parent)
	local m = Builder.model("PoliceBarrier", parent)
	p(m, cf * CFrame.new(0, 2.6, 0), Vector3.new(8, 0.9, 0.3), M.SmoothPlastic, rgb(240, 240, 240))
	p(m, cf * CFrame.new(0, 2.6, -0.16), Vector3.new(7.8, 0.4, 0.05), M.SmoothPlastic, rgb(30, 60, 160))
	for _, x in ipairs({ -3.6, 3.6 }) do
		p(m, cf * CFrame.new(x, 1.3, 0), Vector3.new(0.3, 2.6, 1.6), M.Metal, rgb(90, 90, 90))
	end
	return m
end

function Props.debris(cf, parent, rng, count)
	local m = Builder.model("Debris", parent)
	rng = rng or Random.new(7)
	for _ = 1, count or 5 do
		local s = Vector3.new(rng:NextNumber(0.8, 3.5), rng:NextNumber(0.4, 1.6), rng:NextNumber(0.8, 3))
		local off = CFrame.new(rng:NextNumber(-4, 4), s.Y / 2 - 0.1, rng:NextNumber(-4, 4))
		local rot = CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi), rng:NextNumber(-0.4, 0.4))
		local shade = rng:NextInteger(85, 140)
		p(m, cf * off * rot, s, M.Concrete, rgb(shade, shade - 5, shade - 10))
	end
	return m
end

function Props.dumpster(cf, parent)
	local m = Builder.model("Dumpster", parent)
	p(m, cf * CFrame.new(0, 2.2, 0), Vector3.new(8, 4.4, 4.5), M.DiamondPlate, rgb(40, 80, 50))
	p(m, cf * CFrame.new(0, 4.6, 0.6) * CFrame.Angles(math.rad(-12), 0, 0), Vector3.new(8.2, 0.3, 4), M.Plastic, rgb(30, 30, 30))
	return m
end

function Props.trashBags(cf, parent, rng)
	local m = Builder.model("TrashBags", parent)
	rng = rng or Random.new(3)
	for _ = 1, 4 do
		local s = rng:NextNumber(1.6, 2.6)
		p(m, cf * CFrame.new(rng:NextNumber(-2, 2), s / 2 - 0.2, rng:NextNumber(-2, 2)), Vector3.new(s, s, s), M.Plastic, rgb(25, 25, 28), { Shape = Enum.PartType.Ball })
	end
	return m
end

function Props.deadTree(cf, parent, rng)
	local m = Builder.model("DeadTree", parent)
	rng = rng or Random.new(11)
	local h = rng:NextNumber(10, 16)
	p(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(1.4, h, 1.4), M.Wood, rgb(60, 45, 35))
	for i = 1, 4 do
		local y = h * (0.5 + i * 0.1)
		local ang = rng:NextNumber(0, math.pi * 2)
		local branch = cf * CFrame.new(0, y, 0) * CFrame.Angles(0, ang, 0) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(35, 60))) * CFrame.new(0, 2.2, 0)
		p(m, branch, Vector3.new(0.5, 4.5, 0.5), M.Wood, rgb(60, 45, 35))
	end
	p(m, cf * CFrame.new(0, 0.2, 0), Vector3.new(4, 0.4, 4), M.Ground, rgb(50, 45, 35))
	return m
end

function Props.bench(cf, parent)
	local m = Builder.model("Bench", parent)
	p(m, cf * CFrame.new(0, 1.7, 0), Vector3.new(6, 0.3, 1.8), M.WoodPlanks, rgb(100, 75, 50))
	p(m, cf * CFrame.new(0, 2.8, 0.8), Vector3.new(6, 1.6, 0.25), M.WoodPlanks, rgb(100, 75, 50))
	for _, x in ipairs({ -2.6, 2.6 }) do
		p(m, cf * CFrame.new(x, 0.8, 0), Vector3.new(0.3, 1.6, 1.6), M.Metal, rgb(40, 40, 40))
	end
	return m
end

function Props.kiosk(cf, parent)
	local m = Builder.model("Newsstand", parent)
	p(m, cf * CFrame.new(0, 2.8, 0), Vector3.new(7, 5.6, 4), M.Metal, rgb(30, 80, 60))
	p(m, cf * CFrame.new(0, 5.9, -0.8), Vector3.new(8, 0.3, 6), M.Metal, rgb(25, 60, 45))
	p(m, cf * CFrame.new(0, 3, -2.05), Vector3.new(6, 0.4, 0.4), M.Wood, rgb(110, 85, 60))
	Builder.sign("NEWS", cf * CFrame.new(0, 6.6, -2) * CFrame.Angles(0, math.pi, 0), Vector3.new(4, 1, 0.2), m, rgb(255, 230, 150))
	return m
end

function Props.trafficLight(cf, parent)
	local m = Builder.model("TrafficLight", parent)
	p(m, cf * CFrame.new(0, 6, 0), Vector3.new(0.5, 12, 0.5), M.Metal, rgb(40, 40, 40))
	p(m, cf * CFrame.new(0, 11, -0.6), Vector3.new(1.2, 3.2, 1), M.Metal, rgb(30, 30, 30))
	p(m, cf * CFrame.new(0, 12, -1.15), Vector3.new(0.7, 0.7, 0.1), M.Neon, rgb(70, 20, 20))
	p(m, cf * CFrame.new(0, 11, -1.15), Vector3.new(0.7, 0.7, 0.1), M.Neon, rgb(255, 170, 30), { Tags = { "FlickerLight" } })
	p(m, cf * CFrame.new(0, 10, -1.15), Vector3.new(0.7, 0.7, 0.1), M.Neon, rgb(20, 60, 20))
	return m
end

return Props
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	WorldBuilder
	Generates the full Chapter 1 map at server start. Building from code
	means the place file stays tiny, the map can be rebuilt/tweaked from
	text (no Studio modelling needed), and nothing references missing assets.
]]

local Builder = require(script.Parent:WaitForChild("Builder"))
local Hospital = require(script.Parent:WaitForChild("Hospital"))
local City = require(script.Parent:WaitForChild("City"))

local WorldBuilder = {}

function WorldBuilder.build()
	local existing = workspace:FindFirstChild("World")
	if existing then
		existing:Destroy()
	end
	local world = Builder.folder("World", workspace)
	local started = os.clock()
	local hospital = Hospital.build(world)
	local city = City.build(world)
	local zombies = Builder.folder("Zombies", workspace)
	local interactables = Builder.folder("Interactables", workspace)

	local count = 0
	for _, d in ipairs(world:GetDescendants()) do
		if d:IsA("BasePart") then
			count = count + 1
		end
	end
	print(("[WorldBuilder] Built Chapter 1 world: %d parts in %.2fs"):format(count, os.clock() - started))

	return {
		world = world,
		hospital = hospital,
		city = city,
		zombieFolder = zombies,
		interactables = interactables,
	}
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerStorage" referent="RBX00000029"><Properties><string name="Name">ServerStorage</string></Properties></Item><Item class="StarterPlayer" referent="RBX0000003A"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">22.0</float><float name="CameraMinZoomDistance">0.5</float><bool name="EnableMouseLockOption">true</bool><bool name="LoadCharacterAppearance">true</bool></Properties><Item class="StarterPlayerScripts" referent="RBX00000037"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000002A"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[--[[
	PROJECT: ZERO - client bootstrap.
	Initialises every client controller and wires their buttons together.
	The client only presents state; all game rules run on the server.
]]

local Controllers = script.Parent:WaitForChild("Controllers")

local State = require(Controllers:WaitForChild("State"))
local Effects = require(Controllers:WaitForChild("Effects"))
local Cinematic = require(Controllers:WaitForChild("Cinematic"))
local HUD = require(Controllers:WaitForChild("HUD"))
local Input = require(Controllers:WaitForChild("Input"))
local Dialogue = require(Controllers:WaitForChild("Dialogue"))
local Keypad = require(Controllers:WaitForChild("Keypad"))
local Inventory = require(Controllers:WaitForChild("Inventory"))
local MapUI = require(Controllers:WaitForChild("MapUI"))
local Menu = require(Controllers:WaitForChild("Menu"))

State.init()
Effects.init()
Cinematic.init()
HUD.init()
Input.init()
Dialogue.init()
Keypad.init()
Inventory.init()
MapUI.init()
Menu.init()

HUD.onButton("BAG", function()
	Inventory.toggle()
end)
HUD.onButton("MAP", MapUI.toggle)
HUD.onButton("MENU", Menu.openPause)
Input.on("bag", Inventory.toggle)
Input.on("map", MapUI.toggle)
Menu.setInventoryOpener(function()
	Inventory.open("STYLE")
end)

Input.refresh()
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000036"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">Cinematic</string><ProtectedString name="Source"><![CDATA[--[[
	Cinematic - plays data-driven camera sequences (shared/Cinematics.lua)
	with letterbox bars, subtitles, title cards, fades, flicker and shake.
	Every cinematic can be skipped; the server is told when it ends.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cinematics = require(Shared:WaitForChild("Cinematics"))
local Net = require(Shared:WaitForChild("Net"))

local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))

local Cinematic = {}
local player = Players.LocalPlayer

local gui, topBar, bottomBar, black, title, subtitleFrame, speakerLabel, lineLabel, skipButton
local playingId = nil
local skipRequested = false

local function build()
	gui = UI.screen("PZ_Cinematic", 50, true)
	gui.Enabled = false
	topBar = UI.new("Frame", { Size = UDim2.new(1, 0, 0.11, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui })
	bottomBar = UI.new("Frame", { Size = UDim2.new(1, 0, 0.11, 0), Position = UDim2.fromScale(0, 0.89), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui })
	black = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, BackgroundTransparency = 1, Parent = gui })
	title = UI.label({
		Size = UDim2.new(0.8, 0, 0.4, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = UI.Theme.FontBold,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTransparency = 1,
		Parent = gui,
	})
	subtitleFrame = UI.new("Frame", {
		Size = UDim2.new(0.8, 0, 0, 90),
		Position = UDim2.new(0.5, 0, 0.87, 0),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	speakerLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 26),
		Font = UI.Theme.FontBlack,
		TextSize = 20,
		TextColor3 = UI.Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		Parent = subtitleFrame,
	})
	lineLabel = UI.label({
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.fromOffset(0, 28),
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextStrokeTransparency = 0.4,
		Parent = subtitleFrame,
	})
	skipButton = UI.button({
		Text = "SKIP  >>",
		Size = UDim2.fromOffset(130, 42),
		Position = UDim2.new(1, -24, 0, 24),
		AnchorPoint = Vector2.new(1, 0),
		Style = "ghost",
		Parent = gui,
	}, function()
		skipRequested = true
	end)
end

local function setSubtitle(speaker, line)
	local show = State.setting("subtitles", true)
	speakerLabel.Text = speaker or ""
	lineLabel.Text = line or ""
	subtitleFrame.Visible = show and (line ~= nil and line ~= "")
end

local function finish(id)
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	gui.Enabled = false
	playingId = nil
	State.inCinematic = false
	State.emit("cinematic", false)
	Net.get("CinematicDone"):FireServer(id)
end

function Cinematic.isPlaying()
	return playingId ~= nil
end

function Cinematic.play(id)
	local data = Cinematics[id]
	if not data or playingId then
		return
	end
	playingId = id
	skipRequested = false
	State.inCinematic = true
	State.emit("cinematic", true)
	gui.Enabled = true
	skipButton.Visible = data.skippable ~= false
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable

	task.spawn(function()
		for _, shot in ipairs(data.shots) do
			if skipRequested then
				break
			end
			setSubtitle(shot.speaker, shot.line)
			if shot.black then
				black.BackgroundTransparency = 0
				title.Text = shot.title or ""
				UI.tween(title, 0.8, { TextTransparency = 0 })
			else
				title.TextTransparency = 1
				black.BackgroundTransparency = shot.fadeIn and 0 or 1
				if shot.fadeIn then
					UI.tween(black, 1.2, { BackgroundTransparency = 1 })
				end
				camera.FieldOfView = shot.fov or 70
			end
			local started = os.clock()
			local duration = shot.duration or 3
			while os.clock() - started < duration and not skipRequested do
				local t = math.clamp((os.clock() - started) / duration, 0, 1)
				local eased = t * t * (3 - 2 * t) -- smoothstep
				if not shot.black and shot.from and shot.to then
					local pos = shot.from.pos:Lerp(shot.to.pos, eased)
					local look = shot.from.look:Lerp(shot.to.look, eased)
					local cf = CFrame.lookAt(pos, look)
					if shot.shake and State.setting("cameraShake", true) then
						local s = shot.shake * 0.35
						cf = cf * CFrame.Angles((math.random() - 0.5) * s * 0.1, (math.random() - 0.5) * s * 0.1, 0) * CFrame.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, 0)
					end
					camera.CFrame = cf
				end
				if shot.flicker and math.random() < 0.06 then
					black.BackgroundTransparency = 0.15
				elseif shot.flicker and not shot.fadeIn then
					black.BackgroundTransparency = 1
				end
				RunService.RenderStepped:Wait()
			end
			if shot.black then
				UI.tween(title, 0.3, { TextTransparency = 1 })
			end
		end
		black.BackgroundTransparency = 1
		title.TextTransparency = 1
		finish(id)
	end)
end

function Cinematic.init()
	build()
	Net.get("PlayCinematic").OnClientEvent:Connect(function(id)
		-- wait briefly for the character so the camera can return to it
		task.wait(0.1)
		Cinematic.play(id)
	end)
end

return Cinematic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">Dialogue</string><ProtectedString name="Source"><![CDATA[--[[
	Dialogue - conversation UI. The server sends one node at a time; the
	player taps a choice (or Continue) and the server answers with the next.
	Text types out for a cinematic feel; tapping the box completes it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))

local Dialogue = {}
local T = UI.Theme

local gui, box, speakerLabel, textLabel, choicesFrame
local typingToken

local function clearChoices()
	for _, c in ipairs(choicesFrame:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
end

local function close()
	gui.Enabled = false
	State.modalOpen = false
	State.emit("modal", false)
end

local function show(node)
	gui.Enabled = true
	State.modalOpen = true
	State.emit("modal", true)
	speakerLabel.Text = string.upper(node.speaker or "")
	clearChoices()

	local token = {}
	typingToken = token
	local full = node.text or ""
	textLabel.Text = full
	textLabel.MaxVisibleGraphemes = 0
	task.spawn(function()
		for i = 1, #full do
			if typingToken ~= token then
				return
			end
			textLabel.MaxVisibleGraphemes = i
			task.wait(0.018)
		end
	end)

	local function addChoice(text, index, order)
		UI.button({
			Text = text,
			Size = UDim2.new(1, 0, 0, 46),
			Style = index == 0 and "primary" or "secondary",
			LayoutOrder = order,
			TextSize = 17,
			Parent = choicesFrame,
		}, function()
			typingToken = nil
			textLabel.MaxVisibleGraphemes = -1
			clearChoices()
			if node.final and index == 0 then
				close()
			end
			Net.get("DialogueChoice"):FireServer(index)
		end).TextWrapped = true
	end

	if node.choices and #node.choices > 0 then
		for i, text in ipairs(node.choices) do
			addChoice(text, i, i)
		end
	else
		addChoice(node.final and "Leave" or "Continue", 0, 1)
	end
end

function Dialogue.init()
	gui = UI.screen("PZ_Dialogue", 20)
	gui.Enabled = false
	box = UI.panel({
		Size = UDim2.fromOffset(760, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(0.5, 0, 1, -24),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = gui,
	})
	UI.padding(18).Parent = box
	UI.list(Enum.FillDirection.Vertical, 10).Parent = box
	speakerLabel = UI.label({ Size = UDim2.new(1, 0, 0, 22), Font = T.FontBlack, TextSize = 18, TextColor3 = T.Accent, LayoutOrder = 1, Parent = box })
	textLabel = UI.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 20, LayoutOrder = 2, Parent = box })
	choicesFrame = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = box })
	UI.list(Enum.FillDirection.Vertical, 6).Parent = choicesFrame

	Net.get("DialogueShow").OnClientEvent:Connect(show)
	Net.get("DialogueClose").OnClientEvent:Connect(close)
end

return Dialogue
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--[[
	Effects - local-only presentation:
	- flickering lights (CollectionService tag "FlickerLight")
	- camera shake on hits / boss slams
	- scalable graphics quality (Auto / Low / Medium / High)
	- low-health screen edge glow
	- ambient audio + music (IDs in Config.Sounds; empty = silent)
	- hides pickup prompts for things this player already owns
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))

local Effects = {}
local player = Players.LocalPlayer

-- Flicker -------------------------------------------------------------------------------
local flickers = {}
local function registerFlicker(part)
	if not part:IsA("BasePart") then
		return
	end
	flickers[part] = { color = part.Color, next = 0 }
end

local function flickerStep()
	local camera = workspace.CurrentCamera
	local camPos = camera and camera.CFrame.Position or Vector3.zero
	local now = os.clock()
	for part, data in pairs(flickers) do
		if not part.Parent then
			flickers[part] = nil
		elseif now >= data.next and (part.Position - camPos).Magnitude < 180 then
			local on = math.random() > 0.35
			data.next = now + (on and math.random(3, 25) / 10 or math.random(1, 3) / 20)
			part.Color = on and data.color or data.color:Lerp(Color3.new(0, 0, 0), 0.85)
			for _, child in ipairs(part:GetChildren()) do
				if child:IsA("Light") then
					child.Enabled = on
				end
			end
		end
	end
end

-- Camera shake -----------------------------------------------------------------------------
local shakeIntensity, shakeUntil = 0, 0
function Effects.shake(intensity, duration)
	if not State.setting("cameraShake", true) then
		return
	end
	shakeIntensity = math.max(shakeIntensity, intensity)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

local function shakeStep()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if os.clock() < shakeUntil then
		local i = shakeIntensity * 0.6
		humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * i, (math.random() - 0.5) * i, 0)
	elseif humanoid.CameraOffset ~= Vector3.zero then
		humanoid.CameraOffset = Vector3.zero
		shakeIntensity = 0
	end
end

-- Graphics quality -------------------------------------------------------------------------------
function Effects.applyGraphics(level)
	if level == "Auto" or level == nil then
		level = UI.isTouch() and "Medium" or "High"
	end
	local low = level == "Low"
	local high = level == "High"
	Lighting.GlobalShadows = not low
	local bloom = Lighting:FindFirstChild("PZ_Bloom")
	if bloom then
		bloom.Enabled = not low
	end
	local rays = Lighting:FindFirstChild("PZ_SunRays")
	if rays then
		rays.Enabled = high
	end
	local dof = Lighting:FindFirstChild("PZ_DOF")
	if dof then
		dof.Enabled = high
	end
	local atmosphere = Lighting:FindFirstChild("PZ_Atmosphere")
	if atmosphere then
		atmosphere.Density = low and 0.38 or 0.42
	end
	for _, pe in ipairs(CollectionService:GetTagged("OptionalParticle")) do
		if pe:IsA("ParticleEmitter") then
			pe.Enabled = not low
		end
	end
	Effects.level = level
end

-- Low health glow --------------------------------------------------------------------------------
local edgeFrames = {}
local function buildHealthGlow()
	local gui = UI.screen("PZ_HealthGlow", 0, true)
	local function edge(size, pos, rotation)
		local f = UI.new("Frame", {
			Size = size,
			Position = pos,
			BackgroundColor3 = Color3.fromRGB(180, 0, 0),
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			Parent = gui,
		})
		UI.new("UIGradient", {
			Rotation = rotation,
			Transparency = NumberSequence.new(0, 1),
			Parent = f,
		})
		table.insert(edgeFrames, f)
	end
	edge(UDim2.new(0.25, 0, 1, 0), UDim2.fromScale(0, 0), 0)
	edge(UDim2.new(0.25, 0, 1, 0), UDim2.fromScale(0.75, 0), 180)
	edge(UDim2.new(1, 0, 0.25, 0), UDim2.fromScale(0, 0), 90)
	edge(UDim2.new(1, 0, 0.25, 0), UDim2.fromScale(0, 0.75), 270)
end

local function healthGlowStep()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local t = 1
	if humanoid and humanoid.Health > 0 then
		local frac = humanoid.Health / humanoid.MaxHealth
		if frac < 0.4 or character:GetAttribute("Downed") then
			local pulse = (math.sin(os.clock() * 4) + 1) * 0.08
			t = 0.35 + frac + pulse
		end
	end
	for _, f in ipairs(edgeFrames) do
		f.BackgroundTransparency = math.clamp(t, 0, 1)
	end
end

-- Audio -----------------------------------------------------------------------------------------------
local music, ambient
local function makeSound(name, id)
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = id or ""
	s.Looped = true
	s.Volume = 0
	s.Parent = SoundService
	return s
end

function Effects.setMusic(trackKey)
	local id = Config.Sounds[trackKey] or ""
	if id == "" then
		music:Stop()
		return
	end
	if music.SoundId ~= id then
		music.SoundId = id
	end
	if not music.IsPlaying then
		music:Play()
	end
end

local function audioStep()
	local volMusic = State.setting("music", 0.6)
	local volSfx = State.setting("sfx", 0.8)
	music.Volume = 0.35 * volMusic
	SoundService.AmbientReverb = Enum.ReverbType.Hallway
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local key = "AmbientCity"
	if root and root.Position.X >= 0 and root.Position.X <= 120 and root.Position.Z >= 0 and root.Position.Z <= 80 then
		key = "AmbientHospital"
	end
	local id = Config.Sounds[key] or ""
	if id ~= "" then
		if ambient.SoundId ~= id then
			ambient.SoundId = id
			ambient:Play()
		end
		ambient.Volume = 0.4 * volSfx
	else
		ambient:Stop()
	end
end

-- Pickup prompt filtering -------------------------------------------------------------------------------
local function filterPrompt(prompt)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local id = prompt:GetAttribute("PickupId")
	local kind = prompt:GetAttribute("PickupKind")
	local profile = State.profile
	if not id or not profile then
		return
	end
	local owned = false
	if kind == "doc" then
		owned = profile.documents and profile.documents[id] == true
		-- story-critical notes stay readable (the keypad code changes each run)
		if id == "shift_note" then
			owned = false
		end
	elseif kind == "equip" then
		owned = profile.equipment and profile.equipment[id] == true
	end
	prompt.Enabled = not owned
end

local function filterAllPrompts()
	local folder = workspace:FindFirstChild("Interactables")
	if folder then
		for _, d in ipairs(folder:GetDescendants()) do
			filterPrompt(d)
		end
	end
	local world = workspace:FindFirstChild("World")
	if world then
		for _, d in ipairs(world:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				filterPrompt(d)
			end
		end
	end
end

function Effects.init()
	music = makeSound("PZ_Music")
	ambient = makeSound("PZ_Ambient")
	buildHealthGlow()

	for _, part in ipairs(CollectionService:GetTagged("FlickerLight")) do
		registerFlicker(part)
	end
	CollectionService:GetInstanceAddedSignal("FlickerLight"):Connect(registerFlicker)
	CollectionService:GetInstanceAddedSignal("OptionalParticle"):Connect(function(pe)
		if Effects.level == "Low" and pe:IsA("ParticleEmitter") then
			pe.Enabled = false
		end
	end)

	Net.get("Shake").OnClientEvent:Connect(function(intensity, duration)
		Effects.shake(intensity or 0.3, duration or 0.25)
	end)

	State.on("profile", function(profile)
		Effects.applyGraphics(profile.settings and profile.settings.graphics)
		filterAllPrompts()
	end)
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			task.defer(filterPrompt, d)
		end
	end)

	local accum = 0
	RunService.RenderStepped:Connect(function(dt)
		shakeStep()
		healthGlowStep()
		accum = accum + dt
		if accum > 0.1 then
			accum = 0
			flickerStep()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			audioStep()
		end
	end)
	Effects.applyGraphics("Auto")
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--[[
	HUD - in-game interface: health & stamina, mission objective with a
	world waypoint, party key items, toasts, tutorial hints, boss bar,
	downed/death overlays and the BAG / MAP / MENU buttons.
	Layout keeps the bottom-left (thumbstick) and bottom-right (jump +
	action buttons) clear for touch devices.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Items"))
local Chapters = require(Shared:WaitForChild("Chapters"))

local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))

local HUD = {}
local player = Players.LocalPlayer
local T = UI.Theme

local gui, root
local healthFill, healthText, staminaFill, staminaFrame
local objectiveLabel, objectiveFrame, partyRow
local toastHolder, hintFrame, hintLabel
local bossFrame, bossFill, bossName
local downedLabel, deathLabel
local waypointPart, waypointGui, waypointText

local callbacks = {}
function HUD.onButton(name, cb)
	callbacks[name] = cb
end

local function bar(parent, pos, color, height)
	local frame = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		Position = pos,
		BackgroundColor3 = Color3.fromRGB(20, 20, 22),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Parent = parent,
	})
	UI.corner(height / 2).Parent = frame
	local fill = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0, Parent = frame })
	UI.corner(height / 2).Parent = fill
	return frame, fill
end

-- Toasts ------------------------------------------------------------------------------------
local KIND_COLORS = {
	good = T.Good,
	bad = T.Danger,
	info = T.Info,
	reward = T.Accent,
	achievement = T.Accent,
	checkpoint = Color3.fromRGB(180, 180, 180),
}

function HUD.toast(text, kind)
	local color = KIND_COLORS[kind] or T.Text
	local frame = UI.panel({
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 0.2,
		Parent = toastHolder,
	})
	UI.new("Frame", { Size = UDim2.new(0, 5, 1, -12), Position = UDim2.fromOffset(8, 6), BackgroundColor3 = color, BorderSizePixel = 0, Parent = frame })
	local prefix = kind == "achievement" and "ACHIEVEMENT  " or ""
	UI.label({
		Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.fromOffset(22, 0),
		Text = prefix .. text,
		TextSize = 17,
		Font = kind == "achievement" and T.FontBold or T.Font,
		TextColor3 = kind == "achievement" and color or T.Text,
		Parent = frame,
	})
	task.delay(kind == "achievement" and 5 or 3.5, function()
		UI.tween(frame, 0.4, { BackgroundTransparency = 1 })
		for _, d in ipairs(frame:GetDescendants()) do
			if d:IsA("TextLabel") then
				UI.tween(d, 0.4, { TextTransparency = 1 })
			elseif d:IsA("Frame") then
				UI.tween(d, 0.4, { BackgroundTransparency = 1 })
			elseif d:IsA("UIStroke") then
				UI.tween(d, 0.4, { Transparency = 1 })
			end
		end
		task.wait(0.45)
		frame:Destroy()
	end)
end

-- Hints ------------------------------------------------------------------------------------------
function HUD.hint(hintId)
	local def = Chapters.Hints[hintId]
	if not def then
		return
	end
	hintLabel.Text = UI.isTouch() and def.touch or def.pc
	hintFrame.Visible = true
	local token = {}
	HUD._hintToken = token
	task.delay(11, function()
		if HUD._hintToken == token then
			hintFrame.Visible = false
		end
	end)
end

-- Objective / waypoint ------------------------------------------------------------------------------
local function setObjective(obj)
	if not obj then
		objectiveFrame.Visible = false
		return
	end
	objectiveFrame.Visible = true
	objectiveLabel.Text = obj.text
	objectiveFrame.BackgroundColor3 = T.Accent
	UI.tween(objectiveFrame, 0.8, { BackgroundColor3 = T.Panel })
	if obj.target then
		waypointPart.Position = obj.target + Vector3.new(0, 4, 0)
		waypointGui.Enabled = true
	else
		waypointGui.Enabled = false
	end
end

local function setParty(party)
	for _, c in ipairs(partyRow:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for itemId, count in pairs(party or {}) do
		local def = Items[itemId]
		if def and count > 0 then
			local chip = UI.panel({ Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 0.25, Parent = partyRow })
			UI.padding(6).Parent = chip
			UI.label({ Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, Text = "KEY: " .. def.name, TextSize = 14, TextColor3 = def.color, Font = T.FontBold, Parent = chip })
		end
	end
end

local function updateVisibility()
	root.Visible = not State.inMenu and not State.inCinematic
	waypointGui.Enabled = root.Visible and State.objective ~= nil and State.objective.target ~= nil
end

local function build()
	gui = UI.screen("PZ_HUD", 5)
	root = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })

	-- objective (top-left)
	objectiveFrame = UI.panel({ Size = UDim2.fromOffset(380, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.fromOffset(16, 16), Parent = root })
	UI.padding(12).Parent = objectiveFrame
	UI.list(Enum.FillDirection.Vertical, 4).Parent = objectiveFrame
	UI.label({ Size = UDim2.new(1, 0, 0, 16), Text = "OBJECTIVE", TextSize = 13, Font = T.FontBlack, TextColor3 = T.Accent, LayoutOrder = 1, Parent = objectiveFrame })
	objectiveLabel = UI.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = "", TextSize = 18, Font = T.FontBold, LayoutOrder = 2, Parent = objectiveFrame })
	partyRow = UI.new("Frame", { Size = UDim2.fromOffset(380, 28), Position = UDim2.new(0, 16, 0, 110), BackgroundTransparency = 1, Parent = root })
	UI.list(Enum.FillDirection.Horizontal, 6).Parent = partyRow
	objectiveFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local scale = gui:FindFirstChildOfClass("UIScale").Scale
		partyRow.Position = UDim2.fromOffset(16, 24 + objectiveFrame.AbsoluteSize.Y / scale)
	end)

	-- buttons (top-right)
	local buttons = UI.new("Frame", { Size = UDim2.fromOffset(250, 56), Position = UDim2.new(1, -16, 0, 16), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Parent = root })
	local layout = UI.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
	layout.Parent = buttons
	for i, name in ipairs({ "BAG", "MAP", "MENU" }) do
		UI.button({ Text = name, Size = UDim2.fromOffset(76, 52), Style = "ghost", LayoutOrder = i, TextSize = 16, Parent = buttons }, function()
			if callbacks[name] then
				callbacks[name]()
			end
		end)
	end

	-- vitals (bottom-centre)
	local vitals = UI.new("Frame", { Size = UDim2.fromOffset(340, 44), Position = UDim2.new(0.5, 0, 1, -18), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = root })
	local healthFrame
	healthFrame, healthFill = bar(vitals, UDim2.fromOffset(0, 0), T.Health, 18)
	healthText = UI.label({ Size = UDim2.fromScale(1, 1), Text = "100", TextSize = 13, Font = T.FontBold, TextXAlignment = Enum.TextXAlignment.Center, Parent = healthFrame })
	staminaFrame, staminaFill = bar(vitals, UDim2.fromOffset(0, 26), T.Stamina, 10)

	-- toasts (top-centre)
	toastHolder = UI.new("Frame", { Size = UDim2.fromOffset(420, 300), Position = UDim2.new(0.5, 0, 0, 96), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Parent = gui })
	UI.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center).Parent = toastHolder

	-- hint (centre, above vitals)
	hintFrame = UI.panel({ Size = UDim2.fromOffset(520, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, 0, 1, -90), AnchorPoint = Vector2.new(0.5, 1), Visible = false, Parent = root })
	UI.padding(12).Parent = hintFrame
	hintLabel = UI.label({ Size = UDim2.new(1, -90, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 17, Parent = hintFrame })
	UI.button({ Text = "OK", Size = UDim2.fromOffset(70, 36), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Style = "primary", Parent = hintFrame }, function()
		hintFrame.Visible = false
	end)

	-- boss bar (top-centre)
	bossFrame = UI.new("Frame", { Size = UDim2.fromOffset(460, 50), Position = UDim2.new(0.5, 0, 0, 20), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Visible = false, Parent = gui })
	bossName = UI.label({ Size = UDim2.new(1, 0, 0, 22), Text = "", TextSize = 18, Font = T.FontBlack, TextColor3 = T.Danger, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.5, Parent = bossFrame })
	local _, fill = bar(bossFrame, UDim2.fromOffset(0, 26), T.Danger, 14)
	bossFill = fill

	-- overlays
	downedLabel = UI.label({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromScale(0, 0.3), Text = "YOU ARE DOWN - hold on, a teammate can revive you", TextSize = 22, Font = T.FontBlack, TextColor3 = T.Danger, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, Visible = false, Parent = root })
	deathLabel = UI.label({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromScale(0, 0.4), Text = "YOU DIED - returning to the last checkpoint...", TextSize = 24, Font = T.FontBlack, TextColor3 = T.Danger, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.4, Visible = false, Parent = gui })

	-- waypoint marker (local-only part with an always-on-top billboard)
	waypointPart = Instance.new("Part")
	waypointPart.Name = "PZ_Waypoint"
	waypointPart.Anchored = true
	waypointPart.CanCollide = false
	waypointPart.CanQuery = false
	waypointPart.CanTouch = false
	waypointPart.Transparency = 1
	waypointPart.Size = Vector3.new(0.2, 0.2, 0.2)
	waypointPart.Parent = workspace.CurrentCamera
	waypointGui = UI.new("BillboardGui", {
		Size = UDim2.fromOffset(90, 44),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Enabled = false,
		Adornee = waypointPart,
		ResetOnSpawn = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	UI.label({ Size = UDim2.new(1, 0, 0, 22), Text = "v", TextSize = 22, Font = T.FontBlack, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = waypointGui })
	waypointText = UI.label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 22), Text = "", TextSize = 14, Font = T.FontBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = waypointGui })
end

local function step()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local frac = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
		healthFill.Size = UDim2.fromScale(frac, 1)
		healthText.Text = tostring(math.ceil(humanoid.Health))
		downedLabel.Visible = character:GetAttribute("Downed") == true
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if rootPart and waypointGui.Enabled then
			local d = (waypointPart.Position - rootPart.Position).Magnitude
			waypointText.Text = string.format("%dm", math.floor(d / 3.5))
		end
	end
	local stamina = player:GetAttribute("Stamina") or 100
	staminaFill.Size = UDim2.fromScale(math.clamp(stamina / 100, 0, 1), 1)
	staminaFrame.Visible = stamina < 99.5
end

function HUD.init()
	build()
	State.on("objective", function(obj)
		setObjective(obj)
		updateVisibility()
	end)
	State.on("party", setParty)
	State.on("profile", function(p)
		setParty(p.party)
	end)
	State.on("menu", updateVisibility)
	State.on("cinematic", updateVisibility)

	Net.get("Notify").OnClientEvent:Connect(function(text, kind)
		HUD.toast(text, kind)
	end)
	Net.get("Hint").OnClientEvent:Connect(function(hintId)
		HUD.hint(hintId)
	end)
	Net.get("BossBar").OnClientEvent:Connect(function(name, fraction)
		if not name then
			bossFrame.Visible = false
			return
		end
		bossFrame.Visible = true
		bossName.Text = string.upper(name)
		UI.tween(bossFill, 0.2, { Size = UDim2.fromScale(math.clamp(fraction or 1, 0, 1), 1) })
	end)

	player.CharacterAdded:Connect(function(character)
		deathLabel.Visible = false
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid then
			humanoid.Died:Connect(function()
				if not State.inMenu then
					deathLabel.Visible = true
				end
			end)
		end
	end)
	State.on("menu", function()
		deathLabel.Visible = false
	end)

	RunService.Heartbeat:Connect(step)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">Input</string><ProtectedString name="Source"><![CDATA[--[[
	Input - gameplay controls for keyboard, gamepad and touch.
	ContextActionService creates native touch buttons (RUN, LIGHT) next
	to the jump button on phones/tablets. Bindings only exist while the
	player is in gameplay (not in menus or cinematics).
	PC: Shift = sprint, F = flashlight, Tab = bag, M = map.
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local State = require(script.Parent:WaitForChild("State"))

local Input = {}
local bound = false
local sprintToggled = false
local handlers = {}

function Input.on(action, cb)
	handlers[action] = cb
end

local function setSprint(on)
	Net.get("SetSprint"):FireServer(on)
end

local function onSprint(_, state, input)
	if input.UserInputType == Enum.UserInputType.Touch then
		if state == Enum.UserInputState.Begin then
			sprintToggled = not sprintToggled
			setSprint(sprintToggled)
			ContextActionService:SetTitle("PZ_Sprint", sprintToggled and "WALK" or "RUN")
		end
		return Enum.ContextActionResult.Sink
	end
	if state == Enum.UserInputState.Begin then
		setSprint(true)
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		setSprint(false)
	end
	return Enum.ContextActionResult.Sink
end

local function onLight(_, state)
	if state == Enum.UserInputState.Begin then
		Net.get("ToggleFlashlight"):FireServer()
	end
	return Enum.ContextActionResult.Sink
end

local function onBag(_, state)
	if state == Enum.UserInputState.Begin and handlers.bag then
		handlers.bag()
	end
	return Enum.ContextActionResult.Sink
end

local function onMap(_, state)
	if state == Enum.UserInputState.Begin and handlers.map then
		handlers.map()
	end
	return Enum.ContextActionResult.Sink
end

local function bind()
	if bound then
		return
	end
	bound = true
	ContextActionService:BindAction("PZ_Sprint", onSprint, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("PZ_Sprint", sprintToggled and "WALK" or "RUN")
	ContextActionService:SetPosition("PZ_Sprint", UDim2.new(1, -190, 1, -105))
	ContextActionService:BindAction("PZ_Light", onLight, true, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("PZ_Light", "LIGHT")
	ContextActionService:SetPosition("PZ_Light", UDim2.new(1, -150, 1, -170))
	ContextActionService:BindAction("PZ_Bag", onBag, false, Enum.KeyCode.Tab, Enum.KeyCode.ButtonSelect)
	ContextActionService:BindAction("PZ_Map", onMap, false, Enum.KeyCode.M)
end

local function unbind()
	if not bound then
		return
	end
	bound = false
	for _, name in ipairs({ "PZ_Sprint", "PZ_Light", "PZ_Bag", "PZ_Map" }) do
		ContextActionService:UnbindAction(name)
	end
	if sprintToggled then
		sprintToggled = false
	end
	setSprint(false)
end

local function refresh()
	if State.inMenu or State.inCinematic or State.modalOpen then
		unbind()
	else
		bind()
	end
end

function Input.refresh()
	refresh()
end

function Input.init()
	State.on("menu", refresh)
	State.on("cinematic", refresh)
	State.on("modal", refresh)
end

return Input
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">Inventory</string><ProtectedString name="Source"><![CDATA[--[[
	Inventory - BAG screen with four tabs:
	  ITEMS  consumables (use), equipment and shared party key items
	  FILES  story documents and hidden research files (readable)
	  STYLE  cosmetics (equip) and emotes (play)
	  AWARDS achievements
	Also hosts the document reader used when a file is picked up.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Items = require(Shared:WaitForChild("Items"))
local Documents = require(Shared:WaitForChild("Documents"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Achievements = require(Shared:WaitForChild("Achievements"))
local Config = require(Shared:WaitForChild("Config"))

local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))

local Inventory = {}
local T = UI.Theme
local player = Players.LocalPlayer

local gui, overlay, body, content, tabButtons
local readerOverlay, readerTitle, readerText
local currentTab = "ITEMS"

local function clear()
	for _, c in ipairs(content:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
end

local function row(height, order)
	local f = UI.panel({ Size = UDim2.new(1, -10, 0, height or 64), BackgroundColor3 = T.PanelLight, BackgroundTransparency = 0.2, LayoutOrder = order or 0, Parent = content })
	UI.padding(10).Parent = f
	return f
end

local function header(text, order)
	UI.label({ Size = UDim2.new(1, 0, 0, 26), Text = text, Font = T.FontBlack, TextSize = 15, TextColor3 = T.Accent, LayoutOrder = order, Parent = content })
end

function Inventory.read(title, text)
	readerTitle.Text = title
	readerText.Text = text
	readerOverlay.Visible = true
	State.modalOpen = true
	State.emit("modal", true)
end

local function docText(id)
	local doc = Documents[id]
	local profile = State.profile
	local code = profile and profile.code or "????"
	return (doc.text:gsub("{CODE}", code or "????"))
end

local function playEmote(cosmeticId)
	local def = Cosmetics[cosmeticId]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	local animId = def and Config.Animations.Emotes[def.anim]
	if not animator or not animId then
		return
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action
		track:Play()
	end
end

local renderers = {}

renderers.ITEMS = function(profile)
	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end
	header("SUPPLIES", nextOrder())
	local any = false
	for id, count in pairs(profile.inventory or {}) do
		local def = Items[id]
		if def and count > 0 then
			any = true
			local r = row(64, nextOrder())
			UI.label({ Size = UDim2.new(1, -120, 0, 22), Text = def.name .. "  x" .. count, Font = T.FontBold, Parent = r })
			UI.label({ Size = UDim2.new(1, -120, 0, 20), Position = UDim2.fromOffset(0, 22), Text = def.description, TextSize = 14, TextColor3 = T.SubText, Parent = r })
			UI.button({ Text = "USE", Size = UDim2.fromOffset(100, 40), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Style = "primary", Parent = r }, function()
				Net.get("UseItem"):FireServer(id)
			end)
		end
	end
	if not any then
		UI.label({ Size = UDim2.new(1, 0, 0, 24), Text = "No supplies. Search rooms for bandages and medkits.", TextColor3 = T.SubText, TextSize = 15, LayoutOrder = nextOrder(), Parent = content })
	end
	header("EQUIPMENT", nextOrder())
	for id in pairs(profile.equipment or {}) do
		local def = Items[id]
		if def then
			local r = row(56, nextOrder())
			UI.label({ Size = UDim2.new(1, 0, 0, 20), Text = def.name, Font = T.FontBold, Parent = r })
			UI.label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 20), Text = def.description, TextSize = 14, TextColor3 = T.SubText, Parent = r })
		end
	end
	header("PARTY KEY ITEMS (shared with your team)", nextOrder())
	local anyKey = false
	for id, count in pairs(State.party or {}) do
		local def = Items[id]
		if def and count > 0 then
			anyKey = true
			local r = row(56, nextOrder())
			UI.label({ Size = UDim2.new(1, 0, 0, 20), Text = def.name, Font = T.FontBold, TextColor3 = def.color, Parent = r })
			UI.label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 20), Text = def.description, TextSize = 14, TextColor3 = T.SubText, Parent = r })
		end
	end
	if not anyKey then
		UI.label({ Size = UDim2.new(1, 0, 0, 24), Text = "None.", TextColor3 = T.SubText, TextSize = 15, LayoutOrder = nextOrder(), Parent = content })
	end
end

renderers.FILES = function(profile)
	local found = 0
	for i, id in ipairs(Documents.Order) do
		local doc = Documents[id]
		local owned = profile.documents and profile.documents[id]
		if doc.kind == "research" and owned then
			found = found + 1
		end
		local r = row(56, i + 1)
		local label = owned and doc.title or (doc.kind == "research" and "??? Hidden research file" or "??? Not found yet")
		UI.label({ Size = UDim2.new(1, -120, 1, 0), Text = label, Font = owned and T.FontBold or T.Font, TextColor3 = owned and (doc.kind == "research" and T.Accent or T.Text) or T.SubText, Parent = r })
		if owned then
			UI.button({ Text = "READ", Size = UDim2.fromOffset(100, 38), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = r }, function()
				Inventory.read(doc.title, docText(id))
			end)
		end
	end
	header(("RESEARCH FILES FOUND: %d / %d"):format(found, #Documents.ResearchChapter1), 1)
end

renderers.STYLE = function(profile)
	local order = 0
	local owned = profile.cosmetics and profile.cosmetics.owned or {}
	local equipped = profile.cosmetics and profile.cosmetics.equipped or {}
	for _, category in ipairs(Cosmetics.Categories) do
		order = order + 1
		header(string.upper(Cosmetics.CategoryNames[category]), order)
		local ids = {}
		for id, def in pairs(Cosmetics) do
			if type(def) == "table" and def.category == category then
				table.insert(ids, id)
			end
		end
		table.sort(ids)
		for _, id in ipairs(ids) do
			local def = Cosmetics[id]
			order = order + 1
			local r = row(52, order)
			local has = owned[id] == true
			local sourceText = ({ default = "Default", daily = "Daily reward", achievement = "Achievement reward", vip = "VIP", product = "Shop" })[def.source] or ""
			UI.label({ Size = UDim2.new(1, -130, 0, 20), Text = def.name, Font = T.FontBold, TextColor3 = has and (def.color or T.Text) or T.SubText, Parent = r })
			UI.label({ Size = UDim2.new(1, -130, 0, 16), Position = UDim2.fromOffset(0, 20), Text = has and sourceText or ("Locked - " .. sourceText), TextSize = 13, TextColor3 = T.SubText, Parent = r })
			if has then
				local isEquipped = equipped[category] == id
				if category == "emote" then
					UI.button({ Text = "PLAY", Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = r }, function()
						playEmote(id)
					end)
				else
					UI.button({ Text = isEquipped and "EQUIPPED" or "EQUIP", Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Style = isEquipped and "ghost" or "primary", Parent = r }, function()
						Net.get("EquipCosmetic"):FireServer(id)
					end)
				end
			end
		end
	end
end

renderers.AWARDS = function(profile)
	local ids = {}
	for id in pairs(Achievements) do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		return Achievements[a].order < Achievements[b].order
	end)
	local got = 0
	for i, id in ipairs(ids) do
		local def = Achievements[id]
		local has = profile.achievements and profile.achievements[id] ~= nil
		if has then
			got = got + 1
		end
		local r = row(56, i + 1)
		UI.label({ Size = UDim2.new(1, 0, 0, 20), Text = (has and "[X] " or "[  ] ") .. def.name, Font = T.FontBold, TextColor3 = has and T.Accent or T.SubText, Parent = r })
		local rewardText = def.reward and Cosmetics[def.reward] and ("  - Reward: " .. Cosmetics[def.reward].name) or ""
		UI.label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 20), Text = def.description .. rewardText, TextSize = 14, TextColor3 = T.SubText, Parent = r })
	end
	header(("ACHIEVEMENTS: %d / %d"):format(got, #ids), 1)
end

local function render()
	if not overlay.Visible or not State.profile then
		return
	end
	clear()
	for name, btn in pairs(tabButtons) do
		btn.BackgroundColor3 = name == currentTab and T.Accent or T.PanelLight
		btn.TextColor3 = name == currentTab and Color3.fromRGB(20, 20, 20) or T.Text
	end
	renderers[currentTab](State.profile)
end

function Inventory.open(tab)
	currentTab = tab or currentTab
	overlay.Visible = true
	State.modalOpen = true
	State.emit("modal", true)
	render()
end

function Inventory.close()
	overlay.Visible = false
	State.modalOpen = false
	State.emit("modal", false)
end

function Inventory.toggle()
	if overlay.Visible then
		Inventory.close()
	else
		Inventory.open()
	end
end

function Inventory.init()
	gui = UI.screen("PZ_Inventory", 45)
	overlay, body = UI.modal(gui, "BAG", 820, 560, function()
		State.modalOpen = false
		State.emit("modal", false)
	end)
	local tabs = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = body })
	UI.list(Enum.FillDirection.Horizontal, 8).Parent = tabs
	tabButtons = {}
	for i, name in ipairs({ "ITEMS", "FILES", "STYLE", "AWARDS" }) do
		tabButtons[name] = UI.button({ Text = name, Size = UDim2.fromOffset(130, 40), LayoutOrder = i, Parent = tabs }, function()
			currentTab = name
			render()
		end)
	end
	content = UI.scroll({ Size = UDim2.new(1, 0, 1, -54), Position = UDim2.fromOffset(0, 54), Parent = body })
	UI.list(Enum.FillDirection.Vertical, 6).Parent = content

	-- document reader
	local readerBody
	readerOverlay, readerBody = UI.modal(gui, "DOCUMENT", 700, 520, function()
		if not overlay.Visible then
			State.modalOpen = false
			State.emit("modal", false)
		end
	end)
	readerOverlay.ZIndex = 20
	readerTitle = UI.label({ Size = UDim2.new(1, 0, 0, 30), Font = T.FontBlack, TextSize = 20, Parent = readerBody })
	local scroll = UI.scroll({ Size = UDim2.new(1, 0, 1, -40), Position = UDim2.fromOffset(0, 40), Parent = readerBody })
	readerText = UI.label({ Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.SourceSans, TextSize = 21, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Color3.fromRGB(225, 220, 205), Parent = scroll })

	State.on("profile", render)
	State.on("party", render)
	Net.get("ReadDocument").OnClientEvent:Connect(function(_, title, text)
		Inventory.read(title, text)
	end)
end

return Inventory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">Keypad</string><ProtectedString name="Source"><![CDATA[--[[
	Keypad - 4-digit code entry for locked doors. Big touch-friendly keys.
	The server checks the code; the client only collects digits.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))

local Keypad = {}
local T = UI.Theme

local gui, overlay, display
local entered = ""
local currentDoor = nil

local function refresh(color)
	local shown = entered .. string.rep("_", 4 - #entered)
	display.Text = shown:gsub(".", "%0 ")
	display.TextColor3 = color or T.Text
end

local function close()
	overlay.Visible = false
	State.modalOpen = false
	State.emit("modal", false)
end

local function press(key)
	if key == "C" then
		entered = ""
	elseif key == "OK" then
		if #entered == 4 and currentDoor then
			Net.get("KeypadSubmit"):FireServer(currentDoor, entered)
		end
		return
	elseif #entered < 4 then
		entered = entered .. key
	end
	refresh()
end

function Keypad.init()
	gui = UI.screen("PZ_Keypad", 25)
	local body
	overlay, body = UI.modal(gui, "SECURITY KEYPAD", 360, 470, function()
		State.modalOpen = false
		State.emit("modal", false)
	end)
	display = UI.label({
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(8, 20, 12),
		Font = Enum.Font.Code,
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = body,
	})
	UI.corner(8).Parent = display
	local grid = UI.new("Frame", { Size = UDim2.new(1, 0, 1, -66), Position = UDim2.fromOffset(0, 66), BackgroundTransparency = 1, Parent = body })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0.31, 0, 0, 70), CellPadding = UDim2.new(0.035, 0, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	local keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "OK" }
	for i, k in ipairs(keys) do
		UI.button({ Text = k, LayoutOrder = i, TextSize = 26, Style = k == "OK" and "primary" or (k == "C" and "danger" or "secondary"), Parent = grid }, function()
			press(k)
		end)
	end

	Net.get("KeypadOpen").OnClientEvent:Connect(function(doorId)
		currentDoor = doorId
		entered = ""
		refresh()
		overlay.Visible = true
		State.modalOpen = true
		State.emit("modal", true)
	end)
	Net.get("KeypadResult").OnClientEvent:Connect(function(ok)
		if ok then
			refresh(T.Good)
			task.wait(0.6)
			close()
		else
			refresh(T.Danger)
			task.wait(0.6)
			entered = ""
			refresh()
		end
	end)
end

return Keypad
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">MapUI</string><ProtectedString name="Source"><![CDATA[--[[
	MapUI - full-screen tactical map drawn from shared Layout data:
	named zones, your position (arrow), teammates and the objective.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Layout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Layout"))
local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))

local MapUI = {}
local T = UI.Theme
local player = Players.LocalPlayer

local gui, overlay, mapFrame, objectiveDot
local markers = {}
local B = Layout.WorldBounds

local function toMap(pos)
	local x = (pos.X - B.minX) / (B.maxX - B.minX)
	local y = 1 - (pos.Z - B.minZ) / (B.maxZ - B.minZ)
	return UDim2.fromScale(math.clamp(x, 0, 1), math.clamp(y, 0, 1))
end

local function marker(name, color, size)
	local m = UI.new("Frame", {
		Name = name,
		Size = UDim2.fromOffset(size, size),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = mapFrame,
	})
	UI.corner(size).Parent = m
	UI.stroke(Color3.new(0, 0, 0), 2, 0).Parent = m
	return m
end

local function update()
	local seen = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local character = p.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			seen[p] = true
			local m = markers[p]
			if not m then
				m = marker(p.Name, p == player and T.Accent or T.Info, p == player and 16 or 12)
				UI.label({ Size = UDim2.fromOffset(120, 16), Position = UDim2.new(0.5, 0, 0, -18), AnchorPoint = Vector2.new(0.5, 0), Text = p.DisplayName, TextSize = 12, Font = T.FontBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 6, Parent = m })
				markers[p] = m
			end
			m.Position = toMap(root.Position)
			m.Rotation = -root.Orientation.Y
		end
	end
	for p, m in pairs(markers) do
		if not seen[p] then
			m:Destroy()
			markers[p] = nil
		end
	end
	local obj = State.objective
	if obj and obj.target then
		objectiveDot.Visible = true
		objectiveDot.Position = toMap(obj.target)
	else
		objectiveDot.Visible = false
	end
end

function MapUI.toggle()
	overlay.Visible = not overlay.Visible
	State.modalOpen = overlay.Visible
	State.emit("modal", overlay.Visible)
	if overlay.Visible then
		task.spawn(function()
			while overlay.Visible do
				update()
				task.wait(0.2)
			end
		end)
	end
end

function MapUI.init()
	gui = UI.screen("PZ_Map", 30)
	local body
	overlay, body = UI.modal(gui, "MAP - ASHFORD BAY", 640, 640, function()
		State.modalOpen = false
		State.emit("modal", false)
	end)
	mapFrame = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(14, 16, 18),
		BorderSizePixel = 0,
		Parent = body,
	})
	UI.new("UIAspectRatioConstraint", {
		AspectRatio = (B.maxX - B.minX) / (B.maxZ - B.minZ),
		Parent = mapFrame,
	})
	UI.corner(8).Parent = mapFrame
	for _, zone in ipairs(Layout.Zones) do
		local topLeft = toMap(Vector3.new(zone.minX, 0, zone.maxZ))
		local w = (zone.maxX - zone.minX) / (B.maxX - B.minX)
		local h = (zone.maxZ - zone.minZ) / (B.maxZ - B.minZ)
		local f = UI.new("Frame", {
			Position = topLeft,
			Size = UDim2.fromScale(w, h),
			BackgroundColor3 = zone.color,
			BackgroundTransparency = 0.45,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = mapFrame,
		})
		UI.stroke(zone.color, 1, 0.2).Parent = f
		UI.label({ Size = UDim2.fromScale(1, 1), Text = zone.name, TextSize = 11, Font = T.FontBold, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, ZIndex = 3, Parent = f })
	end
	objectiveDot = marker("Objective", T.Danger, 14)
	UI.label({ Size = UDim2.fromOffset(90, 16), Position = UDim2.new(0.5, 0, 1, 2), AnchorPoint = Vector2.new(0.5, 0), Text = "OBJECTIVE", TextSize = 11, Font = T.FontBlack, TextColor3 = T.Danger, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 6, Parent = objectiveDot })
end

return MapUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[--[[
	Menu - main menu (PLAY, CHAPTERS, INVENTORY, SETTINGS, SHOP, DAILY,
	INVITE, CREDITS), pause menu, chapter-complete summary.
	A slow cinematic camera drifts over the ruined city behind the menu.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SocialService = game:GetService("SocialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Layout = require(Shared:WaitForChild("Layout"))
local Chapters = require(Shared:WaitForChild("Chapters"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))
local Effects = require(script.Parent:WaitForChild("Effects"))

local Menu = {}
local T = UI.Theme
local player = Players.LocalPlayer

local gui, root, playPanel, continueButton, statusLabel, dailyButton
local chaptersOverlay, chaptersBody
local settingsOverlay, settingsBody
local shopOverlay, shopBody
local creditsOverlay
local pauseOverlay
local summaryOverlay, summaryBody
local openInventory -- set by ClientMain
local cameraConn

-- Menu camera ------------------------------------------------------------------------------
local function startCamera()
	if cameraConn then
		return
	end
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 55
	local started = os.clock()
	cameraConn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - started
		local base = Layout.MenuCamera.position
		local offset = Vector3.new(math.sin(t * 0.05) * 25, math.sin(t * 0.13) * 2, math.cos(t * 0.05) * 10)
		camera.CFrame = CFrame.lookAt(base + offset, Layout.MenuCamera.lookAt)
	end)
end

local function stopCamera()
	if cameraConn then
		cameraConn:Disconnect()
		cameraConn = nil
	end
	local camera = workspace.CurrentCamera
	camera.FieldOfView = 70
	camera.CameraType = Enum.CameraType.Custom
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- Visibility -----------------------------------------------------------------------------------
function Menu.show()
	State.inMenu = true
	State.emit("menu", true)
	root.Visible = true
	playPanel.Visible = false
	pauseOverlay.Visible = false
	startCamera()
	Effects.setMusic("MusicMenu")
end

function Menu.hide()
	State.inMenu = false
	State.emit("menu", false)
	root.Visible = false
	stopCamera()
	Effects.setMusic("MusicTension")
end

local function requestPlay(mode)
	Menu.hide()
	chaptersOverlay.Visible = false
	summaryOverlay.Visible = false
	Net.get("RequestPlay"):FireServer(mode)
	-- safety net: if the server could not start (e.g. chapter ending), return to menu
	task.delay(10, function()
		if not State.inMenu and not player.Character then
			Menu.show()
		end
	end)
end

local function refreshProfile(p)
	local ch = p.chapters and p.chapters.ch1
	local stage = ch and ch.checkpointStage or 1
	local cpName = "Ward 3B"
	local st = Chapters.Chapter1[stage]
	if st then
		cpName = Layout.Checkpoints[st.checkpoint].name
	end
	continueButton.Text = stage > 1 and ("CONTINUE  -  " .. cpName) or "START CHAPTER 1"
	local lines = {}
	if p.memoryMode then
		table.insert(lines, "Studio test mode: progress is NOT saved (enable API access to test saving).")
	end
	if ch and ch.completed then
		table.insert(lines, ("Chapter 1 complete x%d  |  Best time %s"):format(ch.completions or 1, Util.formatTime(ch.bestTime)))
	end
	table.insert(lines, Config.Version)
	statusLabel.Text = table.concat(lines, "\n")
	dailyButton.Text = p.dailyAvailable and "DAILY REWARD  (READY!)" or "DAILY REWARD"
	dailyButton.TextColor3 = p.dailyAvailable and T.Accent or T.Text
end

-- Sub screens --------------------------------------------------------------------------------------
local function buildChapters()
	chaptersOverlay, chaptersBody = UI.modal(gui, "CHAPTERS", 760, 560)
	local scroll = UI.scroll({ Size = UDim2.fromScale(1, 1), Parent = chaptersBody })
	UI.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	for i, ch in ipairs(Chapters.List) do
		local card = UI.panel({ Size = UDim2.new(1, -10, 0, 84), BackgroundColor3 = T.PanelLight, LayoutOrder = i, Parent = scroll })
		UI.padding(12).Parent = card
		UI.label({ Size = UDim2.new(1, -170, 0, 26), Text = ("CHAPTER %d - %s"):format(ch.number, string.upper(ch.title)), Font = T.FontBlack, TextSize = 19, TextColor3 = ch.playable and T.Text or T.SubText, Parent = card })
		UI.label({ Size = UDim2.new(1, -170, 0, 22), Position = UDim2.fromOffset(0, 30), Text = ch.subtitle, TextSize = 15, TextColor3 = T.SubText, Parent = card })
		if ch.playable then
			UI.button({ Text = "PLAY", Size = UDim2.fromOffset(150, 46), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Style = "primary", Parent = card }, function()
				requestPlay("new")
			end)
		else
			UI.label({ Size = UDim2.fromOffset(150, 46), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Text = "IN DEVELOPMENT", TextSize = 14, Font = T.FontBold, TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
		end
	end
end

local settingsState = {}
local function buildSettings()
	settingsOverlay, settingsBody = UI.modal(gui, "SETTINGS", 640, 520, function()
		Net.get("SaveSettings"):FireServer(settingsState)
	end)
	local scroll = UI.scroll({ Size = UDim2.fromScale(1, 1), Parent = settingsBody })
	UI.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	local rows = {}

	local function addRow(order, label, getText, onPress)
		local r = UI.panel({ Size = UDim2.new(1, -10, 0, 58), BackgroundColor3 = T.PanelLight, LayoutOrder = order, Parent = scroll })
		UI.padding(10).Parent = r
		UI.label({ Size = UDim2.new(0.5, 0, 1, 0), Text = label, Font = T.FontBold, Parent = r })
		local btn = UI.button({ Text = getText(), Size = UDim2.fromOffset(200, 40), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = r }, function(b)
			onPress()
			b.Text = getText()
		end)
		table.insert(rows, function()
			btn.Text = getText()
		end)
	end

	local graphics = { "Auto", "Low", "Medium", "High" }
	addRow(1, "Graphics quality", function()
		return settingsState.graphics or "Auto"
	end, function()
		local i = table.find(graphics, settingsState.graphics or "Auto") or 1
		settingsState.graphics = graphics[(i % #graphics) + 1]
		Effects.applyGraphics(settingsState.graphics)
	end)
	local function volumeRow(order, key, label)
		addRow(order, label, function()
			return ("%d%%"):format(math.floor((settingsState[key] or 0) * 100 + 0.5))
		end, function()
			local v = (settingsState[key] or 0) + 0.2
			if v > 1.01 then
				v = 0
			end
			settingsState[key] = math.clamp(v, 0, 1)
			if State.profile then
				State.profile.settings[key] = settingsState[key]
			end
		end)
	end
	volumeRow(2, "music", "Music volume")
	volumeRow(3, "sfx", "Effects volume")
	local function toggleRow(order, key, label)
		addRow(order, label, function()
			return settingsState[key] and "ON" or "OFF"
		end, function()
			settingsState[key] = not settingsState[key]
			if State.profile then
				State.profile.settings[key] = settingsState[key]
			end
		end)
	end
	toggleRow(4, "subtitles", "Subtitles")
	toggleRow(5, "cameraShake", "Camera shake")
	toggleRow(6, "tutorials", "Tutorial hints")

	State.on("profile", function(p)
		if p.settings and not settingsOverlay.Visible then
			for k, v in pairs(p.settings) do
				settingsState[k] = v
			end
			for _, refresh in ipairs(rows) do
				refresh()
			end
		end
	end)
end

local function buildShop()
	shopOverlay, shopBody = UI.modal(gui, "SHOP - COSMETICS ONLY", 700, 540)
	local note = UI.label({ Size = UDim2.new(1, 0, 0, 40), Text = "Everything here is cosmetic. The full story, every chapter and all gameplay are free for everyone.", TextSize = 14, TextColor3 = T.SubText, Parent = shopBody })
	local scroll = UI.scroll({ Size = UDim2.new(1, 0, 1, -48), Position = UDim2.fromOffset(0, 48), Parent = shopBody })
	UI.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	local function render(p)
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local catalog = p.catalog or {}
		if #catalog == 0 then
			local empty = UI.panel({ Size = UDim2.new(1, -10, 0, 70), BackgroundColor3 = T.PanelLight, Parent = scroll })
			UI.padding(12).Parent = empty
			UI.label({ Size = UDim2.fromScale(1, 1), Text = "The shop is not open yet. (Developer: add Game Pass / Product IDs in Config.lua)", TextColor3 = T.SubText, Parent = empty })
			return
		end
		for i, item in ipairs(catalog) do
			local card = UI.panel({ Size = UDim2.new(1, -10, 0, 78), BackgroundColor3 = T.PanelLight, LayoutOrder = i, Parent = scroll })
			UI.padding(12).Parent = card
			UI.label({ Size = UDim2.new(1, -170, 0, 24), Text = item.name, Font = T.FontBlack, TextSize = 18, Parent = card })
			local names = {}
			for _, id in ipairs(item.cosmetics or {}) do
				table.insert(names, Cosmetics[id] and Cosmetics[id].name or id)
			end
			UI.label({ Size = UDim2.new(1, -170, 0, 30), Position = UDim2.fromOffset(0, 26), Text = table.concat(names, ", "), TextSize = 14, TextColor3 = T.SubText, Parent = card })
			local owned = item.gamepass and p.vip
			UI.button({
				Text = owned and "OWNED" or (item.gamepass and "GET VIP" or ("R$ " .. tostring(item.price or ""))),
				Size = UDim2.fromOffset(150, 44),
				Position = UDim2.new(1, 0, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				Style = owned and "ghost" or "primary",
				Parent = card,
			}, function()
				if not owned then
					Net.get("BuyProduct"):FireServer(item.key)
				end
			end)
		end
	end
	note.LayoutOrder = 0
	State.on("profile", render)
end

local function buildCredits()
	local body
	creditsOverlay, body = UI.modal(gui, "CREDITS", 600, 460)
	local scroll = UI.scroll({ Size = UDim2.fromScale(1, 1), Parent = body })
	UI.label({
		Size = UDim2.new(1, -12, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 17,
		Text = "PROJECT: ZERO\n\nAn original story-driven survival adventure.\n\n"
			.. "Story, design, code and world: built procedurally from original code - no third-party models.\n"
			.. "Animations: Roblox standard animation packages.\n"
			.. "Sounds: Roblox built-in sound library.\n\n"
			.. "Characters: Maya Torres, Dr. Elias Voss, The Warden.\n\n"
			.. "Thank you for playing. Chapter 2 is in development.",
		Parent = scroll,
	})
end

local function buildPause()
	local body
	pauseOverlay, body = UI.modal(gui, "PAUSED", 400, 380, function()
		State.modalOpen = false
		State.emit("modal", false)
	end)
	pauseOverlay.ZIndex = 9
	UI.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center).Parent = body
	UI.button({ Text = "RESUME", Size = UDim2.new(1, 0, 0, 52), Style = "primary", LayoutOrder = 1, Parent = body }, function()
		pauseOverlay.Visible = false
		State.modalOpen = false
		State.emit("modal", false)
	end)
	UI.button({ Text = "SETTINGS", Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 2, Parent = body }, function()
		settingsOverlay.Visible = true
	end)
	UI.button({ Text = "INVITE FRIENDS", Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 3, Parent = body }, function()
		Menu.invite()
	end)
	UI.button({ Text = "QUIT TO MAIN MENU", Size = UDim2.new(1, 0, 0, 52), Style = "danger", LayoutOrder = 4, Parent = body }, function()
		pauseOverlay.Visible = false
		State.modalOpen = false
		State.emit("modal", false)
		Net.get("ReturnToMenu"):FireServer()
	end)
	-- pause overlay sits on its own gui so it can show during gameplay
end

local function buildSummary()
	summaryOverlay, summaryBody = UI.modal(gui, "CHAPTER COMPLETE", 620, 480, function()
		Menu.show()
	end)
	Net.get("ChapterComplete").OnClientEvent:Connect(function(s)
		for _, c in ipairs(summaryBody:GetChildren()) do
			c:Destroy()
		end
		UI.list(Enum.FillDirection.Vertical, 8).Parent = summaryBody
		local function line(text, color, order, size)
			UI.label({ Size = UDim2.new(1, 0, 0, size or 28), Text = text, TextSize = size and 22 or 18, Font = size and T.FontBlack or T.Font, TextColor3 = color or T.Text, LayoutOrder = order, Parent = summaryBody })
		end
		line(("CHAPTER %d: %s"):format(s.chapter, string.upper(s.title)), T.Accent, 1, 34)
		line("Time: " .. Util.formatTime(s.time), nil, 2)
		line("Infected stopped: " .. tostring(s.kills), nil, 3)
		line(("Research files: %d / %d"):format(s.files, s.filesTotal), nil, 4)
		local trustText = s.trust >= 3 and "Maya trusts you completely." or (s.trust >= 1 and "Maya trusts you." or "Maya is still wary of you.")
		line(trustText, T.SubText, 5)
		line("Your choices are saved and will matter in later chapters.", T.SubText, 6)
		local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, LayoutOrder = 7, Parent = summaryBody })
		UI.list(Enum.FillDirection.Horizontal, 10).Parent = row
		UI.button({ Text = "REPLAY CHAPTER", Size = UDim2.fromOffset(260, 52), Style = "primary", LayoutOrder = 1, Parent = row }, function()
			requestPlay("new")
		end)
		UI.button({ Text = "MAIN MENU", Size = UDim2.fromOffset(260, 52), LayoutOrder = 2, Parent = row }, function()
			summaryOverlay.Visible = false
			Menu.show()
		end)
		State.inMenu = true
		State.emit("menu", true)
		summaryOverlay.Visible = true
		startCamera()
	end)
end

function Menu.invite()
	local ok, canInvite = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if ok and canInvite then
		pcall(function()
			SocialService:PromptGameInvite(player)
		end)
	end
end

function Menu.openPause()
	pauseOverlay.Visible = true
	State.modalOpen = true
	State.emit("modal", true)
end

function Menu.setInventoryOpener(fn)
	openInventory = fn
end

local function build()
	gui = UI.screen("PZ_Menu", 40, true)
	root = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	local shade = UI.new("Frame", { Size = UDim2.fromScale(0.55, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = root })
	UI.new("UIGradient", { Transparency = NumberSequence.new(0.1, 1), Parent = shade })

	local column = UI.new("Frame", { Size = UDim2.new(0, 360, 1, -60), Position = UDim2.fromOffset(60, 30), BackgroundTransparency = 1, Parent = root })
	UI.label({ Size = UDim2.new(1, 0, 0, 64), Text = "PROJECT: ZERO", Font = T.FontBlack, TextSize = 52, Parent = column })
	UI.label({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(2, 64), Text = "THE CURE WAS NEVER MEANT FOR THIS YEAR", TextSize = 13, Font = T.FontBold, TextColor3 = T.Accent, Parent = column })

	local buttons = UI.new("Frame", { Size = UDim2.new(1, 0, 1, -170), Position = UDim2.fromOffset(0, 110), BackgroundTransparency = 1, Parent = column })
	UI.list(Enum.FillDirection.Vertical, 6).Parent = buttons
	local function menuButton(order, text, style, cb)
		return UI.button({ Text = text, Size = UDim2.new(1, 0, 0, 42), Style = style, LayoutOrder = order, TextSize = 18, Parent = buttons }, cb)
	end
	menuButton(1, "PLAY", "primary", function()
		playPanel.Visible = not playPanel.Visible
	end)
	menuButton(2, "CHAPTERS", "secondary", function()
		chaptersOverlay.Visible = true
	end)
	menuButton(3, "INVENTORY", "secondary", function()
		if openInventory then
			openInventory()
		end
	end)
	menuButton(4, "SETTINGS", "secondary", function()
		settingsOverlay.Visible = true
	end)
	menuButton(5, "SHOP", "secondary", function()
		shopOverlay.Visible = true
	end)
	dailyButton = menuButton(6, "DAILY REWARD", "secondary", function()
		Net.get("ClaimDaily"):FireServer()
	end)
	menuButton(7, "INVITE FRIENDS", "secondary", Menu.invite)
	menuButton(8, "CREDITS", "ghost", function()
		creditsOverlay.Visible = true
	end)

	playPanel = UI.panel({ Size = UDim2.fromOffset(360, 130), Position = UDim2.new(0, 440, 0, 140), Visible = false, Parent = root })
	UI.padding(12).Parent = playPanel
	UI.list(Enum.FillDirection.Vertical, 8).Parent = playPanel
	continueButton = UI.button({ Text = "START CHAPTER 1", Size = UDim2.new(1, 0, 0, 48), Style = "primary", LayoutOrder = 1, Parent = playPanel }, function()
		requestPlay("continue")
	end)
	UI.button({ Text = "NEW GAME (restart Chapter 1)", Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 2, Parent = playPanel }, function()
		requestPlay("new")
	end)

	statusLabel = UI.label({ Size = UDim2.new(0, 520, 0, 60), Position = UDim2.new(0, 60, 1, -20), AnchorPoint = Vector2.new(0, 1), TextSize = 13, TextColor3 = T.SubText, TextYAlignment = Enum.TextYAlignment.Bottom, Parent = root })

	buildChapters()
	buildSettings()
	buildShop()
	buildCredits()
	buildPause()
	buildSummary()
end

function Menu.init()
	build()
	State.on("profile", refreshProfile)
	Net.get("ShowMenu").OnClientEvent:Connect(function()
		if not summaryOverlay.Visible then
			Menu.show()
		end
	end)
	player.CharacterAdded:Connect(function()
		if not State.inMenu and not State.inCinematic then
			task.defer(function()
				if not State.inCinematic and not State.inMenu then
					stopCamera()
				end
			end)
		end
	end)
	-- show immediately (profile arrives shortly after)
	Menu.show()
end

return Menu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--[[
	State - client-side mirror of the server snapshot + simple signals.
	The client never decides game outcomes; it only renders this state.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local State = {
	profile = nil,
	party = {},
	objective = nil,
	inMenu = true,
	inCinematic = false,
	modalOpen = false,
}

local listeners = {}

function State.on(event, callback)
	listeners[event] = listeners[event] or {}
	table.insert(listeners[event], callback)
end

function State.emit(event, ...)
	for _, cb in ipairs(listeners[event] or {}) do
		task.spawn(cb, ...)
	end
end

function State.init()
	Net.get("ProfileSync").OnClientEvent:Connect(function(snapshot)
		State.profile = snapshot
		State.party = snapshot.party or {}
		State.emit("profile", snapshot)
	end)
	Net.get("PartyInventory").OnClientEvent:Connect(function(party)
		State.party = party or {}
		State.emit("party", State.party)
	end)
	Net.get("Objective").OnClientEvent:Connect(function(text, target, stage)
		State.objective = { text = text, target = target, stage = stage }
		State.emit("objective", State.objective)
	end)
end

function State.setting(key, default)
	local p = State.profile
	if p and p.settings and p.settings[key] ~= nil then
		return p.settings[key]
	end
	return default
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--[[
	UI - tiny UI toolkit + theme for PROJECT: ZERO.
	Layouts are designed at 1280x720 and scaled by a UIScale that follows
	the screen size, so the same UI works on phones, tablets and PCs.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local UI = {}

UI.Theme = {
	Background = Color3.fromRGB(10, 12, 14),
	Panel = Color3.fromRGB(18, 21, 24),
	PanelLight = Color3.fromRGB(30, 34, 38),
	Stroke = Color3.fromRGB(70, 76, 80),
	Text = Color3.fromRGB(232, 236, 238),
	SubText = Color3.fromRGB(150, 158, 162),
	Accent = Color3.fromRGB(255, 196, 64),
	Danger = Color3.fromRGB(230, 70, 60),
	Good = Color3.fromRGB(90, 220, 130),
	Info = Color3.fromRGB(120, 190, 255),
	Health = Color3.fromRGB(220, 60, 60),
	Stamina = Color3.fromRGB(240, 200, 80),
	Font = Enum.Font.Gotham,
	FontBold = Enum.Font.GothamBold,
	FontBlack = Enum.Font.GothamBlack,
}

local player = Players.LocalPlayer

function UI.isTouch()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function UI.new(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or UI.Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

function UI.list(direction, gap, align)
	return UI.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

-- ScreenGui with automatic scale for every device.
function UI.screen(name, displayOrder, fullscreen)
	local gui = UI.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		DisplayOrder = displayOrder or 1,
		IgnoreGuiInset = fullscreen == true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	if not fullscreen then
		pcall(function()
			gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
		end)
	end
	local scale = UI.new("UIScale", { Parent = gui })
	local function update()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local size = camera.ViewportSize
		local s = math.min(size.X / 1280, size.Y / 720)
		if UI.isTouch() then
			s = s * 1.12 -- slightly larger touch targets
		end
		scale.Scale = math.clamp(s, 0.5, 1.6)
	end
	update()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

-- Size of the visible area in "design pixels" (after UIScale).
function UI.designSize(gui)
	local scale = gui:FindFirstChildOfClass("UIScale")
	local s = scale and scale.Scale or 1
	local size = workspace.CurrentCamera.ViewportSize
	return size.X / s, size.Y / s
end

function UI.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Theme.Font,
		TextColor3 = UI.Theme.Text,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return UI.new("TextLabel", defaults)
end

function UI.panel(props, children)
	local defaults = {
		BackgroundColor3 = UI.Theme.Panel,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	local frame = UI.new("Frame", defaults, children)
	UI.corner(12).Parent = frame
	UI.stroke().Parent = frame
	return frame
end

local clickSound
local function playClick()
	if not clickSound then
		clickSound = Instance.new("Sound")
		clickSound.SoundId = Config.Sounds.UiClick
		clickSound.Volume = 0.25
		clickSound.PlaybackSpeed = 1.4
		clickSound.Parent = game:GetService("SoundService")
	end
	clickSound:Play()
end

-- Button with hover/press feedback. style: "primary" | "secondary" | "danger" | "ghost"
function UI.button(props, onClick)
	local style = props.Style or "secondary"
	local colors = {
		primary = { UI.Theme.Accent, Color3.fromRGB(20, 20, 20) },
		secondary = { UI.Theme.PanelLight, UI.Theme.Text },
		danger = { UI.Theme.Danger, Color3.new(1, 1, 1) },
		ghost = { UI.Theme.Panel, UI.Theme.SubText },
	}
	local c = colors[style] or colors.secondary
	local btn = UI.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(220, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = c[1],
		BackgroundTransparency = style == "ghost" and 0.3 or 0,
		Text = props.Text or "",
		TextColor3 = c[2],
		Font = props.Font or UI.Theme.FontBold,
		TextSize = props.TextSize or 18,
		AutoButtonColor = false,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	UI.corner(10).Parent = btn
	if style ~= "primary" then
		UI.stroke(UI.Theme.Stroke, 1, 0.4).Parent = btn
	end
	local base = btn.BackgroundColor3
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.12) }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
	end)
	btn.Activated:Connect(function()
		playClick()
		if onClick then
			onClick(btn)
		end
	end)
	return btn
end

function UI.tween(inst, time, goal, style)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

-- Modal overlay with a centred panel and a close button.
function UI.modal(gui, title, width, height, onClose)
	local overlay = UI.new("TextButton", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	local panel = UI.panel({
		Name = "Panel",
		Size = UDim2.fromOffset(width, height),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 11,
		Parent = overlay,
	})
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(width, height), Parent = panel })
	UI.label({
		Name = "Title",
		Text = title,
		Font = UI.Theme.FontBlack,
		TextSize = 26,
		Size = UDim2.new(1, -80, 0, 44),
		Position = UDim2.fromOffset(20, 10),
		TextColor3 = UI.Theme.Accent,
		ZIndex = 12,
		Parent = panel,
	})
	local close = UI.button({ Text = "X", Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -54, 0, 10), Style = "ghost", Parent = panel }, function()
		overlay.Visible = false
		if onClose then
			onClose()
		end
	end)
	close.ZIndex = 12
	local body = UI.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -40, 1, -74),
		Position = UDim2.fromOffset(20, 62),
		ZIndex = 11,
		Parent = panel,
	})
	return overlay, body, panel
end

function UI.scroll(props)
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = UI.Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return UI.new("ScrollingFrame", defaults)
end

return UI
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBX00000039"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="Script" referent="RBX00000038"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[--[[
	Replaces Roblox's default "Health" character script, which regenerates
	health quickly. PROJECT: ZERO handles healing on the server instead
	(slow passive regen up to a cap + bandages/medkits in PlayerService).
	Keeping this script (even though it does nothing) is what disables the
	default one: Roblox only inserts its own Health script when none exists.
]]
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX0000003B"><Properties><string name="Name">StarterGui</string><bool name="ShowDevelopmentGui">true</bool></Properties></Item><Item class="SoundService" referent="RBX0000003C"><Properties><string name="Name">SoundService</string></Properties></Item></roblox>
