-- Zombie spawn regions. "minStage" is the mission stage index from which the region is active.
Layout.SpawnRegions = {
	{ id = "er", center = Vector3.new(20, 0, 58), radius = 12, minStage = 3, maxStage = 5, fixed = { "Normal", "Normal", "Normal" } },
	{ id = "lobby", center = Vector3.new(65, 0, 60), radius = 14, minStage = 5, maxStage = 5, fixed = { "Normal", "Fast" } },
	{ id = "harbor_w", center = Vector3.new(10, 0, 112), radius = 22, minStage = 6, maxStage = 10, ambient = true },
	{ id = "harbor_e", center = Vector3.new(170, 0, 112), radius = 22, minStage = 6, maxStage = 10, ambient = true },
	{ id = "kessler_s", center = Vector3.new(100, 0, 150), radius = 14, minStage = 6, maxStage = 10, ambient = true },
	{ id = "kessler_n", center = Vector3.new(100, 0, 215), radius = 14, minStage = 7, maxStage = 10, ambient = true },
	{ id = "police", center = Vector3.new(45, 0, 152), radius = 10, minStage = 7, maxStage = 7, fixed = { "Heavy", "Normal" } },
	{ id = "ruins", center = Vector3.new(165, 0, 212), radius = 16, minStage = 6, maxStage = 10, fixed = { "Normal", "Fast", "Normal" } },
}

-- Camera used behind the main menu.
Layout.MenuCamera = {
	position = Vector3.new(150, 38, 60),
	lookAt = Vector3.new(80, 10, 130),
}

return Layout
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--[[
	Net
	Creates (server) and resolves (client) every RemoteEvent in one place.
	Server handlers are wrapped with a per-player rate limiter and pcall so a
	malicious or buggy client can never crash a service.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

-- Client -> Server
Net.ClientToServer = {
	"RequestPlay", -- (mode: "continue" | "new")
	"SetSprint", -- (bool)
	"ToggleFlashlight", -- ()
	"UseItem", -- (itemId)
	"DialogueChoice", -- (choiceIndex)
	"KeypadSubmit", -- (doorId, code)
	"EquipCosmetic", -- (cosmeticId)
	"ClaimDaily", -- ()
	"CinematicDone", -- (cinematicId)
	"SaveSettings", -- (settingsTable)
	"ReturnToMenu", -- ()
	"BuyProduct", -- (productKey)
}

-- Server -> Client
Net.ServerToClient = {
	"ProfileSync", -- (snapshot)
	"Objective", -- (text, position?, stage)
	"Notify", -- (text, kind)
	"Hint", -- (hintId)
	"DialogueShow", -- (node payload)
	"DialogueClose", -- ()
	"PlayCinematic", -- (id)
	"KeypadOpen", -- (doorId)
	"KeypadResult", -- (ok)
	"ReadDocument", -- (docId, text)
	"ChapterComplete", -- (summary)
	"BossBar", -- (name, fraction | nil)
	"PartyInventory", -- ({ itemId = count })
	"ShowMenu", -- ()
	"Shake", -- (intensity, duration)
}

local FOLDER_NAME = "Remotes"

local function getFolder()
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

function Net.init()
	assert(RunService:IsServer(), "Net.init is server only")
	local folder = getFolder()
	local all = {}
	for _, n in ipairs(Net.ClientToServer) do
		table.insert(all, n)
	end
	for _, n in ipairs(Net.ServerToClient) do
		table.insert(all, n)
	end
	for _, name in ipairs(all) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local cache = {}
function Net.get(name)
	local remote = cache[name]
	if remote then
		return remote
	end
	local folder = getFolder()
	remote = folder:WaitForChild(name, 30)
	assert(remote, "Missing remote: " .. tostring(name))
	cache[name] = remote
	return remote
end

-- Server: connect with rate limiting. maxPerSecond defaults to 8.
function Net.on(name, handler, maxPerSecond)
	local limit = maxPerSecond or 8
	local buckets = {}
	local remote = Net.get(name)
	remote.OnServerEvent:Connect(function(player, ...)
		local now = os.clock()
		local bucket = buckets[player]
		if not bucket or now - bucket.start >= 1 then
			bucket = { start = now, count = 0 }
			buckets[player] = bucket
		end
		bucket.count = bucket.count + 1
		if bucket.count > limit then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s handler error for %s: %s"):format(name, player.Name, tostring(err)))
		end
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

function Net.fire(name, player, ...)
	Net.get(name):FireClient(player, ...)
end

function Net.fireAll(name, ...)
	Net.get(name):FireAllClients(...)
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[--[[
	Util - small shared helpers.
]]

local Util = {}

function Util.deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[Util.deepCopy(k)] = Util.deepCopy(v)
	end
	return copy
end

-- Fill missing keys in 'target' from 'template' (used for profile migration).
function Util.reconcile(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = Util.deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" then
			Util.reconcile(target[k], v)
		end
	end
	return target
end

function Util.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	return string.format("%d:%02d", m, s)
end

function Util.countKeys(t)
	local n = 0
	if t then
		for _ in pairs(t) do
			n = n + 1
		end
	end
	return n
end

-- UTC day number, used for daily rewards.
function Util.dayNumber(unixTime)
	return math.floor((unixTime or os.time()) / 86400)
end

function Util.flatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

return Util
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">ZombieTypes</string><ProtectedString name="Source"><![CDATA[--[[
	ZombieTypes
	Fictional infected variants. No gore: the infected are pale, glowing-eyed
	and ragged, built from coloured body parts.
	scale       - body proportion multiplier
	sight/hear  - detection radii (studs). Sprinting players are heard from 'hear'.
	attack      - damage per hit, 'reach' studs, 'cooldown' seconds
]]

local ZombieTypes = {
	Normal = {
