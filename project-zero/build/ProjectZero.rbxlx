<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool><float name="Gravity">196.2</float></Properties></Item><Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><float name="ClockTime">18.9</float><float name="Brightness">1.4</float><Color3 name="Ambient"><R>0.14901960784313725</R><G>0.16470588235294117</G><B>0.18823529411764706</B></Color3><Color3 name="OutdoorAmbient"><R>0.27450980392156865</R><G>0.2901960784313726</G><B>0.33725490196078434</B></Color3><bool name="GlobalShadows">true</bool></Properties></Item><Item class="Players" referent="RBX00000003"><Properties><string name="Name">Players</string><bool name="CharacterAutoLoads">false</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000011"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000010"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Achievements</string><ProtectedString name="Source"><![CDATA[--[[
	Achievements. Rewards are cosmetic only.
]]

local Achievements = {
	wake_up = { name = "Wake-Up Call", description = "Wake up in Ward 3B.", order = 1 },
	first_takedown = { name = "First Takedown", description = "Stop your first infected.", order = 2 },
	code_breaker = { name = "Code Breaker", description = "Open the security office.", order = 3 },
	secret_keeper = { name = "Secret Keeper", description = "Find the hidden records room.", order = 4 },
	first_contact = { name = "First Contact", description = "Meet another survivor.", order = 5 },
	electrician = { name = "Electrician", description = "Solve the breaker puzzle.", order = 6 },
	warden_down = { name = "Lights Out, Warden", description = "Defeat the Warden.", order = 7 },
	chapter1 = { name = "The Outbreak", description = "Complete Chapter 1.", reward = "title_survivor", order = 8 },
	archivist1 = { name = "Archivist", description = "Collect every Chapter 1 research file.", reward = "light_archivist", order = 9 },
	untouchable1 = { name = "Untouchable", description = "Finish Chapter 1 without going down.", reward = "title_untouchable", order = 10 },
	heavy_hitter = { name = "Heavy Hitter", description = "Find the Fire Axe.", order = 11 },
	exterminator = { name = "Exterminator", description = "Stop 100 infected in total.", reward = "gear_survivor", order = 12 },
	speedrunner1 = { name = "Against the Clock", description = "Finish Chapter 1 in under 15 minutes.", order = 13 },
	team_player = { name = "No One Left Behind", description = "Revive a teammate.", order = 14 },
}

return Achievements
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Chapters</string><ProtectedString name="Source"><![CDATA[--[[
	Chapters
	Chapter list for the CHAPTERS menu plus Chapter 1's mission stages.
	Only playable chapters set 'playable = true'. Chapters 2-5 are designed
	(see docs/STORY.md) but not built yet, and the menu says so honestly.
]]

local Layout = require(script.Parent:WaitForChild("Layout"))
local P = Layout.Points

local Chapters = {}

Chapters.List = {
	{ number = 1, id = "ch1", title = "The Outbreak", subtitle = "Escape St. Aurelia and the dead city.", playable = true },
	{ number = 2, id = "ch2", title = "The Survivors", subtitle = "Military Shelter EAGLE-3.", playable = false },
	{ number = 3, id = "ch3", title = "The Secret Lab", subtitle = "Helix Dynamics, Sublevel 4.", playable = false },
	{ number = 4, id = "ch4", title = "The Past", subtitle = "Ashford Bay, 2035.", playable = false },
	{ number = 5, id = "ch5", title = "Project Zero", subtitle = "The last day of the experiment.", playable = false },
}

-- Chapter 1 stages, in order. 'checkpoint' indexes Layout.Checkpoints.
-- 'grants' lists equipment every player must own from this stage on, so
-- late joiners and respawning players are never soft-locked.
Chapters.Chapter1 = {
	{ key = "find_light", text = "Search the nurse station for a light source", target = P.Flashlight, checkpoint = 1, grants = {}, hint = "move" },
	{ key = "find_weapon", text = "Find something to defend yourself in the storage room", target = P.Pipe, checkpoint = 1, grants = { "flashlight" }, hint = "flashlight" },
	{ key = "find_code", text = "The security office is locked. Search the Emergency Room for the code", target = P.ShiftNote, checkpoint = 2, grants = { "flashlight", "pipe" }, hint = "attack" },
	{ key = "security", text = "Enter the code at the Security Office and take the keycard", target = P.SecurityKeypad, checkpoint = 2, grants = { "flashlight", "pipe" } },
	{ key = "lobby", text = "Use the keycard on the lobby doors", target = P.LobbyReader, checkpoint = 2, grants = { "flashlight", "pipe" } },
	{ key = "survivor", text = "Follow the flare to the pharmacy", target = P.MayaSpot, checkpoint = 3, grants = { "flashlight", "pipe" }, hint = "sprint" },
	{ key = "fuse", text = "Get a fuse from the Precinct 9 armory", target = P.Fuse, checkpoint = 4, grants = { "flashlight", "pipe" } },
	{ key = "generator", text = "Install the fuse in the subway generator", target = P.Generator, checkpoint = 5, grants = { "flashlight", "pipe" } },
	{ key = "boss", text = "Defeat the Warden!", target = nil, checkpoint = 5, grants = { "flashlight", "pipe" } },
	{ key = "escape", text = "Enter the subway with Maya", target = P.EscapeZone, checkpoint = 5, grants = { "flashlight", "pipe" } },
}

Chapters.Chapter1Index = {}
for i, stage in ipairs(Chapters.Chapter1) do
	Chapters.Chapter1Index[stage.key] = i
end

-- Contextual tutorial hints (shown once per player, adapted to device on the client).
Chapters.Hints = {
	move = { pc = "WASD to move. Hold SHIFT to sprint. Press E near glowing objects to interact.", touch = "Use the left stick to move. Tap the prompts that appear near objects to interact." },
	flashlight = { pc = "Press F to toggle your flashlight. Light attracts the infected.", touch = "Tap the LIGHT button to toggle your flashlight. Light attracts the infected." },
	attack = { pc = "Equip the pipe with 1, then click to swing.", touch = "Tap the pipe in your hotbar, then tap the screen to swing." },
	sprint = { pc = "Sprinting is loud - the infected hear running footsteps. Press M for the map.", touch = "Tap RUN to sprint - but the infected hear running footsteps. Tap MAP to see where to go." },
	inventory = { pc = "Press TAB to open your inventory and read documents.", touch = "Tap the BAG button to open your inventory and read documents." },
}

return Chapters
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Cinematics</string><ProtectedString name="Source"><![CDATA[--[[
	Cinematics
	Data-driven camera sequences played by the client CinematicController.
	Each shot:
	  duration        seconds
	  from / to       { pos = Vector3, look = Vector3 }  (camera glides from -> to)
	  fov             field of view (default 70)
	  black = true    black screen (used for title cards)
	  title           large centred text (title cards)
	  speaker / line  subtitle
	  shake           camera shake intensity (0 - 1)
	  flicker         flicker the screen like failing lights
	  fadeIn          fade from black at shot start
	All cinematics are skippable and kept short so they never drag gameplay.
]]

local Layout = require(script.Parent:WaitForChild("Layout"))
local P = Layout.Points

local V = Vector3.new

local Cinematics = {}

Cinematics.intro = {
	skippable = true,
	shots = {
		{ duration = 3.2, black = true, title = "2037" },
		{ duration = 4.2, black = true, title = "Fourteen months after the Helix Cell Renewal Trial,\nthe city of Ashford Bay went silent." },
		{
			duration = 6,
			fadeIn = true,
			from = { pos = V(230, 70, 30), look = V(100, 5, 170) },
			to = { pos = V(190, 55, 70), look = V(90, 5, 190) },
			fov = 60,
			speaker = "Radio",
			line = "...this is the Ashford Bay Emergency Authority. Evacuation trains have been suspended. Stay indoors...",
		},
		{
			duration = 5,
			from = { pos = V(110, 9, 30), look = V(10, 6, 30) },
			to = { pos = V(70, 8, 30), look = V(0, 6, 30) },
			fov = 65,
			flicker = true,
			speaker = "Radio",
			line = "...repeat: do not approach the infected. They are attracted to noise and light...",
		},
		{
			duration = 5.5,
			from = { pos = V(16, 12, 20), look = P.WardBed },
			to = { pos = V(10, 7, 14), look = P.WardBed },
			fov = 55,
			speaker = "Recording",
			line = "Subject Zero-Zero... vitals stable. Do not wake the subject. Repeat - do NOT wake the-",
		},
		{ duration = 1.6, black = true, shake = 0.6, speaker = "", line = "" },
		{
			duration = 3.4,
			fadeIn = true,
			from = { pos = V(6, 4, 13), look = V(14, 5, 20) },
			to = { pos = V(7, 5, 13), look = V(15, 5, 24) },
			fov = 70,
			shake = 0.15,
			speaker = "You",
			line = "...Where... am I?",
		},
	},
}

Cinematics.lobby_open = {
	skippable = true,
	shots = {
		{
			duration = 4.5,
			from = { pos = V(65, 8, 74), look = V(65, 6, 100) },
			to = { pos = V(65, 10, 90), look = V(90, 8, 150) },
			fov = 60,
			speaker = "You",
			line = "The whole city... it's gone quiet.",
		},
		{
			duration = 4,
			from = { pos = V(110, 30, 120), look = P.PharmacyFlare },
			to = { pos = V(122, 28, 128), look = P.PharmacyFlare },
			fov = 45,
			speaker = "You",
			line = "A flare. Someone's alive out there.",
		},
	},
}

Cinematics.meet_maya = {
	skippable = true,
	shots = {
		{
			duration = 3.2,
			from = { pos = V(136, 7, 146), look = V(147, 4, 152) },
			to = { pos = V(139, 6, 149), look = V(147, 4.5, 152) },
			fov = 50,
			shake = 0.1,
			speaker = "???",
			line = "Don't move. One more step and I swing.",
		},
	},
}

Cinematics.boss_reveal = {
	skippable = true,
	shots = {
		{
			duration = 2.8,
			from = { pos = V(128, 7, 270), look = V(128, 3, 282) },
			to = { pos = V(122, 8, 266), look = V(128, 4, 282) },
			fov = 60,
			speaker = "Generator",
			line = "*clunk* ...*whirrrr*",
		},
		{
			duration = 4.4,
			from = { pos = V(100, 6, 250), look = V(100, 8, 270) },
			to = { pos = V(100, 4, 254), look = V(100, 11, 266) },
			fov = 50,
			shake = 0.5,
			speaker = "Maya (radio)",
			line = "The noise - it's coming! That's the Warden! He used to run hospital security... stay away from his slam!",
		},
	},
}

Cinematics.escape = {
	skippable = true,
	shots = {
		{
			duration = 4.5,
			from = { pos = V(100, 8, 280), look = V(100, 2, 305) },
			to = { pos = V(100, 5, 292), look = V(100, -4, 320) },
			fov = 60,
			speaker = "Maya",
			line = "Into the tunnels. EAGLE-3 is three stations north - if it's still standing.",
		},
		{
			duration = 5,
			black = true,
			title = "Inside your pocket, something you don't remember taking:\na photo of you - standing beside Dr. Elias Voss.",
		},
		{ duration = 3.5, black = true, title = "CHAPTER 1 COMPLETE\nTHE OUTBREAK" },
	},
}

return Cinematics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	Config
	Global tunables for PROJECT: ZERO. Everything a designer may want to
	tweak lives here so gameplay code never hard-codes numbers.
]]

local Config = {}

Config.GameName = "PROJECT: ZERO"
Config.Version = "0.1.0 (Chapter 1)"
Config.MaxPartySize = 4

-- Persistence --------------------------------------------------------------
Config.Data = {
	ProfileStore = "ProjectZero_Profiles_v1",
	PurchaseStore = "ProjectZero_Purchases_v1",
	AutosaveInterval = 120,
	SessionLockTimeout = 600, -- seconds before a stale session lock is ignored
	MaxRetries = 4,
}

-- Player -------------------------------------------------------------------
Config.Player = {
	MaxHealth = 100,
	WalkSpeed = 12,
	SprintSpeed = 21,
	DownedSpeed = 3,
	MaxStamina = 100,
	SprintDrain = 20, -- per second
	StaminaRegen = 16, -- per second
	RegenDelay = 1.1,
	MinStaminaToSprint = 12,
	DownedDuration = 30, -- seconds a downed player waits for a revive
	ReviveHoldTime = 3,
	PassiveRegenCap = 35, -- health slowly regenerates up to this value
	PassiveRegenRate = 1.5, -- per second, after 6 seconds without damage
}

-- Weapons (server authoritative) ---------------------------------------------
Config.Weapons = {
	pipe = { name = "Steel Pipe", damage = 34, cooldown = 0.65, reach = 6, width = 5, knockback = 22, color = Color3.fromRGB(120, 125, 130) },
	axe = { name = "Fire Axe", damage = 58, cooldown = 0.85, reach = 6.5, width = 6, knockback = 30, color = Color3.fromRGB(170, 30, 30) },
}

-- Sounds. Built-in rbxasset sounds ship with every Roblox client, so these
-- always load. Replace any entry with an rbxassetid:// from the Creator Store
-- (Toolbox > Audio) for higher quality audio; empty strings are skipped safely.
Config.Sounds = {
	Swing = "rbxasset://sounds/swordslash.wav",
	Hit = "rbxasset://sounds/swordlunge.wav",
	ZombieGroan = "rbxasset://sounds/uuhhh.mp3",
	Pickup = "rbxasset://sounds/electronicpingshort.wav",
	UiClick = "rbxasset://sounds/electronicpingshort.wav",
	Door = "rbxasset://sounds/action_jump.mp3",
	Footstep = "rbxasset://sounds/action_footsteps_plastic.mp3",
	-- Optional: paste Creator Store audio IDs below (e.g. "rbxassetid://123").
	AmbientHospital = "",
	AmbientCity = "",
	MusicMenu = "",
	MusicTension = "",
	MusicBoss = "",
}

-- Animations. These IDs belong to Roblox's own animation packages and load in
-- every experience.
Config.Animations = {
	ZombieIdle = "rbxassetid://616158929",
	ZombieWalk = "rbxassetid://616168032",
	ZombieRun = "rbxassetid://616163682",
	Emotes = {
		wave = "rbxassetid://507770239",
		point = "rbxassetid://507770453",
		cheer = "rbxassetid://507770677",
		dance = "rbxassetid://507771019",
	},
}

-- Monetization ---------------------------------------------------------------
-- IDs are created on create.roblox.com (see docs/PUBLISHING.md). An ID of 0
-- means "not configured yet": the shop hides that item and nothing can be sold.
Config.Monetization = {
	VipGamePassId = 0,
	-- Developer products grant cosmetics only. Never story or power.
	Products = {
		{ key = "bundle_hazmat", productId = 0, cosmetics = { "gear_hazmat", "light_toxic" }, name = "Hazmat Bundle", price = 99 },
		{ key = "bundle_nightops", productId = 0, cosmetics = { "gear_tactical", "light_ice", "title_ghost" }, name = "Night Ops Bundle", price = 149 },
		{ key = "emote_pack", productId = 0, cosmetics = { "emote_dance", "emote_cheer" }, name = "Survivor Emotes", price = 49 },
	},
}

-- Zombies --------------------------------------------------------------------
Config.Zombies = {
	TickRate = 0.15, -- AI update interval (seconds)
	PathRecomputeInterval = 1.2,
	MaxActiveBase = 8,
	MaxActivePerPlayer = 3,
	DespawnDistance = 260,
	AmbientRespawnDelay = 6,
	MutatedChance = 0.06,
	FastChance = 0.3,
}

-- Daily rewards rotate through these cosmetics (see Cosmetics.lua).
Config.DailyRewards = { "light_warm", "title_scavenger", "gear_scout", "light_amber", "title_nightwalker", "gear_medic", "light_violet" }

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[--[[
	Cosmetics (purely visual - never gameplay power)
	category:
	  light  - flashlight beam colour
	  gear   - survival gear attached to the character (backpack styles)
	  title  - name tag shown above the head
	  emote  - cosmetic animation
	source: default | daily | achievement | vip | product
]]

local Cosmetics = {
	-- Flashlight beams
	light_default = { category = "light", name = "Standard Beam", source = "default", color = Color3.fromRGB(255, 244, 214) },
	light_warm = { category = "light", name = "Warm Beam", source = "daily", color = Color3.fromRGB(255, 205, 150) },
	light_amber = { category = "light", name = "Amber Beam", source = "daily", color = Color3.fromRGB(255, 170, 60) },
	light_violet = { category = "light", name = "Violet Beam", source = "daily", color = Color3.fromRGB(190, 150, 255) },
	light_gold = { category = "light", name = "VIP Gold Beam", source = "vip", color = Color3.fromRGB(255, 215, 90) },
	light_toxic = { category = "light", name = "Toxic Beam", source = "product", color = Color3.fromRGB(150, 255, 120) },
	light_ice = { category = "light", name = "Ice Beam", source = "product", color = Color3.fromRGB(140, 220, 255) },
	light_archivist = { category = "light", name = "Archivist Beam", source = "achievement", color = Color3.fromRGB(120, 255, 230) },

	-- Gear (backpack styles)
	gear_none = { category = "gear", name = "No Gear", source = "default", style = "none" },
	gear_scout = { category = "gear", name = "Scout Pack", source = "daily", style = "pack", color = Color3.fromRGB(85, 95, 60), accent = Color3.fromRGB(40, 40, 40) },
	gear_medic = { category = "gear", name = "Medic Pack", source = "daily", style = "pack", color = Color3.fromRGB(230, 230, 230), accent = Color3.fromRGB(200, 30, 30) },
	gear_survivor = { category = "gear", name = "Survivor Pack", source = "achievement", style = "pack", color = Color3.fromRGB(110, 70, 40), accent = Color3.fromRGB(200, 160, 60) },
	gear_vip = { category = "gear", name = "VIP Expedition Pack", source = "vip", style = "pack", color = Color3.fromRGB(25, 25, 30), accent = Color3.fromRGB(255, 205, 70) },
	gear_hazmat = { category = "gear", name = "Hazmat Tank", source = "product", style = "tank", color = Color3.fromRGB(240, 200, 30), accent = Color3.fromRGB(30, 30, 30) },
	gear_tactical = { category = "gear", name = "Tactical Rig", source = "product", style = "pack", color = Color3.fromRGB(35, 40, 50), accent = Color3.fromRGB(120, 200, 255) },

	-- Titles
	title_none = { category = "title", name = "No Title", source = "default", text = "" },
	title_scavenger = { category = "title", name = "Scavenger", source = "daily", text = "SCAVENGER", color = Color3.fromRGB(200, 200, 200) },
	title_nightwalker = { category = "title", name = "Nightwalker", source = "daily", text = "NIGHTWALKER", color = Color3.fromRGB(170, 150, 255) },
	title_survivor = { category = "title", name = "Survivor", source = "achievement", text = "SURVIVOR", color = Color3.fromRGB(120, 255, 140) },
	title_untouchable = { category = "title", name = "Untouchable", source = "achievement", text = "UNTOUCHABLE", color = Color3.fromRGB(120, 220, 255) },
	title_vip = { category = "title", name = "VIP", source = "vip", text = "VIP", color = Color3.fromRGB(255, 215, 90) },
	title_ghost = { category = "title", name = "Ghost", source = "product", text = "GHOST", color = Color3.fromRGB(160, 220, 255) },

	-- Emotes
	emote_wave = { category = "emote", name = "Wave", source = "default", anim = "wave" },
	emote_point = { category = "emote", name = "Point", source = "default", anim = "point" },
	emote_cheer = { category = "emote", name = "Cheer", source = "product", anim = "cheer" },
	emote_dance = { category = "emote", name = "Dance", source = "product", anim = "dance" },
}

Cosmetics.Defaults = {
	light = "light_default",
	gear = "gear_none",
	title = "title_none",
}

Cosmetics.VipItems = { "light_gold", "gear_vip", "title_vip" }

Cosmetics.Categories = { "light", "gear", "title", "emote" }

Cosmetics.CategoryNames = {
	light = "Flashlight",
	gear = "Gear",
	title = "Titles",
	emote = "Emotes",
}

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Dialogues</string><ProtectedString name="Source"><![CDATA[--[[
	Dialogues
	Each dialogue: { start = nodeId, nodes = { [id] = node } }
	node fields:
	  speaker, text
	  choices = { { text, next, trust = number?, flag = string? } }  (player picks)
	  next    = nodeId  (single "Continue" button)
	  event   = string  (server mission hook fired when the node is reached)
	  A node with neither choices nor next ends the conversation.
	Choices change persistent story flags that later chapters and the
	endings read (e.g. mayaTrust, toldMayaAboutWristband).
]]

local Dialogues = {}

Dialogues.maya_intro = {
	start = "a1",
	nodes = {
		a1 = {
			speaker = "Maya",
			text = "Stop. Right there. Show me your arms - slowly. Are you bitten?",
			choices = {
				{ text = "I'm not bitten. I just woke up in St. Aurelia.", next = "a2", trust = 1 },
				{ text = "Lower the bat. If I were one of them, you'd know.", next = "a2b" },
				{ text = "(Show her the hospital wristband.)", next = "a3", trust = 2, flag = "showedWristband" },
			},
		},
		a2 = {
			speaker = "Maya",
			text = "Woke up? Nobody has 'woken up' in that hospital for two weeks. The whole east side went dark on day three.",
			next = "a4",
		},
		a2b = {
			speaker = "Maya",
			text = "...Fair. They don't talk back. Sorry. You learn to swing first out here.",
			next = "a4",
		},
		a3 = {
			speaker = "Maya",
			text = "SUBJECT 00... That's a Helix tag. I've seen those - on the people they took off the street before everything went wrong.",
			next = "a4",
		},
		a4 = {
			speaker = "Maya",
			text = "I'm Maya. Paramedic, before. I've been trying to reach Shelter EAGLE-3 through the Line 4 subway, but the gate is dead.",
			choices = {
				{ text = "What happened to this city?", next = "b1" },
				{ text = "What does 'Helix' have to do with any of this?", next = "b2", trust = 1 },
				{ text = "How do we get the gate open?", next = "c1" },
			},
		},
		b1 = {
			speaker = "Maya",
			text = "A fever. Then rage. Then... that. The news called it a virus. But it started in one district - right around Helix Dynamics.",
			next = "c0",
		},
		b2 = {
			speaker = "Maya",
			text = "Helix ran a 'miracle' cell trial. Two weeks later, half their volunteers were in my ambulance. None of them were sick the way the news said.",
			next = "c0",
		},
		c0 = {
			speaker = "Maya",
			text = "Look - talk later. Right now we need power for the subway gate.",
			next = "c1",
		},
		c1 = {
			speaker = "Maya",
			text = "The generator by the subway needs a fuse. Precinct 9, up the street - the armory keeps spares. The armory door runs on an old breaker panel.",
			choices = {
				{ text = "I'll get the fuse. Stay hidden.", next = "d1", trust = 1 },
				{ text = "Why don't you get it yourself?", next = "d2", trust = -1 },
			},
		},
		d1 = {
			speaker = "Maya",
			text = "Thank you. I'll meet you at the subway. And... watch for the big ones. They don't go down easy.",
			event = "maya_done",
		},
		d2 = {
			speaker = "Maya",
			text = "Because something huge has been circling that station all week, and I have one bat and one knee that works. Your turn, hero.",
			event = "maya_done",
		},
	},
}

Dialogues.maya_repeat = {
	start = "r1",
	nodes = {
		r1 = {
			speaker = "Maya",
			text = "Precinct 9 is up Kessler Street. Get the fuse from the armory and meet me at the subway generator.",
		},
	},
}

Dialogues.maya_gate = {
	start = "g1",
	nodes = {
		g1 = {
			speaker = "Maya",
			text = "You actually did it. The gate's open. EAGLE-3 is north through the tunnels - stay close.",
		},
	},
}

return Dialogues
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Documents</string><ProtectedString name="Source"><![CDATA[--[[
	Documents
	Story documents advance or explain the plot. Research files are hidden
	collectibles that reward exploration and reveal the deeper mystery.
	Text uses "{CODE}" which the server replaces with the session's random
	security code, so the keypad puzzle changes every playthrough.
]]

local Documents = {
	patient_log = {
		chapter = 1,
		kind = "story",
		title = "Ward 3B - Patient Log",
		text = "PATIENT: UNKNOWN (wristband: SUBJECT 00)\n"
			.. "TRANSFERRED FROM: Helix Dynamics, Sublevel 4\n\n"
			.. "Day 1 - Patient arrived sedated. Helix staff insisted on no identification.\n"
			.. "Day 9 - Vitals impossible. Cell renewal rate 400% above baseline.\n"
			.. "Day 12 - Helix courier collected blood samples. Again.\n"
			.. "Day 14 - The city is in lockdown. Staff evacuating. Orders say: DO NOT WAKE THE SUBJECT.\n\n"
			.. "Why would they leave the one patient they cared about?",
	},
	shift_note = {
		chapter = 1,
		kind = "story",
		title = "Crumpled Shift Note",
		text = "Dana -\n\nSecurity changed the office code again because of the Helix people.\n"
			.. "New code is {CODE}. Memorise it and BURN this note.\n\n"
			.. "If the ER gets worse, take the keycard from the security office and get out through the lobby.\n\n- R.",
	},
	cctv_log = {
		chapter = 1,
		kind = "story",
		title = "CCTV Log - Camera 07, 03:14",
		text = "03:14 - Four figures in white hazmat suits enter Ward 3B. Suits bear the Helix Dynamics double-spiral logo.\n"
			.. "03:16 - One figure places a small black cube on the patient's chest. The camera feed distorts.\n"
			.. "03:17 - Feed restored. The cube is gone. The patient's heart monitor shows two overlapping heartbeats.\n"
			.. "03:20 - Figures leave. One says: 'Zero is stable. Tell Voss it worked.'\n\n"
			.. "[END OF RECORDING]",
	},
	evac_order = {
		chapter = 1,
		kind = "story",
		title = "Evacuation Order 7",
		text = "ASHFORD BAY EMERGENCY AUTHORITY\n\n"
			.. "All civilians are to report to Line 4 subway evacuation trains.\n"
			.. "Military Shelter EAGLE-3 will accept survivors until further notice.\n\n"
			.. "Handwritten at the bottom: 'The trains never came. The shelter is still out there. Follow the tunnels north.'",
	},
	maintenance_memo = {
		chapter = 1,
		kind = "story",
		title = "Maintenance Memo",
		text = "To all officers:\n\nThe armory door runs on the old breaker panel.\n"
			.. "If the power trips, reset ONLY breakers 1 and 3. Breaker 2 feeds the cells and will lock everything down.\n\n"
			.. "- Facilities",
	},

	-- Hidden research files (collectibles) --------------------------------
	rf_01 = {
		chapter = 1,
		kind = "research",
		title = "Research File 01 - Cell Renewal Trial",
		text = "HELIX DYNAMICS - INTERNAL\n\nProject lead: Dr. Elias Voss\n\n"
			.. "Goal: a compound that repairs any damaged human cell. Phase 1 results are miraculous: wounds closing in minutes.\n\n"
			.. "Side effect noted in 3% of volunteers: aggression, loss of speech, fever. Board decision: continue.",
	},
	rf_02 = {
		chapter = 1,
		kind = "research",
		title = "Research File 02 - Voss's Journal",
		text = "The compound alone is not enough. It needs a template - cells from a body that never ages.\n\n"
			.. "The Cube gives us that. It does not belong to this year. I do not fully understand where it came from.\n\n"
			.. "Note to self: stop telling the board where the Cube came from. They laughed.",
	},
	rf_03 = {
		chapter = 1,
		kind = "research",
		title = "Research File 03 - Transfer Order",
		text = "TRANSFER ORDER - SUBJECT 00\nFrom: Sublevel 4\nTo: St. Aurelia, Ward 3B (secure)\n\n"
			.. "Reason: Subject must be kept away from the Cube until the timeline stabilises.\n"
			.. "Authorised: E. Voss\n\nWhy does a transfer order mention a 'timeline'?",
	},
	rf_04 = {
		chapter = 1,
		kind = "research",
		title = "Research File 04 - Newspaper Clipping, 2035",
		text = "ASHFORD BAY HERALD, MAY 2035\n\nLOCAL SCIENTIST PROMISES 'END OF DISEASE'\n\n"
			.. "Dr. Elias Voss of Helix Dynamics unveiled Project ZERO yesterday. 'In two years,' Voss said, "
			.. "'nobody in this city will ever be sick again.'\n\nThe clipping is circled in red. Someone wrote: 'TWO YEARS. EXACTLY.'",
	},
	rf_05 = {
		chapter = 1,
		kind = "research",
		title = "Research File 05 - Unsent Message",
		text = "If you're reading this, you made it out of the hospital. Good.\n\n"
			.. "You won't remember me, but I remember you. You've done this before.\n\n"
			.. "Find the Cube. Go back. And this time, do NOT trust the man in the white coat.\n\n- Z",
	},
}

-- Ordered lists for UI
Documents.Order = { "patient_log", "shift_note", "cctv_log", "evac_order", "maintenance_memo", "rf_01", "rf_02", "rf_03", "rf_04", "rf_05" }
Documents.ResearchChapter1 = { "rf_01", "rf_02", "rf_03", "rf_04", "rf_05" }

return Documents
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--[[
	Items
	kind:
	  "consumable" - stackable, used from the inventory (server validated)
	  "equipment"  - given as gear (flashlight / weapons)
	  "key"        - shared party story items (keycards, fuses)
]]

