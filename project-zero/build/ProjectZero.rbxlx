}

-- Respawn checkpoints, in story order.
Layout.Checkpoints = {
	{ id = 1, name = "Ward 3B", position = Vector3.new(14, 3, 12) },
	{ id = 2, name = "East Corridor", position = Vector3.new(20, 3, 30) },
