	EvacOrder = Vector3.new(58, 3.6, 146),
	ArmoryDoor = Vector3.new(45, 0, 165),
	Fuse = Vector3.new(45, 3.6, 180),
	Bandage2 = Vector3.new(30, 3.6, 180),
