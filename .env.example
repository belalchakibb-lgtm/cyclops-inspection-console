# --- AI providers (one or both). Every key set is used: if one model fails, the next answers. ---
NVIDIA_API_KEY=replace-with-your-private-NVIDIA-key
# NVIDIA_MODELS=nvidia/nemotron-3.5-super-vl-120b-a12b,minimaxai/minimax-m3.1-flash,nvidia/nemotron-3.5-lightning-30b-a3b   # tried in this order (default)
# ANTHROPIC_API_KEY=replace-with-your-Anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_PROVIDER=nvidia             # which provider is tried first when both keys are set (default: anthropic)

AI_MAX_TOKENS=1200               # answer length limit (200-4000)
AI_TIMEOUT_MS=60000              # whole question, all fallbacks included
# AI_ATTEMPT_TIMEOUT_MS=25000    # one model, before moving to the next
AI_SCOPE=inspection              # inspection = politely declines unrelated questions; open = answers anything
AI_RATE_PER_MINUTE=20            # questions per user per minute

# --- Accounts: name:password:role, comma-separated. Roles: inspector, supervisor, admin ---
CYCLOPS_USERS=chakib:choose-a-long-password-1:admin,inspecteur1:choose-a-long-password-2:inspector
# Older single-account form still works:
# CYCLOPS_USERNAME=choose-a-login-name
# CYCLOPS_PASSWORD=choose-a-unique-password-of-at-least-12-characters
SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters

# --- Network ---
# HOST=127.0.0.1                 # keep CYCLOPS on this computer only (default 0.0.0.0 = reachable on the LAN)
# TRUST_PROXY=1                  # set when running behind a proxy (Render sets this automatically)
# AUDIT_LOG=off                  # disable data/audit.jsonl
